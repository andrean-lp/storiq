---
// WhatsApp Floating Button Component
// Muncul otomatis ketika audience sudah scroll >= 50% dari total tinggi halaman
---

<div
  id="whatsapp-float-btn"
  class="fixed bottom-6 right-6 z-50 opacity-0 translate-y-6 pointer-events-none transition-all duration-300 ease-out flex items-center group"
>
  <!-- Tooltip / Label Hover -->
  <span
    class="hidden sm:inline-block mr-3 px-3.5 py-1.5 rounded-full bg-slate-900/90 backdrop-blur-xs text-white text-xs font-semibold shadow-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none whitespace-nowrap"
  >
    Konsultasi WhatsApp
  </span>

  <!-- WhatsApp Circular Button -->
  <a
    href="https://wa.me/6285187437036"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Hubungi kami via WhatsApp"
    class="relative w-14 h-14 rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white flex items-center justify-center shadow-lg shadow-[#25D366]/30 hover:shadow-xl hover:shadow-[#25D366]/40 hover:scale-105 active:scale-95 transition-all duration-200"
  >
    <!-- Subtle Pulse Ring Effect -->
    <span class="absolute -inset-1 rounded-full bg-[#25D366] opacity-30 animate-ping pointer-events-none"></span>

    <!-- Official WhatsApp SVG Vector -->
    <svg
      class="w-7 h-7 fill-current relative z-10"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M12.004 0C5.375 0 .003 5.371.003 12c0 2.115.55 4.183 1.597 6.002L.062 23.461a.75.75 0 0 0 .918.918l5.589-1.52A11.96 11.96 0 0 0 12.004 24c6.627 0 12-5.373 12-12s-5.373-12-12-12zm0 21.94c-1.895 0-3.73-.518-5.31-1.498a.75.75 0 0 0-.583-.074l-4.148 1.127 1.135-4.086a.75.75 0 0 0-.077-.591A9.88 9.88 0 0 1 2.062 12c0-5.483 4.46-9.94 9.942-9.94 5.483 0 9.94 4.457 9.94 9.94 0 5.483-4.457 9.94-9.94 9.94zm5.42-7.393c-.297-.149-1.758-.867-2.03-.966-.273-.1-.471-.149-.67.149-.198.297-.768.966-.941 1.164-.174.198-.347.223-.644.075-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.174-.297-.019-.458.13-.606.134-.133.298-.347.446-.521.149-.174.198-.297.298-.496.099-.198.05-.372-.025-.521-.074-.149-.669-1.611-.917-2.207-.242-.58-.487-.501-.67-.51-.173-.008-.371-.01-.57-.01s-.52.075-.792.372c-.273.298-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.307 1.263.49 1.694.627.712.227 1.36.195 1.872.118.571-.085 1.758-.718 2.006-1.412.248-.694.248-1.289.174-1.412-.075-.124-.273-.198-.57-.347z"
      />
    </svg>
  </a>
</div>

<script>
  function setupWhatsAppScroll() {
    const btn = document.getElementById('whatsapp-float-btn');
    if (!btn) return;

    function updateVisibility() {
      const scrollTotal = document.documentElement.scrollHeight - window.innerHeight;
      if (scrollTotal > 50) {
        const scrollProgress = window.scrollY / scrollTotal;
        if (scrollProgress >= 0.5) {
          btn.classList.remove('opacity-0', 'translate-y-6', 'pointer-events-none');
          btn.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
          return;
        }
      }
      btn.classList.add('opacity-0', 'translate-y-6', 'pointer-events-none');
      btn.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
    }

    window.addEventListener('scroll', updateVisibility, { passive: true });
    window.addEventListener('resize', updateVisibility, { passive: true });
    updateVisibility();
  }

  // Jalankan saat load dan setelah view transition
  setupWhatsAppScroll();
  document.addEventListener('astro:page-load', setupWhatsAppScroll);
</script>
