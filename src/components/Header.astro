---
const baseUrl = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: `${baseUrl}framework/`, label: 'Fitur' },
  { href: `${baseUrl}panduan/`, label: 'Dokumentasi' },
  { href: `${baseUrl}roadmap/`, label: 'Roadmap' },
  { href: `${baseUrl}kontribusi/`, label: 'Kontribusi' },
  { href: `${baseUrl}pengaturan/`, label: 'Pengaturan' },
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200/80 transition-all duration-200">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <!-- Logo -->
    <a href={baseUrl} class="flex items-center gap-2.5 text-slate-900 font-extrabold text-lg tracking-tight group">
      <div class="w-8 h-8 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-black shadow-xs shadow-indigo-500/20 group-hover:bg-indigo-700 transition-colors">
        S
      </div>
      <span class="bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent">STORIQ</span>
    </a>

    <!-- Desktop Nav Links -->
    <ul class="hidden md:flex items-center gap-1 text-sm font-medium">
      {navLinks.map(link => {
        const isActive = currentPath === link.href || (link.href !== baseUrl && currentPath.startsWith(link.href));
        return (
          <li>
            <a
              href={link.href}
              class:list={[
                'px-3.5 py-1.5 rounded-lg transition-colors duration-150',
                isActive
                  ? 'bg-indigo-50 text-indigo-700 font-semibold'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70',
              ]}
            >
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Right Actions -->
    <div class="hidden sm:flex items-center gap-2.5">
      <!-- Star on GitHub Button -->
      <a
        href="https://github.com/andrean-lp/storiq"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200/90 hover:border-slate-300 px-3 py-1.5 rounded-lg shadow-2xs transition-all duration-150"
      >
        <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        <span>Star</span>
      </a>

      <!-- Generator Primary CTA -->
      <a
        href={`${baseUrl}generator/`}
        class="inline-flex items-center justify-center gap-1.5 text-xs sm:text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 px-4 py-2 rounded-lg shadow-xs shadow-indigo-600/25 transition-all duration-150"
      >
        <span>Buka Generator</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex items-center gap-2 md:hidden">
      <a
        href={`${baseUrl}generator/`}
        class="inline-flex items-center justify-center text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 px-3 py-1.5 rounded-lg shadow-xs"
      >
        Generator
      </a>
      <button
        id="mobile-menu-btn"
        class="p-1.5 text-slate-600 hover:text-slate-900 rounded-lg hover:bg-slate-100 transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Dropdown Nav -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 py-3 space-y-1 shadow-lg">
    <a
      href={baseUrl}
      class:list={[
        'block px-3 py-2 rounded-lg text-sm font-medium transition-colors',
        currentPath === baseUrl ? 'bg-indigo-50 text-indigo-700 font-semibold' : 'text-slate-700 hover:bg-slate-50'
      ]}
    >
      Home
    </a>
    {navLinks.map(link => {
      const isActive = currentPath === link.href || (link.href !== baseUrl && currentPath.startsWith(link.href));
      return (
        <a
          href={link.href}
          class:list={[
            'block px-3 py-2 rounded-lg text-sm font-medium transition-colors',
            isActive ? 'bg-indigo-50 text-indigo-700 font-semibold' : 'text-slate-700 hover:bg-slate-50'
          ]}
        >
          {link.label}
        </a>
      );
    })}
    <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
      <a
        href="https://github.com/andrean-lp/storiq"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-slate-600 hover:text-slate-900 font-medium inline-flex items-center gap-1 py-1"
      >
        ⭐ Beri Star di GitHub
      </a>
      <a
        href={`${baseUrl}tentang/`}
        class="text-xs text-slate-500 hover:text-slate-800"
      >
        Tentang Pembuat
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
