---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Ubah satu ide menjadi artikel, carousel, caption, quote, video script — semua berbasis framework storytelling yang terstruktur.' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Andre Wahyu Hermawan" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://andrean-lp.github.io/storiq/`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta property="og:image" content="https://andrean-lp.github.io/storiq/logo.webp" />
    <meta name="twitter:image" content="https://andrean-lp.github.io/storiq/logo.webp" />

    <link rel="icon" type="image/webp" href={`${baseUrl}favicon.webp`} />
    <link rel="icon" type="image/png" href={`${baseUrl}favicon.png`} />
    <link rel="apple-touch-icon" href={`${baseUrl}logo-128.webp`} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[#fafbfc] text-slate-900 font-sans antialiased selection:bg-indigo-500 selection:text-white flex flex-col justify-between">
    <slot name="header">
      <Fragment set:html="" />
    </slot>
    <main class="flex-grow">
      <slot />
    </main>
    <slot name="footer">
      <Fragment set:html="" />
    </slot>
  </body>
</html>
