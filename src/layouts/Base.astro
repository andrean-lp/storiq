---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Ubah satu ide menjadi artikel, carousel, caption, quote, video script — semua berbasis framework storytelling yang terstruktur.' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="content repurposing, storytelling framework, copywriting tools, prompt generator, chatgpt prompt, carousel instagram, 3d clay carousel, caption generator, content creator indonesia, storiq, marketing tools, ai copywriting, repurpose content, template prompt ai" />
    <meta name="author" content="STORIQ" />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="STORIQ" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content="https://andrean-lp.github.io/storiq/logo.webp" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://andrean-lp.github.io/storiq/logo.webp" />

    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" type="text/plain" href={`${baseUrl}llms.txt`} title="LLM Context" />
    <link rel="icon" type="image/webp" href={`${baseUrl}favicon.webp`} />
    <link rel="icon" type="image/png" href={`${baseUrl}favicon.png`} />
    <link rel="apple-touch-icon" href={`${baseUrl}logo-128.webp`} />
    <title>{title}</title>

    <!-- Schema.org JSON-LD for Search & AI Engines (GEO) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebApplication",
          "@id": "https://andrean-lp.github.io/storiq/#webapp",
          "name": "STORIQ",
          "alternateName": "STORIQ Content Repurposing Engine",
          "url": "https://andrean-lp.github.io/storiq/",
          "description": "Content Repurposing Engine berbasis storytelling: ubah 1 ide atau artikel jadi Carousel 3D Clay, Caption Medsos, Threads, LinkedIn, dan Video Script gratis tanpa login.",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "All",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "author": {
            "@type": "Person",
            "name": "Andre Wahyu Hermawan",
            "jobTitle": "Landing Page Strategist & CRO",
            "url": "https://andrean-lp.github.io/"
          },
          "featureList": [
            "Content Repurposing dari 1 Ide atau Artikel",
            "Framework Storytelling (STORIQ 10 Elemen, Hero's Journey, StoryBrand)",
            "Prompt Generator Carousel 3D Clay untuk Midjourney / ChatGPT",
            "Multi-Platform Caption Generator (Instagram, LinkedIn, Threads)",
            "Video Script Reels & TikTok Generator",
            "100% Gratis, Tanpa Login, Client-Side Privacy"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://andrean-lp.github.io/storiq/#website",
          "url": "https://andrean-lp.github.io/storiq/",
          "name": "STORIQ",
          "description": "Content Repurposing Engine & Storytelling Framework",
          "inLanguage": "id-ID"
        }
      ]
    })} />
  </head>
  <body class="min-h-screen bg-[#fafbfc] text-slate-900 font-sans antialiased selection:bg-indigo-500 selection:text-white flex flex-col justify-between">
    <slot name="header">
      <Fragment set:html="" />
    </slot>
    <main class="flex-grow">
      <slot />
    </main>
    <slot name="footer">
      <Fragment set:html="" />
    </slot>
  </body>
</html>
