---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const baseUrl = import.meta.env.BASE_URL;

const gitBranches = [
  {
    branch: 'main',
    fungsi: 'Production. Hanya rilis stabil yang di-merge ke branch ini.'
  },
  {
    branch: 'development',
    fungsi: 'Integrasi fitur baru sebelum rilis stabil.'
  },
  {
    branch: 'feature/*',
    fungsi: 'Pengembangan fitur spesifik. Dibuat dari development dan di-PR ke development.'
  },
  {
    branch: 'fix/*',
    fungsi: 'Perbaikan bug spesifik (hotfix). Dibuat dari main atau development.'
  }
];

const prChecklist = [
  'Jalankan npm run build untuk memastikan seluruh halaman ter-compile tanpa error.',
  'Format kode rapi dan konsisten sesuai kaidah Astro & Tailwind CSS.',
  'Tulis judul dan deskripsi PR yang jelas (jelaskan apa masalahnya & solusi yang dibuat).',
  'Sertakan referensi Issue terkait (misal: "Fixes #12").',
  'Sertakan tangkapan layar (screenshot) sebelum/sesudah jika mengubah tampilan antarmuka (UI).'
];
---

<Base
  title="Panduan Kontribusi — STORIQ"
  description="Bantu STORIQ tumbuh. Panduan workflow Git, setup dev lokal, dan checklist Pull Request."
>
  <Header slot="header" />

  <!-- Hero Section -->
  <section class="py-14 sm:py-20 text-center max-w-4xl mx-auto px-4">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs font-semibold mb-5">
      <span>🤝</span>
      <span>Open Source Community</span>
    </div>
    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
      Bantu STORIQ Tumbuh
    </h1>
    <p class="text-slate-600 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
      STORIQ adalah proyek open source karya anak bangsa. Bantuan dalam bentuk laporan bug, perbaikan kode, penambahan framework, maupun sekadar koreksi dokumentasi sangat kami apresiasi!
    </p>

    <!-- Dukungan Star GitHub (Copywriting Halus) -->
    <div class="mt-8 inline-flex flex-col sm:flex-row items-center gap-4 p-4 sm:p-5 rounded-2xl bg-white border border-slate-200/90 max-w-xl mx-auto text-left shadow-xs hover:border-amber-300 transition-colors">
      <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200/70 text-amber-600 flex items-center justify-center text-xl shrink-0 shadow-2xs">
        ⭐
      </div>
      <div class="flex-1 text-center sm:text-left">
        <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
          Punya akun GitHub? Dukungan sederhana berupa <strong>satu bintang (Star)</strong> dari kamu sangat berarti untuk menyemangati kami dan membantu STORIQ menjangkau lebih banyak kreator.
        </p>
      </div>
      <a
        href="https://github.com/andrean-lp/storiq"
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold transition-all shadow-xs hover:shadow-md hover:scale-105 cursor-pointer"
      >
        <span>⭐ Star di GitHub</span>
      </a>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 pb-20 space-y-12">
    <!-- 1. Git Workflow -->
    <section class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-2xs">
      <div class="flex items-center gap-2.5 mb-4">
        <span class="text-lg">🔀</span>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900">Git Workflow</h2>
      </div>
      <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed">
        Kami menggunakan alur kerja cabang standar untuk menjaga stabilitas kode produksi.
      </p>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-slate-400 font-semibold uppercase text-[11px] tracking-wider">
              <th class="pb-3 pr-4">Branch</th>
              <th class="pb-3">Fungsi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {gitBranches.map((item) => (
              <tr>
                <td class="py-3 pr-4 font-mono font-semibold text-indigo-600">{item.branch}</td>
                <td class="py-3 text-slate-600">{item.fungsi}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-6 p-3.5 bg-slate-50 border border-slate-200/70 rounded-xl font-mono text-xs text-slate-600 text-center">
        feature/nama-fitur &rarr; development &rarr; main (tag vX.Y.Z)
      </div>
    </section>

    <!-- 2. Setup Lingkungan Dev -->
    <section class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-2xs">
      <div class="flex items-center gap-2.5 mb-4">
        <span class="text-lg">💻</span>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900">Setup Lingkungan Dev</h2>
      </div>
      <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed">
        Jalankan perintah berikut di terminal Anda untuk menjalankan STORIQ di komputer lokal:
      </p>

      <!-- Terminal Box -->
      <div class="bg-slate-900 rounded-2xl p-5 sm:p-6 text-slate-200 font-mono text-xs sm:text-sm shadow-lg overflow-x-auto">
        <div class="flex items-center gap-2 pb-3 mb-4 border-b border-slate-800 text-slate-500 text-xs">
          <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
          <span class="ml-2">bash / terminal</span>
        </div>
        <pre class="leading-relaxed"><code># 1. Clone repository
git clone https://github.com/andrean-lp/storiq.git
cd storiq

# 2. Install dependensi
npm install

# 3. Jalankan server lokal development
npm run dev

# Aplikasi akan berjalan di http://localhost:4321/storiq/</code></pre>
      </div>
    </section>

    <!-- 3. Testing & Verifikasi -->
    <section class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-2xs">
      <div class="flex items-center gap-2.5 mb-4">
        <span class="text-lg">🧪</span>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900">Testing & Build</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl border border-slate-200/80 bg-slate-50/50">
          <code class="text-xs font-mono font-bold text-indigo-600">npm run build</code>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Menjalankan compile statis Astro untuk memastikan seluruh halaman dan komponen bebas dari syntax/type error.
          </p>
        </div>
        <div class="p-4 rounded-xl border border-slate-200/80 bg-slate-50/50">
          <code class="text-xs font-mono font-bold text-indigo-600">npm run preview</code>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Menjalankan preview server lokal dari folder hasil build /dist untuk menguji performa riil.
          </p>
        </div>
      </div>
    </section>

    <!-- 4. Checklist Pull Request -->
    <section class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-2xs">
      <div class="flex items-center gap-2.5 mb-4">
        <span class="text-lg">📋</span>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900">Checklist Pull Request</h2>
      </div>
      <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed">
        Sebelum mengirimkan Pull Request, mohon pastikan hal-hal berikut sudah terpenuhi:
      </p>

      <ul class="space-y-3 text-xs sm:text-sm text-slate-700">
        {prChecklist.map((item) => (
          <li class="flex items-start gap-3 p-3 rounded-xl bg-slate-50/60 border border-slate-100">
            <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
              ✓
            </span>
            <span class="leading-relaxed">{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Bottom CTA Banner -->
    <div class="bg-gradient-to-r from-indigo-600 to-violet-600 rounded-3xl p-8 sm:p-12 text-center text-white shadow-xl shadow-indigo-600/15">
      <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-3">
        Siap Berkontribusi?
      </h3>
      <p class="text-xs sm:text-sm text-indigo-100 max-w-md mx-auto leading-relaxed mb-8">
        Mulai dari issue berlabel "good first issue" atau ajukan ide perbaikanmu langsung di repositori GitHub STORIQ.
      </p>
      <div class="flex flex-wrap justify-center items-center gap-3">
        <a
          href="https://github.com/andrean-lp/storiq/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 rounded-xl bg-white text-indigo-600 font-bold text-xs sm:text-sm shadow-md hover:bg-indigo-50 transition-colors"
        >
          Cari Good First Issue
        </a>
        <a
          href="https://github.com/andrean-lp/storiq"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 rounded-xl bg-white/15 text-white font-bold text-xs sm:text-sm border border-white/20 hover:bg-white/25 transition-colors"
        >
          Buka GitHub Repositori &rarr;
        </a>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</Base>
