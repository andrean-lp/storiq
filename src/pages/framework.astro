---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const baseUrl = import.meta.env.BASE_URL;

const frameworks = [
  {
    id: 'storiq10',
    name: 'STORIQ 10 Elemen',
    creator: 'STORIQ Original (CRO & Psychology)',
    badge: 'Paling Komprehensif',
    desc: 'Framework terlengkap yang memadukan psikologi narasi dan Conversion Rate Optimization (CRO). Membimbing pembaca dari kondisi tidak sadar masalah (unaware) hingga siap mengambil aksi nyata.',
    bestFor: 'Artikel blog mendalam, landing page produk, dan materi presentasi penawaran.',
    points: [
      'Context: Pahami kondisi dan lingkungan pembaca saat ini.',
      'Character: Posisikan audiens sebagai tokoh utama (protagonis).',
      'Conflict: Munculkan rasa frustrasi atau gap masalah yang belum terselesaikan.',
      'Desire & Discovery: Gambarkan resolusi masa depan dan cara pandang baru.',
      'Mechanism & Proof: Jelaskan cara kerja solusi secara logis dengan data/bukti konkret.',
      'Transformation & Action: Tunjukkan kontras before-after dan ajak bertindak.'
    ],
    previewTitle: 'Contoh Blueprint Narasi STORIQ 10',
    previewExample: {
      hook: 'Banyak orang mengira konsistensi itu soal disiplin besi, padahal masalah sebenarnya ada pada sistem energi.',
      conflict: 'Setiap hari merasa harus posting, tapi kehabisan ide di menit ke-10.',
      mechanism: 'Repurposing Engine memecah 1 ide inti menjadi 10 turunan format tanpa menulis ulang.',
      cta: 'Mulai bangun bank ide Anda sekarang sebelum burnout melanda.'
    }
  },
  {
    id: 'heros_journey',
    name: "The Hero's Journey",
    creator: 'Joseph Campbell / Christopher Vogler',
    badge: 'Format Legendaris',
    desc: 'Kerangka narasi mitologi paling terkenal di dunia yang digunakan film-film box office. Dalam bisnis, pelanggan adalah sang Pahlawan (Hero) dan Brand adalah sang Pemandu (Mentor/Yoda).',
    bestFor: 'Kisah perjalanan founder, studi kasus transformasi klien, dan video dokumenter.',
    points: [
      'Status Quo: Audiens berada di zona nyaman namun ada keresahan terpendam.',
      'Call to Adventure: Panggilan tantangan atau krisis mendadak muncul.',
      'Meeting the Mentor: Brand Anda hadir membawakan panduan dan alat baru.',
      'Crossing the Threshold: Langkah berani pertama untuk mencoba solusi.',
      'The Ordeal & Reward: Melewati ujian berat dan memetik hasil gemilang.'
    ],
    previewTitle: "Blueprint The Hero's Journey",
    previewExample: {
      hook: 'Tiga tahun lalu, bisnis saya hampir gulung tikar karena biaya iklan melonjak 400%.',
      conflict: 'Uang tabungan menipis, tim mulai cemas, dan strategi lama tidak lagi manjur.',
      mechanism: 'Saya beralih ke konten organik berbasis storytelling yang membangun kepercayaan jangka panjang.',
      cta: 'Jika Anda sedang di fase terberat, tonton video ini untuk melihat solusinya.'
    }
  },
  {
    id: 'storybrand',
    name: 'The StoryBrand Framework (SB7)',
    creator: 'Donald Miller',
    badge: 'Standar Pemasaran B2B',
    desc: 'Menyederhanakan perjalanan cerita menjadi 7 elemen kunci pemasaran yang tajam. Fokus utamanya adalah kejelasan pesan agar audiens tidak mengalami kebingungan kognitif.',
    bestFor: 'Copywriting homepage website, bio media sosial, dan pitch deck bisnis.',
    points: [
      'Karakter: Ketahui apa yang diinginkan oleh calon pelanggan.',
      'Memiliki Masalah: Masalah eksternal (fakta), internal (emosi), dan filosofis.',
      'Bertemu Pemandu: Tunjukkan empati dan otoritas tanpa bersikap sombong.',
      'Menerima Rencana: Berikan 3 langkah yang sangat jelas dan mudah.',
      'Panggilan Bertindak & Akhir Sukses: Ajakan bertindak dengan gambaran hasil positif.'
    ],
    previewTitle: 'Blueprint StoryBrand SB7',
    previewExample: {
      hook: 'Kelola seluruh stok dan keuangan tokomu tanpa perlu pusing mencatat manual.',
      conflict: 'Sering tekor di akhir bulan karena stok barang tidak sinkron dengan catatan kasir.',
      mechanism: 'Gunakan 3 langkah: Hubungkan perangkat -> Input produk -> Pantau omzet real-time.',
      cta: 'Coba gratis selama 14 hari tanpa kartu kredit.'
    }
  },
  {
    id: 'pas',
    name: 'Problem - Agitate - Solve (PAS)',
    creator: 'Dan Kennedy',
    badge: 'Formula Copywriting Tercepat',
    desc: 'Formula copywriting klasik paling efektif di dunia untuk memicu rasa urgensi. Membuka masalah, memperdalam rasa sakitnya, lalu memberikan solusi sebagai obat penawarnya.',
    bestFor: 'Postingan LinkedIn, carousel edukasi problem-aware, dan email broadcast promosi.',
    points: [
      'Problem: Sebutkan satu masalah spesifik yang dialami audiens saat ini.',
      'Agitate: Gali konsekuensi buruk jika masalah tersebut dibiarkan berlarut-larut.',
      'Solve: Hadirkan solusi Anda sebagai jawaban paling masuk akal dan praktis.'
    ],
    previewTitle: 'Blueprint Formula PAS',
    previewExample: {
      hook: 'Sudah posting setiap hari tapi followers dan penjualan tetap jalan di tempat?',
      conflict: 'Makin hari engagement makin turun, waktu habis untuk bikin konten yang tidak menghasilkan.',
      mechanism: 'Yang salah bukan algoritmanya, tapi struktur hook dan value yang Anda tawarkan.',
      cta: 'Gunakan template storytelling ini untuk postingan Anda selanjutnya.'
    }
  },
  {
    id: 'aida',
    name: 'Attention - Interest - Desire - Action (AIDA)',
    creator: 'E. St. Elmo Lewis',
    badge: 'Fondasi Periklanan Modern',
    desc: 'Struktur bertahap klasik yang memandu perhatian audiens secara alami: menarik perhatian, membangun ketertarikan, memantik keinginan kuat, hingga mendorong aksi nyata.',
    bestFor: 'Iklan bersponsor (Meta/Google Ads), carousel produk, dan landing page singkat.',
    points: [
      'Attention: Hook visual atau kalimat kontras yang menghentikan scroll.',
      'Interest: Fakta menarik, studi kasus, atau data unik yang menahan rasa penasaran.',
      'Desire: Menunjukkan bagaimana hidup audiens berubah setelah memiliki solusi.',
      'Action: Perintah yang jelas tentang apa yang harus diklik atau dibeli sekarang.'
    ],
    previewTitle: 'Blueprint Formula AIDA',
    previewExample: {
      hook: '90% kreator menyerah di 3 bulan pertama karena alasan yang sama.',
      conflict: 'Bukan karena malas, tapi karena kelelahan membuat konten dari nol setiap platform.',
      mechanism: 'Dengan teknik atomisasi konten, 1 artikel bisa menjadi 10 postingan dalam 15 menit.',
      cta: 'Download panduan gratisnya lewat link di bio.'
    }
  },
  {
    id: 'bab',
    name: 'Before - After - Bridge (BAB)',
    creator: 'Social Media Copywriting Standard',
    badge: 'Format Paling Sederhana & Kuat',
    desc: 'Formula narasi super ringkas yang menunjukkan kontras tajam antara kondisi sengsara saat ini (Before), kondisi ideal impian (After), dan solusi Anda sebagai jembatannya (Bridge).',
    bestFor: 'Cuitan singkat di X/Twitter, postingan Threads, dan caption Instagram ringkas.',
    points: [
      'Before: Tunjukkan situasi frustrasi yang sedang dialami audiens saat ini.',
      'After: Bayangkan situasi jika masalah tersebut sudah lenyap sepenuhnya.',
      'Bridge: Berikan cara, alat, atau metodologi Anda untuk menyeberang ke kondisi After.'
    ],
    previewTitle: 'Blueprint Formula BAB',
    previewExample: {
      hook: 'Dulu: Butuh waktu 4 jam hanya untuk membuat 1 slide carousel.',
      conflict: 'Sekarang: 1 artikel selesai diolah menjadi 4 format berbeda dalam 10 menit.',
      mechanism: 'Jembatannya: Gunakan framework storytelling terstruktur sebelum menulis.',
      cta: 'Coba gratis generatornya hari ini.'
    }
  }
];
---

<Base
  title="Fitur & Framework Storytelling — STORIQ"
  description="Pelajari 6 framework narasi teruji di STORIQ untuk mengubah ide biasa menjadi konten yang menjual dan berdampak."
>
  <Header slot="header" />

  <!-- Hero Section -->
  <section class="py-14 sm:py-20 text-center max-w-4xl mx-auto px-4">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs font-semibold mb-5">
      <span>✨</span>
      <span>Arsitektur Storytelling</span>
    </div>
    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
      Fitur Lengkap untuk Konten Nyata
    </h1>
    <p class="text-slate-600 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
      Kombinasi framework storytelling dunia, formula konversi, dan dekomposisi atom konten untuk merancang perjalanan psikologi pembaca dari penasaran hingga percaya.
    </p>

    <!-- Filter Category Pills (seperti Dikasir) -->
    <div class="flex flex-wrap justify-center items-center gap-2 mt-8 max-w-3xl mx-auto">
      {frameworks.map((f) => (
        <a
          href={`#${f.id}`}
          class="px-3.5 py-1.5 rounded-full bg-white border border-slate-200/90 hover:border-indigo-300 hover:bg-indigo-50/50 text-slate-700 hover:text-indigo-700 text-xs font-semibold shadow-2xs transition-all"
        >
          {f.name}
        </a>
      ))}
    </div>
  </section>

  <!-- Alternating 2-Column Section (Z-Pattern seperti Dikasir) -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-24 space-y-16 sm:space-y-20">
    {frameworks.map((f, idx) => {
      const isEven = idx % 2 === 1;
      return (
        <div id={f.id} class="scroll-mt-24 pt-4">
          <div class:list={[
            'grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 items-center bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-10 shadow-2xs hover:border-indigo-200 transition-all',
          ]}>
            <!-- Left Info Column -->
            <div class:list={[
              'lg:col-span-6 space-y-5',
              isEven ? 'lg:order-2' : 'lg:order-1'
            ]}>
              <div class="flex flex-wrap items-center gap-2.5">
                <span class="px-2.5 py-0.5 rounded-full bg-indigo-50 border border-indigo-200 text-indigo-700 text-xs font-bold">
                  {f.badge}
                </span>
                <span class="text-xs text-slate-400 font-medium">{f.creator}</span>
              </div>

              <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                {f.name}
              </h2>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {f.desc}
              </p>

              <!-- Checklist Points with green ticks -->
              <div class="space-y-2.5 pt-2">
                <div class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-1">
                  Langkah Inti Framework:
                </div>
                {f.points.map((pt) => (
                  <div class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700">
                    <span class="text-emerald-500 font-bold shrink-0 mt-0.5">✓</span>
                    <span class="leading-relaxed">{pt}</span>
                  </div>
                ))}
              </div>

              <div class="pt-3">
                <a
                  href={`${baseUrl}generator/?framework=${f.id}`}
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs sm:text-sm shadow-xs transition-colors"
                >
                  <span>Gunakan Framework Ini</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>

            <!-- Right Mockup / Preview Box Column -->
            <div class:list={[
              'lg:col-span-6',
              isEven ? 'lg:order-1' : 'lg:order-2'
            ]}>
              <div class="bg-slate-50 rounded-2xl border border-slate-200/90 p-5 sm:p-6 shadow-xs">
                <div class="flex items-center justify-between border-b border-slate-200 pb-3 mb-4 text-xs font-semibold text-slate-700">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-rose-400"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
                    <span class="ml-1 font-mono text-[11px] text-slate-500">{f.previewTitle}</span>
                  </div>
                  <span class="text-[10px] uppercase font-bold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded">Simulasi</span>
                </div>

                <div class="space-y-3.5 text-xs leading-relaxed">
                  <div class="bg-white p-3.5 rounded-xl border border-slate-200/70 shadow-2xs">
                    <div class="text-[10px] font-bold text-indigo-600 uppercase tracking-wider mb-1">🎣 Hook & Pembuka</div>
                    <p class="text-slate-800 font-medium">"{f.previewExample.hook}"</p>
                  </div>
                  <div class="bg-white p-3.5 rounded-xl border border-slate-200/70 shadow-2xs">
                    <div class="text-[10px] font-bold text-rose-600 uppercase tracking-wider mb-1">⚡ Konflik Relatable</div>
                    <p class="text-slate-700">"{f.previewExample.conflict}"</p>
                  </div>
                  <div class="bg-white p-3.5 rounded-xl border border-slate-200/70 shadow-2xs">
                    <div class="text-[10px] font-bold text-emerald-600 uppercase tracking-wider mb-1">💡 Solusi & Mekanisme</div>
                    <p class="text-slate-700">"{f.previewExample.mechanism}"</p>
                  </div>
                  <div class="bg-white p-3.5 rounded-xl border border-slate-200/70 shadow-2xs">
                    <div class="text-[10px] font-bold text-blue-600 uppercase tracking-wider mb-1">🎯 Call to Action (CTA)</div>
                    <p class="text-slate-800 font-medium">"{f.previewExample.cta}"</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      );
    })}

    <!-- Bottom Request Banner -->
    <div class="bg-slate-900 rounded-3xl p-8 sm:p-12 text-center text-white relative overflow-hidden shadow-xl">
      <div class="max-w-xl mx-auto space-y-4">
        <h3 class="text-xl sm:text-2xl font-extrabold tracking-tight">
          Ada Formula Cerita yang Kamu Butuhkan?
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          Kami selalu memperluas pustaka storytelling. Silakan ajukan formula favoritmu melalui GitHub Discussions atau Issues.
        </p>
        <div class="pt-2">
          <a
            href="https://github.com/andrean-lp/storiq/issues"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs sm:text-sm transition-colors shadow-sm"
          >
            <span>Request Framework di GitHub</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>
