---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const baseUrl = import.meta.env.BASE_URL;

const tenElements = [
  {
    number: "01",
    name: "Context",
    role: "Fase Fondasi",
    tagline: "Memahami dunia customer",
    question: "Apa kondisi mereka saat ini?",
    desc: "Sebelum mengenalkan solusi, kita harus memahami dan memvalidasi realitas harian audiens. Apa rutinitas mereka? Apa tekanan yang sedang mereka hadapi di tempat kerja atau kehidupan pribadi?",
    example: "Setiap hari Anda menghabiskan 3 jam memikirkan ide konten, tapi saat diposting, hanya mendapat 2 likes dan nol leads.",
  },
  {
    number: "02",
    name: "Character",
    role: "Fase Fondasi",
    tagline: "Customer sebagai protagonis",
    question: "Siapa mereka sebenarnya?",
    desc: "Audiens adalah pahlawan dalam cerita ini, bukan brand kita. Definisikan identitas mereka: apa peran mereka, apa nilai yang mereka perjuangkan, dan apa beban identitas yang mereka pikul.",
    example: "Sebagai solopreneur atau content creator pemula, Anda punya keahlian berharga, tetapi belum punya tim kreatif atau budget iklan besar.",
  },
  {
    number: "03",
    name: "Conflict",
    role: "Fase Katalis",
    tagline: "Gap yang nyata",
    question: "Apa masalah yang menghambat mereka?",
    desc: "Konflik adalah mesin penggerak perhatian. Tanpa konflik yang dirasakan mendalam, tidak ada urgensi untuk berubah. Paparkan jurang pemisah antara kondisi sekarang dan apa yang mereka cita-citakan.",
    example: "Anda ingin konsisten berkarya di LinkedIn dan Instagram, tetapi waktu habis untuk pekerjaan operasional sehingga konten selalu jadi korban nomor satu.",
  },
  {
    number: "04",
    name: "Desire",
    role: "Fase Katalis",
    tagline: "Masa depan lebih baik",
    question: "Apa yang mereka inginkan?",
    desc: "Visualisasikan kondisi ideal yang didambakan pahlawan kita. Ini bukan sekadar fitur produk, melainkan perasaan lega, status baru, dan pencapaian bermakna yang ingin diraih.",
    example: "Bisa memproduksi 1 minggu materi konten berkualitas tinggi hanya dalam waktu 45 menit, tanpa burnout atau kehabisan bahan obrolan.",
  },
  {
    number: "05",
    name: "Discovery",
    role: "Fase Titik Balik",
    tagline: "Perspektif baru",
    question: "Oh, ternyata ada cara!",
    desc: "Momen 'Aha!' yang mematahkan asumsi lama. Tunjukkan kenapa cara-cara konvensional gagal dan ungkap sudut pandang segar yang belum pernah mereka sadari sebelumnya.",
    example: "Masalahnya bukan Anda kurang kreatif atau malas. Masalahnya adalah Anda mencoba membuat 10 ide berbeda dari nol, bukannya me-repurpose 1 ide inti ke 10 format.",
  },
  {
    number: "06",
    name: "Mechanism",
    role: "Fase Titik Balik",
    tagline: "Cara kerja solusi",
    question: "Bagaimana ini bisa menyelesaikan masalah?",
    desc: "Beri penjelasan logis dan transparan mengenai sistem di balik solusi. Ketika audiens mengerti mekanismenya, keraguan intelektual mereka langsung berubah menjadi rasa percaya.",
    example: "Engine STORIQ membedah ide Anda menjadi 10 blok narasi terstruktur, lalu secara otomatis menyusun ulang pesan tersebut sesuai arsitektur psikologi setiap channel.",
  },
  {
    number: "07",
    name: "Proof",
    role: "Fase Validasi",
    tagline: "Bukti nyata",
    question: "Testimoni, case study, data",
    desc: "Klaim tanpa bukti adalah bualan kosong. Hadirkan bukti empiris: tangkapan layar hasil, angka pertumbuhan, studi kasus nyata, atau testimoni tulus dari orang yang serupa dengan mereka.",
    example: "Lebih dari 1.200 creator Indonesia telah memangkas 70% waktu produksi konten mereka dan melipatgandakan rasio klik penawaran landing page mereka.",
  },
  {
    number: "08",
    name: "Transformation",
    role: "Fase Validasi",
    tagline: "Perubahan before → after",
    question: "Apa yang berubah?",
    desc: "Bandingkan secara kontras hidup mereka sebelum bertemu solusi dan setelah menjalankannya. Kontras before-after memperjelas nilai (value) konkret yang akan mereka bawa pulang.",
    example: "Dari kreator yang stres menatap layar kosong setiap malam, menjadi strategist percaya diri dengan kalender konten terisi penuh dan lead masuk konsisten.",
  },
  {
    number: "09",
    name: "Risk Reduction",
    role: "Fase Konversi",
    tagline: "Kurangi persepsi risiko",
    question: "Garansi, transparansi",
    desc: "Sebelum audiens mengambil langkah, ketakutan akan salah pilih atau kerugian finansial/waktu akan muncul. Turunkan dinding risiko dengan transparansi dan garansi kenyamanan.",
    example: "100% gratis, open-source, dan berjalan langsung di browsermu. API key disimpan di local storage perambanmu sendiri, tanpa biaya langganan siluman.",
  },
  {
    number: "10",
    name: "Action",
    role: "Fase Konversi",
    tagline: "Langkah berikutnya",
    question: "CTA yang natural dan relevan",
    desc: "Ajakan bertindak yang jelas, sederhana, dan tidak mengintimidasi. Berikan satu langkah konkret yang logis diambil saat ini juga sebagai kulminasi dari seluruh perjalanan cerita.",
    example: "Mulai ubah 1 ide pertamamu hari ini. Masukkan topik di Generator STORIQ dan rasakan bedanya dalam 60 detik.",
  },
];

const hierarchySteps = [
  {
    step: "01",
    name: "Big Idea",
    badge: "Hook Awal",
    desc: "Gagasan payung yang memikat perhatian dan memicu rasa penasaran dalam 3 detik pertama.",
    why: "Tanpa Big Idea yang tajam, pembaca akan langsung scroll melewati halaman Anda.",
  },
  {
    step: "02",
    name: "Core Problem",
    badge: "Validasi Emosi",
    desc: "Pengakuan jujur atas masalah terdalam yang selama ini dipendam dan dirasakan pembaca.",
    why: "Membangun koneksi instan bahwa Anda benar-benar mengerti penderitaan mereka.",
  },
  {
    step: "03",
    name: "Insight",
    badge: "Akar Masalah",
    desc: "Mengapa cara-cara yang mereka coba sebelumnya selalu berujung buntu atau mengecewakan.",
    why: "Membebaskan pembaca dari rasa bersalah atas kegagalan masa lalu mereka.",
  },
  {
    step: "04",
    name: "New Perspective",
    badge: "Titik Balik",
    desc: "Paradigma baru yang membuka wawasan: sebuah sudut pandang segar yang masuk akal.",
    why: "Memberikan harapan baru bahwa ada jalur alternatif yang lebih efektif.",
  },
  {
    step: "05",
    name: "Proof",
    badge: "Validasi Logika",
    desc: "Bukti nyata, data terukur, dan studi kasus yang memvalidasi bahwa perspektif baru ini berhasil.",
    why: "Memuaskan otak rasional skeptis pembaca sebelum penawaran diberikan.",
  },
  {
    step: "06",
    name: "Offer",
    badge: "Solusi Nyata",
    desc: "Presentasi solusi atau alat bantu yang dirancang khusus untuk mewujudkan perspektif baru tadi.",
    why: "Solusi hadir tepat saat pembaca telah menginginkan dan mempercayai pendekatannya.",
  },
  {
    step: "07",
    name: "Risk Reduction",
    badge: "Hapus Keraguan",
    desc: "Menghilangkan friksi, kekhawatiran, dan rasa takut salah mengambil keputusan.",
    why: "Membuat keputusan bertindak terasa sangat aman, masuk akal, dan mudah dilakukan.",
  },
  {
    step: "08",
    name: "Action",
    badge: "Konversi Alami",
    desc: "Call to Action yang tegas, spesifik, dan bebas tekanan intimidatif.",
    why: "Langkah akhir yang terasa sebagai kesimpulan logis dari seluruh cerita yang telah dibaca.",
  },
];

const psychologicalStates = [
  {
    stage: "01",
    state: "Unaware",
    title: "Belum Sadar Masalah",
    thought: "“Rasanya konten gue oke-oke aja, kenapa harus repot pakai framework segala?”",
    objective: "Membuka mata mereka terhadap gejala halus yang sering diabaikan.",
    contentApproach: "Cerita relatable, analogi hidup sehari-hari, data tren industri terkini.",
  },
  {
    stage: "02",
    state: "Problem Aware",
    title: "Sadar Ada Masalah",
    thought: "“Kok rasanya capek banget bikin konten tiap hari tapi follow-up & penjualannya sepi ya?”",
    objective: "Membantu mereka menamai masalah spesifik tanpa menyalahkan diri sendiri.",
    contentApproach: "Validasi keluhan, bedah anatomi masalah, tunjukkan bahwa mereka tidak sendirian.",
  },
  {
    stage: "03",
    state: "Pain Aware",
    title: "Merasakan Dampak Masalah",
    thought: "“Kalau tiap bulan buang waktu 60 jam bikin konten tanpa hasil, bisnis gue bisa gulung tikar.”",
    objective: "Membantu mereka menyadari opportunity cost dan bahaya menunda perbaikan.",
    contentApproach: "Eksplorasi konsekuensi jangka panjang dan frustrasi tersembunyi dengan empati.",
  },
  {
    stage: "04",
    state: "Solution Aware",
    title: "Sadar Ada Jenis Solusi",
    thought: "“Katanya metode Content Repurposing berbasis Storytelling itu efektif, tapi gimana caranya?”",
    objective: "Mengedukasi kategori solusi dan mengapa pendekatan berbasis cerita adalah yang terbaik.",
    contentApproach: "Panduan metode, framework berpikir, komparasi efisiensi cara lama vs cara baru.",
  },
  {
    stage: "05",
    state: "Product Aware",
    title: "Sadar Keberadaan STORIQ",
    thought: "“Gue tahu ada STORIQ. Tapi apakah engine ini beneran cocok buat kebutuhan saya?”",
    objective: "Memperlihatkan keunikan fitur, kecepatan kerja, dan kemudahan penggunaan engine.",
    contentApproach: "Demo produk, tur fitur, contoh output sebelum dan sesudah diproses.",
  },
  {
    stage: "06",
    state: "Trust",
    title: "Membangun Keyakinan",
    thought: "“Metode Mas Andre ini grounded banget di CRO nyata. Framework-nya masuk akal dan transparan.”",
    objective: "Menghilangkan keraguan terakhir terkait kredibilitas sistem dan penciptanya.",
    contentApproach: "Studi kasus riil, testimoni pengguna, filosofi di balik arsitektur konversi.",
  },
  {
    stage: "07",
    state: "Action",
    title: "Siap Bertindak",
    thought: "“Alatnya gratis, nggak butuh kartu kredit, dan langsung bisa dicoba sekarang. Gas!”",
    objective: "Memberikan jalan masuk termudah dengan zero-friction untuk memulai.",
    contentApproach: "CTA spesifik satu klik, instruksi sederhana 1-2-3, jaminan kemudahan akses.",
  },
];

const corePrinciples = [
  {
    id: "01",
    title: "Customer first",
    desc: "Audiens adalah protagonis yang sedang berjuang. Jadikan kebutuhan, luka, dan harapan mereka sebagai pusat gravitasi tulisanmu.",
  },
  {
    id: "02",
    title: "Relevance before persuasion",
    desc: "Tanpa relevansi, kata-kata paling manis sekalipun dianggap kebisingan. Buktikan kamu memahami dunia mereka sebelum mencoba meyakinkan.",
  },
  {
    id: "03",
    title: "Story before selling",
    desc: "Cerita menembus filter defensif di otak audiens. Jangan buru-buru berjualan sebelum kamu membangun empati dan relasi emosional.",
  },
  {
    id: "04",
    title: "Conflict creates attention",
    desc: "Kisah tanpa rintangan membosankan pembaca. Buka gap nyata antara kenyataan pahit hari ini dan ekspektasi yang belum terwujud.",
  },
  {
    id: "05",
    title: "Desire creates movement",
    desc: "Ketakutan menghentikan orang, tetapi kerinduan akan masa depan yang lebih baik memicu inisiatif untuk melangkah maju.",
  },
  {
    id: "06",
    title: "Mechanism creates understanding",
    desc: "Keajaiban tanpa penjelasan memicu skeptisisme. Tunjukkan mekanisme logis kenapa solusi ini sanggup menyelesaikan konflik mereka.",
  },
  {
    id: "07",
    title: "Proof creates belief",
    desc: "Klaim sepihak adalah beban; bukti otentik adalah mata uang kepercayaan. Dukung setiap janji besar dengan bukti nyata.",
  },
  {
    id: "08",
    title: "Transformation creates value",
    desc: "Orang tidak membeli produk, format, atau tombol. Mereka membeli versi diri mereka yang lebih tenang, kompeten, dan berhasil.",
  },
  {
    id: "09",
    title: "Reduce risk before asking action",
    desc: "Setiap ajakan bertindak menimbulkan kecemasan. Redakan risiko terlebih dahulu agar tombol CTA menjadi pintu keluar yang melegakan.",
  },
  {
    id: "10",
    title: "Every message must move psychology",
    desc: "Tidak boleh ada kalimat pemanis atau filler. Setiap paragraf harus memindahkan status psikologis audiens satu langkah lebih dekat ke keputusan.",
  },
];
---

<Base
  title="STORIQ Framework — Metodologi Storytelling & Konversi"
  description="Strategic framework yang menggabungkan storytelling, copywriting, psychology, dan conversion untuk merancang perjalanan psikologi menuju action."
>
  <Header slot="header" />

  <!-- 1. HERO SECTION -->
  <section class="relative bg-navy-800 text-white pt-16 pb-20 md:pt-24 md:pb-28 overflow-hidden border-b border-navy-700">
    <!-- Subtle background accent circles -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-0 -left-20 w-80 h-80 bg-blue-600/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 relative z-10 text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/15 border border-blue-400/30 text-blue-300 text-xs sm:text-sm font-medium mb-6">
        <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
        Metodologi & Arsitektur Konversi
      </div>

      <!-- Main Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-white mb-4">
        STORIQ <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-blue-300 to-blue-200">Framework</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-lg sm:text-xl md:text-2xl font-semibold text-blue-300 max-w-2xl mx-auto mb-6">
        Mengubah storytelling menjadi conversion
      </p>

      <!-- Description -->
      <p class="text-base sm:text-lg text-slate-300 max-w-3xl mx-auto leading-relaxed mb-10">
        Strategic framework yang menggabungkan storytelling, copywriting, psychology, dan conversion untuk merancang perjalanan psikologi menuju action.
      </p>

      <!-- Educational context box -->
      <div class="max-w-3xl mx-auto bg-navy-900/80 border border-navy-700/80 rounded-2xl p-5 sm:p-6 text-left mb-10 shadow-xl backdrop-blur-sm">
        <div class="flex items-start gap-3.5">
          <div class="w-8 h-8 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center shrink-0 font-bold text-sm">
            💡
          </div>
          <div>
            <h2 class="text-sm sm:text-base font-semibold text-white mb-1">
              Kenapa Storytelling Saja Tidak Cukup?
            </h2>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Banyak cerita menarik di media sosial yang disukai banyak orang, tetapi berakhir dengan nol konversi. Cerita tanpa struktur psikologi hanyalah hiburan. STORIQ Framework merancang setiap babak narasi sebagai jembatan kognitif terukur: dari rasa ragu menuju keyakinan penuh untuk bertindak.
            </p>
          </div>
        </div>
      </div>

      <!-- Quick Section Anchor Links -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs sm:text-sm">
        <a href="#filosofi" class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/10 transition-colors">
          Filosofi
        </a>
        <a href="#10-elemen" class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/10 transition-colors">
          10 Elemen Inti
        </a>
        <a href="#hierarki-pesan" class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/10 transition-colors">
          Hierarki Pesan
        </a>
        <a href="#psikologi" class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/10 transition-colors">
          7 State Psikologis
        </a>
        <a href="#prinsip" class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/10 transition-colors">
          Prinsip Inti
        </a>
      </div>
    </div>
  </section>

  <!-- 2. PHILOSOPHY SECTION (white bg) -->
  <section id="filosofi" class="bg-white py-16 sm:py-20 md:py-24 border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-xs sm:text-sm font-semibold text-blue-600 tracking-wider uppercase">
          Filosofi Dasar
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-slate-900 mt-2">
          Landing Page Bukan Sekadar Lembaran Informasi
        </h2>
        <div class="w-12 h-1 bg-blue-500 mx-auto mt-4 rounded-full"></div>
      </div>

      <!-- Quote Card -->
      <div class="relative bg-slate-50 border-l-4 border-blue-500 rounded-r-2xl p-6 sm:p-8 md:p-10 mb-14 shadow-sm">
        <svg class="absolute top-4 right-4 sm:top-6 sm:right-6 w-12 h-12 text-slate-200 pointer-events-none" fill="currentColor" viewBox="0 0 24 24">
          <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
        </svg>
        <blockquote class="relative z-10">
          <p class="text-lg sm:text-xl md:text-2xl font-medium text-slate-800 italic leading-relaxed mb-4">
            “Setiap landing page bukan sekadar menyampaikan pesan. Ia harus membawa seseorang melewati sebuah journey.”
          </p>
          <footer class="text-sm sm:text-base font-semibold text-slate-700">
            — Andre Wahyu Hermawan <span class="text-xs sm:text-sm text-slate-500 font-normal block sm:inline sm:ml-2">Landing Page Strategist & CRO</span>
          </footer>
        </blockquote>
      </div>

      <!-- Protagonist vs Guide Concept -->
      <div class="grid md:grid-cols-2 gap-8 mb-16 items-stretch">
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 text-blue-700 text-xs font-semibold mb-4">
              Pahlawan Cerita
            </div>
            <h3 class="text-xl sm:text-2xl font-bold text-slate-900 mb-3">
              Customer sebagai Protagonis
            </h3>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed mb-4">
              Banyak copywriter terjebak menjadikan brand sebagai pahlawan yang serba hebat. Dalam STORIQ Framework, protagonis sejati adalah customer Anda.
            </p>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
              Merekalah yang memiliki rintangan, keraguan, dan cita-cita besar. Tulisan Anda harus berfokus pada apa yang mereka alami, bukan berapa lama perusahaan Anda telah berdiri.
            </p>
          </div>
          <div class="mt-6 pt-6 border-t border-slate-200 flex items-center gap-3 text-xs sm:text-sm text-slate-500">
            <span class="text-blue-500 font-bold">Prinsip:</span> Fokus pada perjuangan dan transformasi sang pembaca.
          </div>
        </div>

        <div class="bg-navy-800 text-white rounded-2xl p-6 sm:p-8 flex flex-col justify-between shadow-lg">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 text-xs font-semibold mb-4 border border-blue-400/30">
              Pemandu Tepercaya
            </div>
            <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">
              Brand sebagai Guide (Mentor)
            </h3>
            <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-4">
              Jika customer adalah Luke Skywalker, brand Anda adalah Yoda. Jika customer adalah Frodo, Anda adalah Gandalf.
            </p>
            <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
              Peran Anda bukan mencuri panggung, melainkan membekali sang protagonis dengan peta jalan yang jelas, empati tulus, dan alat yang tepat agar mereka mampu mengalahkan naga masalah mereka sendiri.
            </p>
          </div>
          <div class="mt-6 pt-6 border-t border-navy-700 flex items-center gap-3 text-xs sm:text-sm text-blue-300">
            <span class="text-white font-bold">Prinsip:</span> Guide hadir dengan empati dan otoritas teruji.
          </div>
        </div>
      </div>

      <!-- 3 Big Jobs -->
      <div class="mt-12">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <h3 class="text-xl sm:text-2xl font-bold text-slate-900">
            3 Pekerjaan Besar (Big Jobs) Konten & Landing Page
          </h3>
          <p class="text-sm text-slate-600 mt-2">
            Sebelum seseorang bersedia mengklik tombol atau membeli produk, pikiran mereka harus menyelesaikan 3 fase kognitif ini secara berurutan:
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-6">
          <!-- Job 1: Recognition -->
          <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 hover:border-blue-400 transition-colors">
            <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 font-bold flex items-center justify-center text-base mb-4">
              01
            </div>
            <h4 class="text-lg font-bold text-slate-900 mb-2">Recognition</h4>
            <p class="text-xs font-semibold text-blue-600 mb-3">Mengenali Masalah</p>
