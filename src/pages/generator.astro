---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { FRAMEWORKS, OUTPUT_FORMATS } from '../scripts/prompts.js';
---

<Base title="Generator — STORIQ" description="Generate konten berbasis storytelling. Satu ide, banyak format.">
  <Header slot="header" />

  <!-- Step Indicator -->
  <div class="bg-navy-800 text-white py-4 px-4">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center justify-between text-xs sm:text-sm" id="step-indicators">
        <button data-step="1" class="step-dot active flex flex-col items-center gap-1">
          <span class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center font-bold">1</span>
          <span class="hidden sm:block">Ide</span>
        </button>
        <div class="flex-1 h-0.5 bg-navy-600 mx-2"></div>
        <button data-step="2" class="step-dot flex flex-col items-center gap-1">
          <span class="w-8 h-8 rounded-full bg-navy-600 flex items-center justify-center font-bold">2</span>
          <span class="hidden sm:block">Framework</span>
        </button>
        <div class="flex-1 h-0.5 bg-navy-600 mx-2"></div>
        <button data-step="3" class="step-dot flex flex-col items-center gap-1">
          <span class="w-8 h-8 rounded-full bg-navy-600 flex items-center justify-center font-bold">3</span>
          <span class="hidden sm:block">Mode</span>
        </button>
        <div class="flex-1 h-0.5 bg-navy-600 mx-2"></div>
        <button data-step="4" class="step-dot flex flex-col items-center gap-1">
          <span class="w-8 h-8 rounded-full bg-navy-600 flex items-center justify-center font-bold">4</span>
          <span class="hidden sm:block">Hasil</span>
        </button>
      </div>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-8">

    <!-- STEP 1: Input Ide -->
    <section id="step-1" class="step-panel">
      <h2 class="text-2xl font-bold text-slate-800 mb-1">💡 Masukkan Ide Kontenmu</h2>
      <p class="text-slate-500 mb-6">Ceritakan apa yang ingin kamu sampaikan. Tidak perlu sempurna — tulis apa adanya.</p>

      <div class="space-y-5">
        <div>
          <label for="topik" class="block text-sm font-medium text-slate-700 mb-1">Topik / Ide Utama</label>
          <textarea id="topik" rows="3" placeholder="Contoh: Kenapa landing page yang bagus belum tentu menghasilkan konversi?" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none resize-none text-slate-800"></textarea>
        </div>

        <div>
          <label for="audiens" class="block text-sm font-medium text-slate-700 mb-1">Target Audiens</label>
          <input id="audiens" type="text" placeholder="Contoh: Pemilik bisnis online, marketer pemula" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-slate-800" />
        </div>

        <div>
          <label for="tujuan" class="block text-sm font-medium text-slate-700 mb-1">Tujuan Konten</label>
          <input id="tujuan" type="text" placeholder="Contoh: Edukasi + personal branding" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-slate-800" />
        </div>

        <div>
          <label for="tone" class="block text-sm font-medium text-slate-700 mb-1">Tone / Gaya Bahasa</label>
          <select id="tone" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none bg-white text-slate-800">
            <option value="santai">🗣️ Santai & Friendly</option>
            <option value="profesional">💼 Profesional</option>
            <option value="edukatif">📚 Edukatif & Informatif</option>
            <option value="inspiratif">✨ Inspiratif & Motivasi</option>
            <option value="storytelling">📖 Storytelling (bercerita)</option>
          </select>
        </div>
      </div>

      <div class="mt-8 flex justify-end">
        <button onclick="goToStep(2)" class="px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-lg font-medium transition-colors">
          Lanjut: Pilih Framework →
        </button>
      </div>
    </section>

    <!-- STEP 2: Pilih Framework -->
    <section id="step-2" class="step-panel hidden">
      <h2 class="text-2xl font-bold text-slate-800 mb-1">🧭 Pilih Framework Storytelling</h2>
      <p class="text-slate-500 mb-6">Framework menentukan alur dan struktur psikologi ceritamu.</p>

      <!-- Framework Selection -->
      <h3 class="text-lg font-semibold text-slate-700 mb-3">Framework Storytelling</h3>
      <div class="grid gap-3 mb-8" id="framework-options">
        {FRAMEWORKS.map((fw, index) => (
          <label class={`framework-option border-2 rounded-lg p-4 cursor-pointer hover:border-slate-300 ${index === 0 ? 'border-blue-500 bg-blue-50' : 'border-slate-200'}`}>
            <input type="radio" name="framework" value={fw.id} checked={index === 0} class="sr-only" />
            <div class="flex items-start gap-3">
              <span class={`w-5 h-5 mt-0.5 rounded-full border-2 flex items-center justify-center flex-shrink-0 ${index === 0 ? 'border-blue-500' : 'border-slate-300'}`}>
                {index === 0 && <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>}
              </span>
              <div>
                <p class="font-semibold text-slate-800">
                  {fw.label} 
                  {index === 0 && <span class="text-xs text-blue-600 bg-blue-100 px-2 py-0.5 rounded-full ml-1">Recommended</span>}
                </p>
                <p class="text-sm text-slate-500 mt-0.5">{fw.desc}</p>
              </div>
            </div>
          </label>
        ))}
      </div>

      <!-- Format Selection Removed -->

      <div class="mt-8 flex justify-between">
        <button onclick="goToStep(1)" class="px-6 py-3 border border-slate-300 text-slate-600 rounded-lg font-medium hover:bg-slate-50 transition-colors">
          ← Kembali
        </button>
        <button onclick="goToStep(3)" class="px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-lg font-medium transition-colors">
          Lanjut: Pilih Mode →
        </button>
      </div>
    </section>

    <!-- STEP 3: Pilih Mode & Generate -->
    <section id="step-3" class="step-panel hidden">
      <h2 class="text-2xl font-bold text-slate-800 mb-1">⚡ Pilih Mode & Generate</h2>
      <p class="text-slate-500 mb-6">Dua cara pakai — pilih yang paling nyaman buat kamu.</p>

      <!-- Mode Tabs -->
      <div class="flex border-b border-slate-200 mb-6">
        <button id="tab-prompt" onclick="switchMode('prompt')" class="px-4 py-2.5 text-sm font-medium border-b-2 border-blue-500 text-blue-600">
          📋 Prompt Generator
        </button>
        <button id="tab-api" onclick="switchMode('api')" class="px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-700">
          🤖 API Key SumoPod
        </button>
      </div>

      <!-- Mode 1: Prompt Generator -->
      <div id="mode-prompt">
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6">
          <p class="text-sm text-amber-800">
            <strong>Cara kerja:</strong> STORIQ membuat prompt terstruktur → kamu copy → paste ke ChatGPT, Gemini, atau Claude → tempel hasilnya kembali (opsional).
            <strong>Tidak perlu API key!</strong>
          </p>
        </div>

        <button id="btn-generate-prompt" onclick="generatePrompt()" class="w-full py-3.5 bg-amber-500 hover:bg-amber-600 text-white rounded-lg font-semibold text-lg transition-colors flex items-center justify-center gap-2">
          <span>📋</span> Generate Prompt
        </button>

        <!-- Generated Prompt Display -->
        <div id="prompt-output" class="mt-8 hidden animate-fade-in">
          <div class="mb-2">
            <label class="block text-sm font-semibold text-slate-700">Hasil Prompt (Siap Copy-Paste):</label>
          </div>
          <textarea id="prompt-text" rows="12" readonly class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-700 font-mono resize-none"></textarea>
          
          <button onclick="copyPrompt()" class="mt-4 w-full py-4 bg-slate-800 hover:bg-slate-900 text-white rounded-xl font-bold text-lg transition-colors flex items-center justify-center gap-2 shadow-md">
            📋 COPY PROMPT
          </button>

          <div class="mt-6 mb-8">
            <p class="text-sm font-semibold text-slate-700 mb-3 text-center">Paste prompt ke salah satu AI favoritmu:</p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <a href="https://chat.openai.com" target="_blank" class="flex items-center justify-center gap-2 px-4 py-3 bg-white hover:bg-slate-50 border border-slate-200 hover:border-emerald-500 rounded-xl text-sm font-bold text-slate-700 transition-all shadow-sm hover:shadow-md">
                <svg class="w-5 h-5 text-emerald-600" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.073Zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944ZM2.5797 15.1152a4.4944 4.4944 0 0 1-.288-3.039l.142.0804 4.7783 2.7582a.7948.7948 0 0 0 .7855 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 17.516a4.4992 4.4992 0 0 1-7.1603-2.4008ZM5.4578 4.786a4.4944 4.4944 0 0 1 2.5884-1.579l-.0474.1564-2.3892 4.14-2.3891 4.14a.79.79 0 0 0-.0047.79v6.7369l-2.02-1.1686a.071.071 0 0 1-.038-.052v-5.5826a4.4992 4.4992 0 0 1 4.3-7.581ZM21.4203 8.8848a4.4944 4.4944 0 0 1 .288 3.039l-.142-.0804-4.7783-2.7582a.7948.7948 0 0 0-.7855 0l-5.8428 3.3685V10.121a.0804.0804 0 0 1 .0332-.0615l4.0669-2.3456a4.4992 4.4992 0 0 1 7.1603 2.4008v-.2295ZM18.5422 19.214a4.4944 4.4944 0 0 1-2.5884 1.579l.0474-.1564 2.3892-4.14 2.3891-4.14a.79.79 0 0 0 .0047-.79V4.8302l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.4992 4.4992 0 0 1-4.3 7.581ZM8.74 15.225l-2.02-1.1686V8.4738a.071.071 0 0 1 .038-.052l4.0669-2.3456a.071.071 0 0 1 .071 0l2.02 1.1686v5.5826a.071.071 0 0 1-.038.052L8.811 15.225a.071.071 0 0 1-.071 0Z"></path>
                </svg>
                ChatGPT
              </a>
              <a href="https://gemini.google.com" target="_blank" class="flex items-center justify-center gap-2 px-4 py-3 bg-white hover:bg-slate-50 border border-slate-200 hover:border-blue-400 rounded-xl text-sm font-bold text-slate-700 transition-all shadow-sm hover:shadow-md">
                <svg class="w-5 h-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                  <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                  <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                  <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
                Gemini
              </a>
              <a href="https://claude.ai" target="_blank" class="flex items-center justify-center gap-2 px-4 py-3 bg-white hover:bg-slate-50 border border-slate-200 hover:border-amber-500 rounded-xl text-sm font-bold text-slate-700 transition-all shadow-sm hover:shadow-md">
                <svg class="w-5 h-5 text-amber-700" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C12 7.52 16.48 12 22 12C16.48 12 12 16.48 12 22C12 16.48 7.52 12 2 12C7.52 12 12 7.52 12 2Z" />
                </svg>
                Claude
              </a>
            </div>
          </div>

        </div>
      </div>

      <!-- Mode 2: AI API -->
      <div id="mode-api" class="hidden">
        <div class="border border-slate-200 rounded-xl p-5 mb-6 bg-white shadow-sm flex flex-col items-center text-center">
          <div class="w-16 h-16 bg-blue-50 rounded-full flex items-center justify-center text-3xl mb-4 text-blue-500">⚡</div>
          <h3 class="font-bold text-slate-800 text-lg mb-2">SumoPod BYOK (Otomatis)</h3>
          
          <div id="sumopod-state-connected" class="hidden flex-col items-center">
            <span class="px-3 py-1 bg-green-100 text-green-700 text-xs font-bold uppercase tracking-wider rounded-full mb-3 border border-green-200">Terhubung</span>
            <p class="text-sm text-slate-500 mb-6 max-w-sm">
              Koneksi API SumoPod kamu sudah aktif. Klik tombol di bawah untuk langsung men-generate konten.
            </p>
            <input type="hidden" id="provider" value="sumopod" />
            <input type="hidden" id="apikey" value="" />
            <button id="btn-generate-api" onclick="generateWithAPI()" class="px-8 py-3.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold text-lg transition-colors shadow-lg shadow-blue-500/30 flex items-center gap-2">
              <span>⚡</span> Mulai Generate
            </button>
            <a href={`${import.meta.env.BASE_URL}pengaturan/`} class="mt-4 text-sm text-slate-400 hover:text-slate-600 underline">Kelola koneksi API</a>
          </div>

          <div id="sumopod-state-disconnected" class="flex flex-col items-center">
            <span class="px-3 py-1 bg-slate-100 text-slate-500 text-xs font-bold uppercase tracking-wider rounded-full mb-3 border border-slate-200">Belum Terhubung</span>
            <p class="text-sm text-slate-500 mb-6 max-w-sm">
              Hubungkan API Key SumoPod kamu terlebih dahulu di halaman Pengaturan untuk menggunakan fitur generate otomatis.
            </p>
            <a href={`${import.meta.env.BASE_URL}pengaturan/`} class="px-6 py-3 bg-slate-800 hover:bg-slate-900 text-white rounded-lg font-semibold text-sm transition-colors flex items-center gap-2">
              ⚙️ Buka Pengaturan API
            </a>
          </div>
        </div>
      </div>

      <div class="mt-8 flex justify-between items-center">
        <button onclick="goToStep(2)" class="px-6 py-3 border border-slate-300 text-slate-600 rounded-lg font-medium hover:bg-slate-50 transition-colors">
          ← Kembali
        </button>
        <button onclick="goToStep(4)" class="px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-lg font-medium transition-colors">
          Lanjut →
        </button>
      </div>
    </section>

    <!-- STEP 4: Output -->
    <section id="step-4" class="step-panel hidden">
      <div class="flex items-center justify-between mb-1">
        <h2 class="text-2xl font-bold text-slate-800">✨ Hasil Konten</h2>
        <span id="output-format-badge" class="text-xs bg-blue-100 text-blue-700 px-2.5 py-1 rounded-full font-medium"></span>
      </div>
      <p class="text-slate-500 mb-6">Kontenmu sudah jadi! Copy, download, atau generate format lain.</p>

      <!-- Loading State -->
      <div id="output-loading" class="hidden text-center py-12">
        <div class="inline-block w-8 h-8 border-3 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
        <p class="mt-3 text-slate-500">Sedang generate konten...</p>
        <p class="text-xs text-slate-400 mt-1">Ini mungkin butuh 10-30 detik</p>
      </div>

      <!-- Error State -->
      <div id="output-error" class="hidden bg-red-50 border border-red-200 rounded-lg p-4">
        <p class="text-red-700 font-medium">❌ Terjadi kesalahan</p>
        <p id="error-message" class="text-sm text-red-600 mt-1"></p>
        <button onclick="goToStep(3)" class="mt-3 text-sm text-red-600 hover:text-red-700 font-medium">← Coba lagi</button>
      </div>

      <!-- Output Content -->
      <div id="output-content" class="hidden">
        <!-- Main Output -->
        <div class="bg-white border border-slate-200 rounded-lg">
          <div class="flex items-center justify-between px-4 py-3 border-b border-slate-100">
            <span class="text-sm font-medium text-slate-500">Output</span>
            <div class="flex gap-2">
              <button onclick="copyOutput()" class="text-xs px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-md transition-colors flex items-center gap-1">
                📋 Copy
              </button>
              <button onclick="downloadOutput()" class="text-xs px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-md transition-colors flex items-center gap-1">
                💾 Download .md
              </button>
            </div>
          </div>
          <div id="output-text" class="px-4 py-4 prose prose-sm max-w-none text-slate-700 whitespace-pre-wrap leading-relaxed"></div>
        </div>

        <!-- Actions (Repurpose) -->
        <div class="mt-6 border-t border-slate-200 pt-5">
          <h4 class="text-sm font-semibold text-slate-800 mb-3">🔄 Repurpose Konten Ini Ke:</h4>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-4">
            <button onclick="generateWithAPI('carousel')" class="p-2 border border-slate-200 rounded-lg hover:border-blue-400 hover:bg-blue-50 text-xs font-medium text-slate-700 transition-colors flex items-center justify-center gap-1.5">
              📱 Carousel IG
            </button>
            <button onclick="generateWithAPI('thread')" class="p-2 border border-slate-200 rounded-lg hover:border-blue-400 hover:bg-blue-50 text-xs font-medium text-slate-700 transition-colors flex items-center justify-center gap-1.5">
              🐦 X Thread
            </button>
            <button onclick="generateWithAPI('caption')" class="p-2 border border-slate-200 rounded-lg hover:border-blue-400 hover:bg-blue-50 text-xs font-medium text-slate-700 transition-colors flex items-center justify-center gap-1.5">
              💬 Caption
            </button>
            <button onclick="generateWithAPI('video')" class="p-2 border border-slate-200 rounded-lg hover:border-blue-400 hover:bg-blue-50 text-xs font-medium text-slate-700 transition-colors flex items-center justify-center gap-1.5">
              🎬 Video Script
            </button>
            <button onclick="generateWithAPI('quote')" class="p-2 border border-slate-200 rounded-lg hover:border-blue-400 hover:bg-blue-50 text-xs font-medium text-slate-700 transition-colors flex items-center justify-center gap-1.5">
              💡 Quote Image
            </button>
            <button onclick="generateWithAPI('linkedin')" class="p-2 border border-slate-200 rounded-lg hover:border-blue-400 hover:bg-blue-50 text-xs font-medium text-slate-700 transition-colors flex items-center justify-center gap-1.5">
              💼 LinkedIn Post
            </button>
            <button onclick="generateWithAPI('pinterest')" class="p-2 border border-slate-200 rounded-lg hover:border-blue-400 hover:bg-blue-50 text-xs font-medium text-slate-700 transition-colors flex items-center justify-center gap-1.5">
              📌 Pinterest Pin
            </button>
            <button onclick="generateWithAPI('blog')" class="p-2 border border-slate-200 rounded-lg hover:border-blue-400 hover:bg-blue-50 text-xs font-medium text-slate-700 transition-colors flex items-center justify-center gap-1.5">
              📝 Artikel Blog
            </button>
          </div>
          <button onclick="goToStep(1)" class="w-full py-3 border border-slate-300 text-slate-600 rounded-lg font-medium hover:bg-slate-50 transition-colors text-sm">
            ✏️ Buat Ide Baru (Mulai dari Awal)
          </button>
        </div>
      </div>
    </section>

  </div>

  <!-- Toast Notification -->
  <div id="toast" class="fixed bottom-4 right-4 bg-slate-800 text-white px-4 py-2.5 rounded-lg text-sm shadow-lg transform translate-y-20 opacity-0 transition-all duration-300 z-50"></div>

  <Footer slot="footer" />
</Base>

<style>
  .step-dot.active span:first-child { background-color: #3b82f6; }
  .step-dot.completed span:first-child { background-color: #22c55e; }
</style>

<script>
  import { buildPrompt } from '../scripts/prompts.js';
  import { generate, PROVIDERS } from '../scripts/ai-client.js';
  import { saveApiKey, getApiKey } from '../scripts/storage.js';

  // --- State ---
  let currentStep = 1;
  let abortController = null;

  // --- Step Navigation ---
  window.goToStep = function(step) {
    // Validate step 1 before moving forward
    if (step > 1 && currentStep === 1) {
      const topik = document.getElementById('topik').value.trim();
      if (!topik) {
        showToast('⚠️ Tulis topik dulu ya!');
        document.getElementById('topik').focus();
        return;
      }
    }

    document.querySelectorAll('.step-panel').forEach(p => p.classList.add('hidden'));
    document.getElementById(`step-${step}`)?.classList.remove('hidden');

    // Update indicators
    document.querySelectorAll('.step-dot').forEach(dot => {
      const s = parseInt(dot.dataset.step);
      const circle = dot.querySelector('span:first-child');
      dot.classList.remove('active', 'completed');
      if (s < step) {
        dot.classList.add('completed');
        circle.style.backgroundColor = '#22c55e';
      } else if (s === step) {
        dot.classList.add('active');
        circle.style.backgroundColor = '#3b82f6';
      } else {
        circle.style.backgroundColor = '';
      }
    });

    currentStep = step;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // --- Framework & Format Selection UI ---
  document.getElementById('framework-options')?.addEventListener('change', (e) => {
    document.querySelectorAll('.framework-option').forEach(opt => {
      opt.classList.remove('border-blue-500', 'bg-blue-50');
      opt.classList.add('border-slate-200');
      const dot = opt.querySelector('.w-2\\.5');
      if (dot) dot.remove();
    });
    const label = e.target.closest('label');
    if (label) {
      label.classList.remove('border-slate-200');
      label.classList.add('border-blue-500', 'bg-blue-50');
      const circle = label.querySelector('.w-5');
      if (circle && !circle.querySelector('.w-2\\.5')) {
        const inner = document.createElement('span');
        inner.className = 'w-2.5 h-2.5 rounded-full bg-blue-500';
        circle.appendChild(inner);
      }
    }
  });

  document.getElementById('format-options')?.addEventListener('change', (e) => {
    document.querySelectorAll('.format-option').forEach(opt => {
      opt.classList.remove('border-blue-500', 'bg-blue-50');
      opt.classList.add('border-slate-200');
    });
    const label = e.target.closest('label');
    if (label) {
      label.classList.remove('border-slate-200');
      label.classList.add('border-blue-500', 'bg-blue-50');
    }
  });

  // --- Mode Switching ---
  window.switchMode = function(mode) {
    const apiTab = document.getElementById('tab-api');
    const promptTab = document.getElementById('tab-prompt');
    const apiPanel = document.getElementById('mode-api');
    const promptPanel = document.getElementById('mode-prompt');

    if (mode === 'api') {
      apiTab.classList.add('border-blue-500', 'text-blue-600');
      apiTab.classList.remove('border-transparent', 'text-slate-500');
      promptTab.classList.remove('border-blue-500', 'text-blue-600');
      promptTab.classList.add('border-transparent', 'text-slate-500');
      apiPanel.classList.remove('hidden');
      promptPanel.classList.add('hidden');
    } else {
      promptTab.classList.add('border-blue-500', 'text-blue-600');
      promptTab.classList.remove('border-transparent', 'text-slate-500');
      apiTab.classList.remove('border-blue-500', 'text-blue-600');
      apiTab.classList.add('border-transparent', 'text-slate-500');
      promptPanel.classList.remove('hidden');
      apiPanel.classList.add('hidden');
    }
  };

  // --- Gather Form Data ---
  function getFormData(formatOverride = null) {
    return {
      topik: document.getElementById('topik').value.trim(),
      audiens: document.getElementById('audiens').value.trim() || 'Umum',
      tujuan: document.getElementById('tujuan').value.trim() || 'Edukasi',
      tone: document.getElementById('tone').value,
      framework: document.querySelector('input[name="framework"]:checked')?.value || 'storiq10',
      format: formatOverride || document.querySelector('input[name="format"]:checked')?.value || 'blog',
    };
  }

  function getFormatLabel(format) {
    const labels = {
      blog: '📝 Artikel Blog', carousel: '📱 Carousel IG', caption: '💬 Caption',
      video: '🎬 Video Script', thread: '🐦 X Thread', quote: '💡 Quote',
      linkedin: '💼 LinkedIn', pinterest: '📌 Pinterest',
    };
    return labels[format] || format;
  }

  // --- Mode 2: Generate Prompt ---
  window.generatePrompt = function(formatOverride = null) {
    const data = getFormData(formatOverride);
    if (!data.topik) {
      showToast('⚠️ Tulis topik dulu ya!');
      goToStep(1);
      return;
    }
    const prompt = buildPrompt(data);
    document.getElementById('prompt-text').value = prompt;
    document.getElementById('prompt-output').classList.remove('hidden');
    showToast('✅ Prompt berhasil dibuat! Copy dan paste ke AI favoritmu.');
  };

  window.copyPrompt = function() {
    const text = document.getElementById('prompt-text').value;
    navigator.clipboard.writeText(text).then(() => showToast('📋 Prompt berhasil di-copy!'));
  };

  // --- Mode 2: Generate with API (SumoPod) ---
  window.generateWithAPI = async function(formatOverride = null) {
    const data = getFormData(formatOverride);
    if (!data.topik) {
      showToast('⚠️ Tulis topik dulu ya!');
      goToStep(1);
      return;
    }

    const provider = document.getElementById('provider').value;
    const apiKey = document.getElementById('apikey').value.trim();

    if (!apiKey) {
      showToast('⚠️ Hubungkan API Key SumoPod di Pengaturan terlebih dahulu!');
      return;
    }

    // Go to output step
    goToStep(4);
    document.getElementById('output-format-badge').textContent = getFormatLabel(data.format);
    document.getElementById('output-loading').classList.remove('hidden');
    document.getElementById('output-content').classList.add('hidden');
    document.getElementById('output-error').classList.add('hidden');

    const prompt = buildPrompt(data);
    const outputEl = document.getElementById('output-text');
    outputEl.textContent = '';

    // Cancel previous request if any
    if (abortController) abortController.abort();
    abortController = new AbortController();

    try {
      await generate({
        provider,
        apiKey,
        prompt,
        signal: abortController.signal,
        onChunk: (chunk) => {
          document.getElementById('output-loading').classList.add('hidden');
          document.getElementById('output-content').classList.remove('hidden');
          outputEl.textContent += chunk;
        },
      });

      document.getElementById('output-loading').classList.add('hidden');
      document.getElementById('output-content').classList.remove('hidden');
      if (!outputEl.textContent) {
        outputEl.textContent = '(Tidak ada output yang dihasilkan. Coba lagi atau ganti provider.)';
      }
    } catch (err) {
      if (err.name === 'AbortError') return;
      document.getElementById('output-loading').classList.add('hidden');
      document.getElementById('output-error').classList.remove('hidden');
      document.getElementById('error-message').textContent = err.message || 'Gagal terhubung ke AI. Cek API key dan koneksi internet.';
    }
  };

  // --- Copy & Download Output ---
  window.copyOutput = function() {
    const text = document.getElementById('output-text').textContent;
    navigator.clipboard.writeText(text).then(() => showToast('📋 Konten berhasil di-copy!'));
  };

  window.downloadOutput = function() {
    const text = document.getElementById('output-text').textContent;
    const data = getFormData();
    const blob = new Blob([text], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `storiq-${data.format}-${Date.now()}.md`;
    a.click();
    URL.revokeObjectURL(url);
    showToast('💾 File berhasil didownload!');
  };

  // --- Toast ---
  function showToast(msg) {
    const toast = document.getElementById('toast');
    toast.textContent = msg;
    toast.classList.remove('translate-y-20', 'opacity-0');
    setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0'), 2500);
  }

  // --- Load SumoPod State on Load ---
  document.addEventListener('DOMContentLoaded', () => {
    const sumopodKey = getApiKey('sumopod');
    const connectedPanel = document.getElementById('sumopod-state-connected');
    const disconnectedPanel = document.getElementById('sumopod-state-disconnected');
    const apiKeyInput = document.getElementById('apikey');

    if (sumopodKey) {
      if (apiKeyInput) apiKeyInput.value = sumopodKey;
      if (connectedPanel) connectedPanel.classList.replace('hidden', 'flex');
      if (disconnectedPanel) disconnectedPanel.classList.replace('flex', 'hidden');
    } else {
      if (apiKeyInput) apiKeyInput.value = '';
      if (connectedPanel) connectedPanel.classList.replace('flex', 'hidden');
      if (disconnectedPanel) disconnectedPanel.classList.replace('hidden', 'flex');
    }
  });
</script>
