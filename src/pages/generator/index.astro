---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<Base title="Pilih Mode Generator — STORIQ" description="Pilih mode generator STORIQ: Prompt Generator (Manual) atau API Key SumoPod (Otomatis).">
  <Header slot="header" />

  <div class="max-w-4xl mx-auto px-4 py-12 sm:py-16">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-indigo-50 text-indigo-700 text-xs font-bold uppercase tracking-wider rounded-full mb-3 border border-indigo-100">
        <span>⚡</span>
        <span>Langkah 1: Tentukan Mode</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
        Pilih Cara Kamu Membuat Konten
      </h1>
      <p class="text-slate-600 text-xs sm:text-sm md:text-base leading-relaxed">
        STORIQ menyediakan dua cara untuk mengubah satu ide menjadi konten berkualitas. Pilih mode yang paling nyaman untuk alur kerjamu.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid md:grid-cols-2 gap-6 sm:gap-8">
      
      <!-- Option 1: Prompt Generator (Manual) -->
      <div class="bg-white border border-slate-200/90 hover:border-indigo-400 rounded-3xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-200 hover:shadow-xl group relative shadow-2xs">
        <div class="absolute -top-3 left-6">
          <span class="bg-amber-500 text-white text-[11px] font-bold px-3 py-0.5 rounded-full uppercase tracking-wider shadow-xs">
            ⭐ Paling Populer • 100% Gratis
          </span>
        </div>

        <div>
          <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center text-2xl mb-5 group-hover:scale-105 transition-transform">
            📋
          </div>
          
          <h2 class="text-xl font-bold text-slate-900 mb-2">
            Prompt Generator (Manual)
          </h2>
          <p class="text-slate-500 text-xs sm:text-sm mb-6 leading-relaxed">
            STORIQ merakit prompt rahasia super terstruktur untuk kamu copy dan paste ke ChatGPT, Gemini, atau Claude.
          </p>

          <div class="space-y-3 pt-4 border-t border-slate-100 mb-8">
            <div class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Tanpa API Key</strong> — langsung pakai tanpa registrasi apapun</span>
            </div>
            <div class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Bebas AI</strong> — gunakan ChatGPT, Claude, atau Gemini favoritmu</span>
            </div>
            <div class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Alur 3 Langkah</strong>: Ide &rarr; Salin Prompt &amp; Paste &rarr; Hasil Visual</span>
            </div>
          </div>
        </div>

        <div>
          <a
            href={`${baseUrl}generator/prompt-generator/`}
            class="w-full py-3.5 bg-slate-900 hover:bg-indigo-600 text-white rounded-xl font-semibold text-center block transition-all shadow-md text-xs sm:text-sm hover:shadow-indigo-500/20"
          >
            Pilih Prompt Generator &rarr;
          </a>
          <p class="text-center text-[11px] text-slate-400 mt-3">Rekomendasi untuk pemula &amp; tanpa biaya</p>
        </div>
      </div>

      <!-- Option 2: API Key SumoPod (Otomatis) -->
      <div class="bg-white border border-slate-200/90 hover:border-indigo-400 rounded-3xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-200 hover:shadow-xl group relative shadow-2xs">
        <div class="absolute -top-3 left-6">
          <span class="bg-indigo-600 text-white text-[11px] font-bold px-3 py-0.5 rounded-full uppercase tracking-wider shadow-xs">
            ⚡ Otomatis • Cepat &amp; Praktis
          </span>
        </div>

        <div>
          <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center text-2xl mb-5 group-hover:scale-105 transition-transform">
            🤖
          </div>

          <h2 class="text-xl font-bold text-slate-900 mb-2">
            API Key SumoPod (Otomatis)
          </h2>
          <p class="text-slate-500 text-xs sm:text-sm mb-6 leading-relaxed">
            Hubungkan API Key SumoPod milikmu (BYOK). Konten langsung di-generate otomatis di dalam STORIQ dengan teknologi AI streaming.
          </p>

          <div class="space-y-3 pt-4 border-t border-slate-100 mb-8">
            <div class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Otomatis 1-Klik</strong> — tidak perlu bolak-balik buka tab ChatGPT</span>
            </div>
            <div class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Aman &amp; Privat</strong> — API key hanya disimpan di browser lokalmu</span>
            </div>
            <div class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Alur Cepat</strong>: Masukkan Ide &rarr; Generate Artikel Langsung &rarr; Hasil Visual</span>
            </div>
          </div>
        </div>

        <div>
          <a
            href={`${baseUrl}generator/api-key-sumopod/`}
            class="w-full py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold text-center block transition-all shadow-md text-xs sm:text-sm hover:shadow-indigo-600/30"
          >
            Pilih API Key SumoPod &rarr;
          </a>
          <p class="text-center text-[11px] text-slate-400 mt-3">
            Belum punya key? <a href={`${baseUrl}panduan/`} class="text-indigo-600 hover:underline">Baca panduan SumoPod</a>
          </p>
        </div>
      </div>

    </div>

    <!-- Help Notice -->
    <div class="mt-12 text-center">
      <p class="text-sm text-slate-500">
        Bingung mau pilih yang mana? Kamu bisa mulai dengan <a href={`${baseUrl}generator/prompt-generator/`} class="text-indigo-600 font-medium hover:underline">Prompt Generator</a> terlebih dahulu.
      </p>
    </div>
  </div>

  <Footer slot="footer" />
</Base>
