---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { FRAMEWORKS } from '../../scripts/prompts.js';

const baseUrl = import.meta.env.BASE_URL;
---

<Base title="Prompt Generator — STORIQ" description="Buat prompt storytelling terstruktur untuk ChatGPT, Claude, dan Gemini secara gratis.">
  <Header slot="header" />

  <!-- Top bar with Mode Badge & Switch Link -->
  <div class="bg-white border-b border-slate-200/80 py-2.5 px-4 text-xs">
    <div class="max-w-3xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2 text-slate-700">
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        <span class="font-bold text-slate-900">Mode: Prompt Generator (Manual)</span>
      </div>
      <a href={`${baseUrl}generator/`} class="text-indigo-600 hover:text-indigo-700 font-semibold transition-colors flex items-center gap-1">
        ← Ganti Mode
      </a>
    </div>
  </div>

  <!-- Step Indicator -->
  <div class="bg-slate-50/90 border-b border-slate-200/80 py-4 px-4">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center justify-between text-xs sm:text-sm" id="step-indicators">
        <button data-step="1" class="step-dot active flex flex-col items-center gap-1">
          <span class="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold">1</span>
          <span class="hidden sm:block">Ide</span>
        </button>
        <div class="flex-1 h-0.5 bg-slate-200 text-slate-500 mx-2 sm:mx-4"></div>
        <button data-step="2" class="step-dot flex flex-col items-center gap-1">
          <span class="w-8 h-8 rounded-full bg-slate-200 text-slate-500 flex items-center justify-center font-bold">2</span>
          <span class="hidden sm:block">Prompt</span>
        </button>
        <div class="flex-1 h-0.5 bg-slate-200 text-slate-500 mx-2 sm:mx-4"></div>
        <button data-step="3" class="step-dot flex flex-col items-center gap-1">
          <span class="w-8 h-8 rounded-full bg-slate-200 text-slate-500 flex items-center justify-center font-bold">3</span>
          <span class="hidden sm:block">Visual</span>
        </button>
      </div>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-8">

    <!-- STEP 1: Input Ide -->
    <section id="step-1" class="step-panel">
      <h2 class="text-2xl font-bold text-slate-800 mb-1">💡 Masukkan Ide Kontenmu</h2>
      <p class="text-slate-500 mb-6">Ceritakan apa yang ingin kamu sampaikan. Tidak perlu sempurna — tulis apa adanya.</p>

      <div class="space-y-5">
        <div>
          <label for="topik" class="block text-sm font-medium text-slate-700 mb-1">Topik / Ide Utama</label>
          <textarea id="topik" rows="3" placeholder="Contoh: Kenapa landing page yang bagus belum tentu menghasilkan konversi?" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none resize-none text-slate-800"></textarea>
        </div>

        <div>
          <label for="audiens" class="block text-sm font-medium text-slate-700 mb-1">Target Audiens</label>
          <input id="audiens" type="text" placeholder="Contoh: Pemilik bisnis online, marketer pemula" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none text-slate-800" />
        </div>

        <div>
          <label for="tujuan" class="block text-sm font-medium text-slate-700 mb-1">Tujuan Konten</label>
          <input id="tujuan" type="text" placeholder="Contoh: Edukasi + personal branding" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none text-slate-800" />
        </div>

        <div>
          <label for="tone" class="block text-sm font-medium text-slate-700 mb-1">Tone / Gaya Bahasa</label>
          <select id="tone" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none bg-white text-slate-800">
            <option value="santai">🗣️ Santai & Friendly</option>
            <option value="profesional">💼 Profesional</option>
            <option value="edukatif">📚 Edukatif & Informatif</option>
            <option value="inspiratif">✨ Inspiratif & Motivasi</option>
            <option value="storytelling">📖 Storytelling (bercerita)</option>
          </select>
        </div>

        <!-- Framework Selection Merged into Step 1 -->
        <div class="mt-8 border-t border-slate-200 pt-8">
          <h3 class="text-lg font-semibold text-slate-700 mb-1">Pilih Framework Storytelling</h3>
          <p class="text-slate-500 mb-6 text-sm">Framework menentukan alur dan struktur psikologi ceritamu.</p>
          <div class="grid gap-3 mb-8" id="framework-options">
            {FRAMEWORKS.map((fw, index) => (
              <label class={`framework-option border-2 rounded-lg p-4 cursor-pointer hover:border-slate-300 ${index === 0 ? 'border-indigo-600 bg-indigo-50/60' : 'border-slate-200'}`}>
                <input type="radio" name="framework" value={fw.id} checked={index === 0} class="sr-only" />
                <div class="flex items-start gap-3">
                  <span class={`w-5 h-5 mt-0.5 rounded-full border-2 flex items-center justify-center flex-shrink-0 ${index === 0 ? 'border-indigo-600' : 'border-slate-300'}`}>
                    {index === 0 && <span class="w-2.5 h-2.5 rounded-full bg-indigo-600 text-white"></span>}
                  </span>
                  <div>
                    <p class="font-semibold text-slate-800">
                      {fw.label} 
                      {index === 0 && <span class="text-xs text-indigo-600 bg-blue-100 px-2 py-0.5 rounded-full ml-1">Recommended</span>}
                    </p>
                    <p class="text-sm text-slate-500 mt-0.5">{fw.desc}</p>
                  </div>
                </div>
              </label>
            ))}
          </div>
        </div>
      </div>

      <div class="mt-8 flex justify-end">
        <button id="btn-next-step-1" onclick="goToStep(2)" disabled class="px-6 py-3 bg-slate-200 text-slate-400 cursor-not-allowed rounded-lg font-medium transition-all">
          Lanjut: Salin Prompt →
        </button>
      </div>
    </section>

    <!-- STEP 2: Salin Prompt -->
    <section id="step-2" class="step-panel hidden">
      <h2 class="text-2xl font-bold text-slate-800 mb-1">📋 Salin Prompt AI</h2>
      <p class="text-slate-500 mb-6">STORIQ telah merakit prompt terstruktur untuk idemu. Salin dan tempel ke AI favoritmu.</p>

      <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6">
        <p class="text-sm text-amber-800">
          <strong>Cara kerja:</strong> Copy prompt di bawah → paste ke ChatGPT, Gemini, atau Claude → copy hasil teks dari AI → kembali ke sini dan klik <strong>Lanjut</strong>.
        </p>
      </div>

      <!-- Generated Prompt Display -->
      <div id="prompt-output" class="animate-fade-in">
        <div class="mb-2">
          <label class="block text-sm font-semibold text-slate-700">Hasil Prompt (Siap Copy-Paste):</label>
        </div>
        <textarea id="prompt-text" rows="12" readonly class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-700 font-mono resize-none"></textarea>
        
        <button onclick="copyPrompt()" class="mt-4 w-full py-4 bg-slate-800 hover:bg-slate-900 text-white rounded-xl font-bold text-lg transition-colors flex items-center justify-center gap-2 shadow-md">
          📋 COPY PROMPT
        </button>

        <div class="mt-6 mb-8">
          <p class="text-sm font-semibold text-slate-700 mb-3 text-center">Paste prompt ke salah satu AI favoritmu:</p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <a href="https://chat.openai.com" target="_blank" class="flex items-center justify-center gap-2 px-4 py-3 bg-white hover:bg-slate-50 border border-slate-200 hover:border-emerald-500 rounded-xl text-sm font-bold text-slate-700 transition-all shadow-sm hover:shadow-md">
              <svg class="w-5 h-5 text-emerald-600" viewBox="0 0 24 24" fill="currentColor">
                <path d="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.073Zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944ZM2.5797 15.1152a4.4944 4.4944 0 0 1-.288-3.039l.142.0804 4.7783 2.7582a.7948.7948 0 0 0 .7855 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 17.516a4.4992 4.4992 0 0 1-7.1603-2.4008ZM5.4578 4.786a4.4944 4.4944 0 0 1 2.5884-1.579l-.0474.1564-2.3892 4.14-2.3891 4.14a.79.79 0 0 0-.0047.79v6.7369l-2.02-1.1686a.071.071 0 0 1-.038-.052v-5.5826a4.4992 4.4992 0 0 1 4.3-7.581ZM21.4203 8.8848a4.4944 4.4944 0 0 1 .288 3.039l-.142-.0804-4.7783-2.7582a.7948.7948 0 0 0-.7855 0l-5.8428 3.3685V10.121a.0804.0804 0 0 1 .0332-.0615l4.0669-2.3456a4.4992 4.4992 0 0 1 7.1603 2.4008v-.2295ZM18.5422 19.214a4.4944 4.4944 0 0 1-2.5884 1.579l.0474-.1564 2.3892-4.14 2.3891-4.14a.79.79 0 0 0 .0047-.79V4.8302l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.4992 4.4992 0 0 1-4.3 7.581ZM8.74 15.225l-2.02-1.1686V8.4738a.071.071 0 0 1 .038-.052l4.0669-2.3456a.071.071 0 0 1 .071 0l2.02 1.1686v5.5826a.071.071 0 0 1-.038.052L8.811 15.225a.071.071 0 0 1-.071 0Z"></path>
              </svg>
              ChatGPT
            </a>
            <a href="https://gemini.google.com" target="_blank" class="flex items-center justify-center gap-2 px-4 py-3 bg-white hover:bg-slate-50 border border-slate-200 hover:border-indigo-400 rounded-xl text-sm font-bold text-slate-700 transition-all shadow-sm hover:shadow-md">
              <svg class="w-5 h-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
              </svg>
              Gemini
            </a>
            <a href="https://claude.ai" target="_blank" class="flex items-center justify-center gap-2 px-4 py-3 bg-white hover:bg-slate-50 border border-slate-200 hover:border-amber-500 rounded-xl text-sm font-bold text-slate-700 transition-all shadow-sm hover:shadow-md">
              <svg class="w-5 h-5 text-amber-700" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C12 7.52 16.48 12 22 12C16.48 12 12 16.48 12 22C12 16.48 7.52 12 2 12C7.52 12 12 7.52 12 2Z" />
              </svg>
              Claude
            </a>
          </div>
          
          <div class="mt-5 text-center px-4 py-3 bg-amber-50 border border-amber-200 rounded-lg animate-pulse-once">
            <p class="text-sm text-amber-800 font-medium">
              ⚠️ Jangan lupa copy hasil dari AI kalian lalu paste kan ke form dibawah ini !
            </p>
          </div>

          <!-- Paste AI Content directly in Step 2 -->
          <div class="mt-6 pt-6 border-t border-slate-200">
            <label for="pasted-content" class="block text-sm font-semibold text-slate-700 mb-1">
              📥 Paste Hasil Konten dari AI di Sini:
            </label>
            <p class="text-xs text-slate-500 mb-3">
              Setelah mendapatkan tulisan dari ChatGPT / Claude / Gemini, tempelkan hasilnya di sini untuk lanjut membuat konten visual.
            </p>
            <textarea id="pasted-content" rows="8" placeholder="Paste konten dari AI di sini..." class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none text-slate-800 font-mono text-sm resize-none bg-white"></textarea>

            <div class="mt-3 flex items-start gap-2.5 text-xs text-slate-600 bg-indigo-50/60/80 border border-indigo-200 rounded-xl p-3.5">
              <span class="text-base leading-none shrink-0">💡</span>
              <p class="leading-relaxed">
                <strong>Catatan:</strong> Hasil artikel yang kamu dapatkan dari AI ini bisa langsung kamu gunakan untuk konten artikel di <strong>WordPress</strong>, <strong>Blogger</strong>, <strong>Medium</strong>, maupun <strong>Substack</strong>!
              </p>
            </div>

            <!-- Fitur Karakter Tanpa Wajah (Faceless) -->
            <div class="mt-3 p-4 bg-white border border-slate-200 hover:border-indigo-300 rounded-xl transition-all shadow-2xs">
              <label class="flex items-start gap-3.5 cursor-pointer select-none">
                <div class="flex items-center h-5 mt-0.5">
                  <input
                    type="checkbox"
                    id="toggle-faceless-step2"
                    class="w-5 h-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-0 cursor-pointer transition-all"
                  />
                </div>
                <div class="flex-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-sm font-bold text-slate-800 flex items-center gap-1.5">
                      👤 Karakter Tanpa Wajah (Faceless Illustration)
                    </span>
                    <span class="text-[11px] font-semibold px-2.5 py-0.5 bg-amber-50 text-amber-700 rounded-full border border-amber-200">
                      Tanpa Alis, Mata, Hidung & Mulut
                    </span>
                  </div>
                  <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
                    Centang untuk <strong>menghilangkan alis, mata, hidung, dan mulut</strong> saat generate gambar berkarakter manusia (gaya ilustrasi 3D clay / flat vector tanpa fitur wajah — sangat cocok untuk infografis edukatif, modern, dan syar'i).
                  </p>
                </div>
              </label>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-8 flex justify-between items-center">
        <button onclick="goToStep(1)" class="px-6 py-3 border border-slate-300 text-slate-600 rounded-lg font-medium hover:bg-slate-50 transition-colors">
          ← Kembali
        </button>
        <button id="btn-next-step-2" onclick="processPastedContent()" disabled class="px-6 py-3 bg-slate-200 text-slate-400 cursor-not-allowed rounded-lg font-medium transition-all">
          Lanjut ke Hasil Visual →
        </button>
      </div>
    </section>

    <!-- STEP 3: Hasil & Visual -->
    <section id="step-3" class="step-panel hidden">
      <div class="flex items-center justify-between mb-1">
        <h2 class="text-2xl font-bold text-slate-800">✨ Hasil & Repurpose Visual</h2>
      </div>
      <p class="text-slate-500 mb-6">Gunakan prompt di bawah ini untuk mengubah kontenmu menjadi format desain visual.</p>

      <div class="bg-indigo-50/60 border border-indigo-200 rounded-lg p-4 mb-5">
        <h4 class="font-bold text-indigo-900 text-sm mb-1">🎨 Repurpose ke Visual</h4>
        <p class="text-xs text-indigo-700">Pecah artikel/konten di atas menjadi format visual. Copy prompt di bawah ini dan paste ke chat AI yang sama untuk mendapatkan ide desainnya.</p>
      </div>

      <!-- Status & Toggle Mode Faceless di Step 3 -->
      <div class="bg-white border border-slate-200 rounded-xl p-3.5 sm:p-4 mb-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-2xs">
        <label class="flex items-center gap-3 cursor-pointer select-none">
          <input
            type="checkbox"
            id="toggle-faceless-step3"
            class="w-5 h-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-0 cursor-pointer"
          />
          <div>
            <span class="text-xs sm:text-sm font-bold text-slate-800 flex items-center gap-1.5">
              👤 Mode Karakter Tanpa Wajah (Faceless)
            </span>
            <span class="text-[11px] text-slate-500 block sm:inline">
              Otomatis hilangkan alis, mata, hidung, & mulut pada prompt visual
            </span>
          </div>
        </label>
        <span id="faceless-badge-step3" class="text-xs px-2.5 py-1 rounded-full font-semibold bg-slate-100 text-slate-600 self-start sm:self-center">
          Standar (Wajah Utuh)
        </span>
      </div>
      
      <div class="space-y-4 mb-6">
        <!-- Single Image -->
        <div class="border border-slate-200 rounded-lg p-4 bg-white">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-sm text-slate-800">🖼️ Single Image</span>
            <button onclick="copyVisualPrompt('single')" class="text-xs px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-md font-medium transition-colors">Copy Prompt</button>
          </div>
          <p id="prompt-single" class="text-xs text-slate-500 font-mono bg-slate-50 p-2.5 rounded leading-relaxed">Berdasarkan konten di atas:
1. Rangkum 1 pesan inti & teks copy singkat untuk di dalam gambar.
2. LANGSUNG GENERATE GAMBAR SEKARANG: Buatkan dan tampilkan langsung gambar ilustrasinya (gunakan fitur image generation / DALL-E / Imagen bawaanmu) yang memvisualisasikan konsep tersebut, rasio 1:1 (square), gaya modern, clean, dan relatable.
3. Sertakan juga prompt Bahasa Inggris siap pakai untuk Midjourney / Flux / Ideogram.</p>
        </div>

        <!-- Carousel -->
        <div class="border border-slate-200 rounded-lg p-4 bg-white">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-sm text-slate-800">📱 Carousel</span>
            <button onclick="copyVisualPrompt('carousel')" class="text-xs px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-md font-medium transition-colors">Copy Prompt</button>
          </div>
          <p id="prompt-carousel" class="text-xs text-slate-500 font-mono bg-slate-50 p-2.5 rounded leading-relaxed">Berdasarkan konten di atas:
1. Susun alur 5 slide Carousel (Headline max 10 kata + Body max 2 kalimat untuk tiap slide).
2. LANGSUNG GENERATE GAMBAR COVER SEKARANG: Buatkan dan tampilkan langsung gambar desain visual untuk SLIDE 1 (Cover / Hook) yang paling eye-catching (gunakan fitur image generation / DALL-E / Imagen bawaanmu), rasio 1:1 atau 4:5 portrait, gaya clean & modern.
3. Sertakan prompt Bahasa Inggris untuk slide berikutnya jika ingin di-generate satu per satu.</p>
        </div>

        <!-- Infografis -->
        <div class="border border-slate-200 rounded-lg p-4 bg-white">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-sm text-slate-800">📊 Infografis</span>
            <button onclick="copyVisualPrompt('infografis')" class="text-xs px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-md font-medium transition-colors">Copy Prompt</button>
          </div>
          <p id="prompt-infografis" class="text-xs text-slate-500 font-mono bg-slate-50 p-2.5 rounded leading-relaxed">Berdasarkan konten di atas:
1. Rangkum poin-poin utama, data, atau langkah-langkah secara terstruktur dan ringkas.
2. LANGSUNG GENERATE GAMBAR SEKARANG: Buatkan dan render langsung visual desain poster INFOGRAFIS lengkap (format vertikal 9:16 atau 4:5, gaya clean, modern, informatif dengan ikon/elemen visual pendukung) menggunakan fitur image generation / DALL-E / Imagen bawaanmu.
3. Sertakan juga prompt Bahasa Inggris siap pakai untuk Midjourney / Flux / Ideogram.</p>
        </div>

        <!-- Threads -->
        <div class="border border-slate-200 rounded-lg p-4 bg-white">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-sm text-slate-800">🧵 Threads</span>
            <button onclick="copyVisualPrompt('threads')" class="text-xs px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-md font-medium transition-colors">Copy Prompt</button>
          </div>
          <p id="prompt-threads" class="text-xs text-slate-500 font-mono bg-slate-50 p-2.5 rounded leading-relaxed">Berdasarkan konten di atas:
1. Rangkum dan ubah menjadi serial postingan Threads / Twitter (3-5 post ringkas, punchy, dan padat insight).
2. Buat Hook memikat di post pertama, 2-3 post inti daging (maksimal 2-3 kalimat per post agar nyaman dibaca cepat), dan 1 post penutup yang mengundang diskusi/komentar.
3. Fokus murni pada kekuatan tulisan / copywriting saja (tidak perlu generate gambar).</p>
        </div>

        <!-- YouTube Video Script -->
        <div class="border border-slate-200 rounded-lg p-4 bg-white">
          <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-sm text-slate-800">▶️ YouTube Video Script</span>
            <button onclick="copyVisualPrompt('youtube')" class="text-xs px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-md font-medium transition-colors">Copy Prompt</button>
          </div>
          <p id="prompt-youtube" class="text-xs text-slate-500 font-mono bg-slate-50 p-2.5 rounded leading-relaxed">Berdasarkan konten di atas:
1. Susun Video Script YouTube lengkap (durasi 5-8 menit, gaya storytelling edukatif dan engaging).
2. Buat struktur naskah:
   - [0:00-0:30] Hook 15-30 detik pertama (visual pattern interrupt + kalimat pemantik rasa ingin tahu).
   - [0:30-1:30] Intro & Masalah Utama (Validasi rasa frustrasi penonton).
   - [1:30-6:00] 3-4 Poin Daging / Solusi (Lengkap dengan instruksi Visual/B-roll dan Voiceover/Audio).
   - [6:00-7:00] Ringkasan & Actionable Takeaway.
   - [7:00-selesai] CTA (Subscribe, like, dan ajakan cek link di deskripsi).
3. Berikan juga 3 opsi Judul Video High-CTR serta deskripsi video siap pakai (termasuk 3 hashtag utama).</p>
        </div>
      </div>

      <!-- Instruksi Chat yang Sama & Tombol AI -->
      <div class="mt-6 mb-8 pt-6 border-t border-slate-200">
        <div class="px-4 py-3.5 bg-amber-50 border border-amber-200 rounded-xl mb-4 text-center">
          <p class="text-xs sm:text-sm text-amber-800 font-medium leading-relaxed">
            ⚠️ <strong>Perhatian:</strong> Paste-kan prompt visual ini di <strong>bawah hasil generate artikel kalian sebelumnya (dalam chat/obrolan yang sama)</strong>, bukan di chat atau obrolan baru!
          </p>
        </div>

        <p class="text-sm font-semibold text-slate-700 mb-3 text-center">Buka kembali AI kalian untuk menerapkan prompt:</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="https://chat.openai.com" target="_blank" class="flex items-center justify-center gap-2 px-4 py-3 bg-white hover:bg-slate-50 border border-slate-200 hover:border-emerald-500 rounded-xl text-sm font-bold text-slate-700 transition-all shadow-xs hover:shadow-md">
            <svg class="w-5 h-5 text-emerald-600" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.073Zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944ZM2.5797 15.1152a4.4944 4.4944 0 0 1-.288-3.039l.142.0804 4.7783 2.7582a.7948.7948 0 0 0 .7855 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 17.516a4.4992 4.4992 0 0 1-7.1603-2.4008ZM5.4578 4.786a4.4944 4.4944 0 0 1 2.5884-1.579l-.0474.1564-2.3892 4.14-2.3891 4.14a.79.79 0 0 0-.0047.79v6.7369l-2.02-1.1686a.071.071 0 0 1-.038-.052v-5.5826a4.4992 4.4992 0 0 1 4.3-7.581ZM21.4203 8.8848a4.4944 4.4944 0 0 1 .288 3.039l-.142-.0804-4.7783-2.7582a.7948.7948 0 0 0-.7855 0l-5.8428 3.3685V10.121a.0804.0804 0 0 1 .0332-.0615l4.0669-2.3456a4.4992 4.4992 0 0 1 7.1603 2.4008v-.2295ZM18.5422 19.214a4.4944 4.4944 0 0 1-2.5884 1.579l.0474-.1564 2.3892-4.14 2.3891-4.14a.79.79 0 0 0 .0047-.79V4.8302l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.4992 4.4992 0 0 1-4.3 7.581ZM8.74 15.225l-2.02-1.1686V8.4738a.071.071 0 0 1 .038-.052l4.0669-2.3456a.071.071 0 0 1 .071 0l2.02 1.1686v5.5826a.071.071 0 0 1-.038.052L8.811 15.225a.071.071 0 0 1-.071 0Z"></path>
            </svg>
            ChatGPT
          </a>
          <a href="https://gemini.google.com" target="_blank" class="flex items-center justify-center gap-2 px-4 py-3 bg-white hover:bg-slate-50 border border-slate-200 hover:border-indigo-400 rounded-xl text-sm font-bold text-slate-700 transition-all shadow-xs hover:shadow-md">
            <svg class="w-5 h-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Gemini
          </a>
          <a href="https://claude.ai" target="_blank" class="flex items-center justify-center gap-2 px-4 py-3 bg-white hover:bg-slate-50 border border-slate-200 hover:border-amber-500 rounded-xl text-sm font-bold text-slate-700 transition-all shadow-xs hover:shadow-md">
            <svg class="w-5 h-5 text-amber-700" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C12 7.52 16.48 12 22 12C16.48 12 12 16.48 12 22C12 16.48 7.52 12 2 12C7.52 12 12 7.52 12 2Z" />
            </svg>
            Claude
          </a>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-3">
        <button onclick="goToStep(2)" class="py-3 px-6 border border-slate-300 text-slate-700 rounded-lg font-medium hover:bg-slate-50 transition-colors text-sm text-center">
          ← Kembali ke Prompt
        </button>
        <button onclick="goToStep(1)" class="flex-1 py-3 border border-slate-300 text-slate-600 rounded-lg font-medium hover:bg-slate-50 transition-colors text-sm text-center">
          ✏️ Buat Ide Baru (Mulai dari Awal)
        </button>
        <a href={`${baseUrl}generator/`} class="py-3 px-6 border border-slate-200 text-slate-500 hover:text-slate-800 rounded-lg font-medium hover:bg-slate-50 transition-colors text-sm text-center">
          Ganti Mode Generator
        </a>
      </div>
    </section>

  </div>

  <!-- Toast Notification -->
  <div id="toast" class="fixed bottom-4 right-4 bg-slate-800 text-white px-4 py-2.5 rounded-lg text-sm shadow-lg transform translate-y-20 opacity-0 transition-all duration-300 z-50"></div>

  <Footer slot="footer" />
</Base>

<style>
  .step-dot.active span:first-child { background-color: #3b82f6; }
  .step-dot.completed span:first-child { background-color: #22c55e; }
</style>

<script>
  import { buildPrompt } from '../../scripts/prompts.js';

  // --- State ---
  let currentStep = 1;

  // --- Step Navigation ---
  window.goToStep = function(step) {
    // Validate step 1 before moving forward
    if (step > 1 && currentStep === 1) {
      const topik = document.getElementById('topik').value.trim();
      if (!topik) {
        showToast('⚠️ Tulis topik dulu ya!');
        document.getElementById('topik').focus();
        return;
      }
    }

    document.querySelectorAll('.step-panel').forEach(p => p.classList.add('hidden'));
    document.getElementById(`step-${step}`)?.classList.remove('hidden');

    // Auto-generate prompt when entering Step 2
    if (step === 2) {
      generatePrompt(null, true);
    }

    // Update indicators
    document.querySelectorAll('.step-dot').forEach(dot => {
      const s = parseInt(dot.dataset.step);
      const circle = dot.querySelector('span:first-child');
      dot.classList.remove('active', 'completed');
      if (s < step) {
        dot.classList.add('completed');
        circle.style.backgroundColor = '#22c55e';
      } else if (s === step) {
        dot.classList.add('active');
        circle.style.backgroundColor = '#3b82f6';
      } else {
        circle.style.backgroundColor = '';
      }
    });

    currentStep = step;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // --- Framework Selection UI ---
  document.getElementById('framework-options')?.addEventListener('change', (e) => {
    document.querySelectorAll('.framework-option').forEach(opt => {
      opt.classList.remove('border-indigo-600', 'bg-indigo-50/60');
      opt.classList.add('border-slate-200');
      const dot = opt.querySelector('.w-2\\.5');
      if (dot) dot.remove();
    });
    const label = e.target.closest('label');
    if (label) {
      label.classList.remove('border-slate-200');
      label.classList.add('border-indigo-600', 'bg-indigo-50/60');
      const circle = label.querySelector('.w-5');
      if (circle && !circle.querySelector('.w-2\\.5')) {
        const inner = document.createElement('span');
        inner.className = 'w-2.5 h-2.5 rounded-full bg-indigo-600 text-white';
        circle.appendChild(inner);
      }
    }
  });

  // --- Gather Form Data ---
  function getFormData(formatOverride = null) {
    return {
      topik: document.getElementById('topik').value.trim(),
      audiens: document.getElementById('audiens').value.trim() || 'Umum',
      tujuan: document.getElementById('tujuan').value.trim() || 'Edukasi',
      tone: document.getElementById('tone').value,
      framework: document.querySelector('input[name="framework"]:checked')?.value || 'storiq10',
      format: formatOverride || 'blog',
    };
  }

  // --- Generate Prompt ---
  window.generatePrompt = function(formatOverride = null, silent = false) {
    const data = getFormData(formatOverride);
    if (!data.topik) {
      if (!silent) showToast('⚠️ Tulis topik dulu ya!');
      goToStep(1);
      return;
    }
    const prompt = buildPrompt(data);
    document.getElementById('prompt-text').value = prompt;
    if (!silent) showToast('✨ Prompt berhasil dibuat! Copy dan paste ke AI favoritmu.');
  };

  window.copyPrompt = function() {
    const text = document.getElementById('prompt-text').value;
    navigator.clipboard.writeText(text).then(() => showToast('📋 Prompt berhasil di-copy!'));
  };

  // --- Proses Paste Content ---
  window.processPastedContent = function() {
    const pasted = document.getElementById('pasted-content').value.trim();
    if (!pasted) {
      showToast('⚠️ Paste dulu konten dari AI kalian ya!');
      return;
    }
    // Go to step 3 (Hasil & Visual)
    goToStep(3);
  };

  // --- Faceless Mode & Visual Prompts ---
  const visualPromptTemplates = {
    single: {
      normal: `Berdasarkan konten di atas:
1. Rangkum 1 pesan inti & teks copy singkat untuk di dalam gambar.
2. LANGSUNG GENERATE GAMBAR SEKARANG: Buatkan dan tampilkan langsung gambar ilustrasinya (gunakan fitur image generation / DALL-E / Imagen bawaanmu) yang memvisualisasikan konsep tersebut, rasio 1:1 (square), gaya modern, clean, dan relatable.
3. Sertakan juga prompt Bahasa Inggris siap pakai untuk Midjourney / Flux / Ideogram.`,
      faceless: `Berdasarkan konten di atas:
1. Rangkum 1 pesan inti & teks copy singkat untuk di dalam gambar.
2. LANGSUNG GENERATE GAMBAR SEKARANG: Buatkan dan tampilkan langsung gambar ilustrasinya (gunakan fitur image generation / DALL-E / Imagen bawaanmu) yang memvisualisasikan konsep tersebut, rasio 1:1 (square), gaya modern, clean, dan relatable.
* PENTING (ATURAN WAJAH): Jika terdapat karakter / figur manusia dalam gambar, WAJIB dibuat TANPA fitur wajah (FACELESS: hilangkan alis, mata, hidung, dan mulut — permukaan wajah polos mulus / blank smooth face, hanya rambut, telinga, pakaian, dan gestur tubuh yang tampak, gaya 3D clay / clean vector seperti poster infografis edukatif).
3. Sertakan juga prompt Bahasa Inggris siap pakai untuk Midjourney / Flux / Ideogram (tambahkan deskripsi: "faceless minimalist character, blank smooth face, no facial features, no eyes, no eyebrows, no nose, no mouth, modern 3D clay illustration, clean aesthetic").`
    },
    carousel: {
      normal: `Berdasarkan konten di atas:
1. Susun alur 5 slide Carousel (Headline max 10 kata + Body max 2 kalimat untuk tiap slide).
2. LANGSUNG GENERATE GAMBAR COVER SEKARANG: Buatkan dan tampilkan langsung gambar desain visual untuk SLIDE 1 (Cover / Hook) yang paling eye-catching (gunakan fitur image generation / DALL-E / Imagen bawaanmu), rasio 1:1 atau 4:5 portrait, gaya clean & modern.
3. Sertakan prompt Bahasa Inggris untuk slide berikutnya jika ingin di-generate satu per satu.`,
      faceless: `Berdasarkan konten di atas:
1. Susun alur 5 slide Carousel (Headline max 10 kata + Body max 2 kalimat untuk tiap slide).
2. LANGSUNG GENERATE GAMBAR COVER SEKARANG: Buatkan dan tampilkan langsung gambar desain visual untuk SLIDE 1 (Cover / Hook) yang paling eye-catching (gunakan fitur image generation / DALL-E / Imagen bawaanmu), rasio 1:1 atau 4:5 portrait, gaya clean & modern.
* PENTING (ATURAN WAJAH): Jika ada ilustrasi karakter manusia pada cover/slide, WAJIB dibuat TANPA fitur wajah (FACELESS: hilangkan alis, mata, hidung, dan mulut — wajah polos mulus / blank smooth face, gaya 3D infografis modern).
3. Sertakan prompt Bahasa Inggris untuk slide berikutnya jika ingin di-generate satu per satu (sertakan: "faceless character, blank smooth face, no eyes, no eyebrows, no nose, no mouth, 3D clay style").`
    },
    infografis: {
      normal: `Berdasarkan konten di atas:
1. Rangkum poin-poin utama, data, atau langkah-langkah secara terstruktur dan ringkas.
2. LANGSUNG GENERATE GAMBAR SEKARANG: Buatkan dan render langsung visual desain poster INFOGRAFIS lengkap (format vertikal 9:16 atau 4:5, gaya clean, modern, informatif dengan ikon/elemen visual pendukung) menggunakan fitur image generation / DALL-E / Imagen bawaanmu.
3. Sertakan juga prompt Bahasa Inggris siap pakai untuk Midjourney / Flux / Ideogram.`,
      faceless: `Berdasarkan konten di atas:
1. Rangkum poin-poin utama, data, atau langkah-langkah secara terstruktur dan ringkas.
2. LANGSUNG GENERATE GAMBAR SEKARANG: Buatkan dan render langsung visual desain poster INFOGRAFIS lengkap (format vertikal 9:16 atau 4:5, gaya clean, modern, informatif dengan ikon/elemen visual pendukung) menggunakan fitur image generation / DALL-E / Imagen bawaanmu.
* PENTING (ATURAN WAJAH): Jika terdapat karakter / figur manusia pada poster infografis, WAJIB dibuat TANPA fitur wajah (FACELESS: hilangkan alis, mata, hidung, dan mulut — permukaan wajah polos mulus / blank smooth face, hanya rambut dan gestur tubuh, gaya 3D infografis edukatif).
3. Sertakan juga prompt Bahasa Inggris siap pakai untuk Midjourney / Flux / Ideogram (sertakan: "faceless 3D character, blank smooth face, no facial features, no eyes, no nose, no mouth, no eyebrows, educational infographic poster design").`
    }
  };

  let isFacelessActive = false;

  function updateFacelessMode(active, notify = true) {
    isFacelessActive = active;
    const chkStep2 = document.getElementById('toggle-faceless-step2');
    const chkStep3 = document.getElementById('toggle-faceless-step3');
    const badgeStep3 = document.getElementById('faceless-badge-step3');

    if (chkStep2) chkStep2.checked = active;
    if (chkStep3) chkStep3.checked = active;

    if (badgeStep3) {
      if (active) {
        badgeStep3.textContent = '✓ Tanpa Wajah Aktif';
        badgeStep3.className = 'text-xs px-2.5 py-1 rounded-full font-semibold bg-amber-100 text-amber-800 border border-amber-300 shrink-0';
      } else {
        badgeStep3.textContent = 'Standar (Wajah Utuh)';
        badgeStep3.className = 'text-xs px-2.5 py-1 rounded-full font-semibold bg-slate-100 text-slate-600 shrink-0';
      }
    }

    const mode = active ? 'faceless' : 'normal';
    ['single', 'carousel', 'infografis'].forEach(type => {
      const el = document.getElementById(`prompt-${type}`);
      if (el && visualPromptTemplates[type]) {
        el.innerText = visualPromptTemplates[type][mode];
      }
    });

    if (notify) {
      showToast(active 
        ? '👤 Mode Faceless diaktifkan: Alis, mata, hidung & mulut ditiadakan' 
        : '👤 Mode visual standar diaktifkan'
      );
    }
  }

  document.getElementById('toggle-faceless-step2')?.addEventListener('change', (e) => {
    updateFacelessMode(e.target.checked);
  });
  document.getElementById('toggle-faceless-step3')?.addEventListener('change', (e) => {
    updateFacelessMode(e.target.checked);
  });

  // --- Copy Visual Prompt ---
  window.copyVisualPrompt = function(type) {
    const text = document.getElementById(`prompt-${type}`).innerText;
    navigator.clipboard.writeText(text).then(() => showToast('📋 Prompt visual berhasil di-copy!'));
  };

  // --- Toast ---
  function showToast(msg) {
    const toast = document.getElementById('toast');
    toast.textContent = msg;
    toast.classList.remove('translate-y-20', 'opacity-0');
    setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0'), 2500);
  }

  // --- Real-time Form Validation (Disable Button until Filled) ---
  function checkStep1Validation() {
    const topik = document.getElementById('topik')?.value.trim();
    const audiens = document.getElementById('audiens')?.value.trim();
    const tujuan = document.getElementById('tujuan')?.value.trim();
    const btn = document.getElementById('btn-next-step-1');
    
    const isValid = !!(topik && audiens && tujuan);
    if (btn) {
      btn.disabled = !isValid;
      if (isValid) {
        btn.className = 'px-6 py-3 bg-indigo-600 text-white hover:bg-indigo-600 text-white rounded-lg font-medium transition-all shadow-md hover:shadow-indigo-600/20 cursor-pointer';
      } else {
        btn.className = 'px-6 py-3 bg-slate-200 text-slate-400 cursor-not-allowed rounded-lg font-medium transition-all';
      }
    }
  }

  function checkStep2Validation() {
    const pasted = document.getElementById('pasted-content')?.value.trim();
    const btn = document.getElementById('btn-next-step-2');
    const isValid = !!pasted;
    if (btn) {
      btn.disabled = !isValid;
      if (isValid) {
        btn.className = 'px-6 py-3 bg-indigo-600 text-white hover:bg-indigo-600 text-white rounded-lg font-medium transition-all shadow-md hover:shadow-indigo-600/20 cursor-pointer';
      } else {
        btn.className = 'px-6 py-3 bg-slate-200 text-slate-400 cursor-not-allowed rounded-lg font-medium transition-all';
      }
    }
  }

  ['topik', 'audiens', 'tujuan'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', checkStep1Validation);
  });
  document.getElementById('pasted-content')?.addEventListener('input', checkStep2Validation);

  // Check on load
  document.addEventListener('DOMContentLoaded', () => {
    checkStep1Validation();
    checkStep2Validation();
  });
</script>
