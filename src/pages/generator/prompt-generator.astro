<style>
  .step-dot.active span:first-child { 
    background-color: #4f46e5 !important; 
    color: #ffffff !important; 
  }
  .step-dot.active span:last-child { 
    color: #4f46e5 !important; 
    font-weight: 700 !important; 
  }
  .step-dot.completed span:first-child { 
    background-color: #10b981 !important; 
    color: #ffffff !important; 
  }
  .step-dot.completed span:last-child { 
    color: #10b981 !important; 
    font-weight: 600 !important; 
  }
</style>

<script>
  import { buildPrompt } from '../../scripts/prompts.js';

  // --- State ---
  let currentStep = 1;

  // --- Step Navigation ---
  window.goToStep = function(step) {
    // Validate step 1 before moving forward
    if (step > 1 && currentStep === 1) {
      const topik = document.getElementById('topik').value.trim();
      if (!topik) {
        showToast('⚠️ Tulis topik dulu ya!');
        document.getElementById('topik').focus();
        return;
      }
    }

    document.querySelectorAll('.step-panel').forEach(p => p.classList.add('hidden'));
    document.getElementById(`step-${step}`)?.classList.remove('hidden');

    // Auto-generate prompt when entering Step 2
    if (step === 2) {
      generatePrompt(null, true);
    }

    // Update indicators
    document.querySelectorAll('.step-dot').forEach(dot => {
      const s = parseInt(dot.dataset.step);
      const circle = dot.querySelector('span:first-child');
      const label = dot.querySelector('span:last-child');
      dot.classList.remove('active', 'completed');
      if (s < step) {
        dot.classList.add('completed');
        circle.style.backgroundColor = '#10b981';
        circle.style.color = '#ffffff';
        if (label) {
          label.style.color = '#10b981';
          label.style.fontWeight = '600';
        }
      } else if (s === step) {
        dot.classList.add('active');
        circle.style.backgroundColor = '#4f46e5';
        circle.style.color = '#ffffff';
        if (label) {
          label.style.color = '#4f46e5';
          label.style.fontWeight = '700';
        }
      } else {
        circle.style.backgroundColor = '';
        circle.style.color = '';
        if (label) {
          label.style.color = '';
          label.style.fontWeight = '';
        }
      }
    });

    currentStep = step;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // --- Framework Selection UI ---
  document.getElementById('framework-options')?.addEventListener('change', (e) => {
    document.querySelectorAll('.framework-option').forEach(opt => {
      opt.classList.remove('border-indigo-600', 'bg-indigo-50/60');
      opt.classList.add('border-slate-200');
      const dot = opt.querySelector('.w-2\\.5');
      if (dot) dot.remove();
    });
    const label = e.target.closest('label');
    if (label) {
      label.classList.remove('border-slate-200');
      label.classList.add('border-indigo-600', 'bg-indigo-50/60');
      const circle = label.querySelector('.w-5');
      if (circle && !circle.querySelector('.w-2\\.5')) {
        const inner = document.createElement('span');
        inner.className = 'w-2.5 h-2.5 rounded-full bg-indigo-600 text-white';
        circle.appendChild(inner);
      }
    }
  });

  // --- Gather Form Data ---
  function getFormData(formatOverride = null) {
    return {
      topik: document.getElementById('topik').value.trim(),
      audiens: document.getElementById('audiens').value.trim() || 'Umum',
      tujuan: document.getElementById('tujuan').value.trim() || 'Edukasi',
      tone: document.getElementById('tone').value,
      framework: document.querySelector('input[name="framework"]:checked')?.value || 'storiq10',
      format: formatOverride || 'blog',
    };
  }

  // --- Generate Prompt ---
  window.generatePrompt = function(formatOverride = null, silent = false) {
    const data = getFormData(formatOverride);
    if (!data.topik) {
      if (!silent) showToast('⚠️ Tulis topik dulu ya!');
      goToStep(1);
      return;
    }
    const prompt = buildPrompt(data);
    document.getElementById('prompt-text').value = prompt;
    if (!silent) showToast('✨ Prompt berhasil dibuat! Copy dan paste ke AI favoritmu.');
  };

  window.copyPrompt = function() {
    const text = document.getElementById('prompt-text').value;
    navigator.clipboard.writeText(text).then(() => showToast('📋 Prompt berhasil di-copy!'));
  };

  // --- Proses Paste Content ---
  window.processPastedContent = function() {
    const pasted = document.getElementById('pasted-content').value.trim();
    if (!pasted) {
      showToast('⚠️ Paste dulu konten dari AI kalian ya!');
      return;
    }
    // Update caption preview with the pasted content
    renderActiveCaption();
    // Go to step 3 (Hasil & Visual)
    goToStep(3);
  };

  // --- Visual Settings (Faceless & Brand Color) ---
  let isFacelessActive = false;
  let isBrandColorActive = false;
  let brandColorHex = '#4F46E5';

  function sanitizeHex(val) {
    let cleaned = val.trim();
    if (!cleaned.startsWith('#')) cleaned = '#' + cleaned;
    if (cleaned.length > 7) cleaned = cleaned.slice(0, 7);
    return cleaned.toUpperCase();
  }

  function getVisualPrompt(type, isFaceless, isColorActive, colorHex, isSumopod = false) {
    const prefix = isSumopod ? 'Berdasarkan konten artikel di atas:' : 'Berdasarkan konten di atas:';
    const colorInstruction = isColorActive
      ? `\n* WARNA UTAMA BRAND: Wajib terapkan warna primer brand kode hex ${colorHex} (beserta palet aksen turunan senada) sebagai warna dominan pada elemen grafis, badge teks, latar/frame, atau pakaian karakter agar feed media sosial seragam dan konsisten.`
      : '';
    const colorEnglish = isColorActive
      ? `, primary brand color hex ${colorHex}, cohesive brand visual identity palette`
      : '';

    if (type === 'single') {
      const faceInstruction = isFaceless
        ? `\n* PENTING (ATURAN WAJAH): Jika terdapat karakter / figur manusia dalam gambar, WAJIB dibuat TANPA fitur wajah (FACELESS: hilangkan alis, mata, hidung, dan mulut — permukaan wajah polos mulus / blank smooth face, hanya rambut, telinga, pakaian, dan gestur tubuh yang tampak, gaya 3D clay / clean vector seperti poster infografis edukatif).`
        : '';
      const faceEnglish = isFaceless
        ? ', faceless minimalist character, blank smooth face, no facial features, no eyes, no eyebrows, no nose, no mouth'
        : '';

      return `${prefix}
1. Rangkum 1 pesan inti & teks copy singkat untuk di dalam gambar.
2. LANGSUNG GENERATE GAMBAR SEKARANG: Buatkan dan tampilkan langsung gambar ilustrasinya (gunakan fitur image generation / DALL-E / Imagen bawaanmu) yang memvisualisasikan konsep tersebut, rasio 1:1 (square), gaya modern, clean, dan relatable.${faceInstruction}${colorInstruction}
3. Sertakan juga prompt Bahasa Inggris siap pakai untuk Midjourney / Flux / Ideogram (tambahkan deskripsi: "modern 3D clay illustration, clean aesthetic${faceEnglish}${colorEnglish}").`;
    }

    if (type === 'carousel') {
      const faceInstruction = isFaceless
        ? `\n* PENTING (ATURAN WAJAH): Jika ada ilustrasi karakter manusia pada cover/slide, WAJIB dibuat TANPA fitur wajah (FACELESS: hilangkan alis, mata, hidung, dan mulut — wajah polos mulus / blank smooth face, gaya 3D infografis modern).`
        : '';
      const faceEnglish = isFaceless
        ? ', faceless character, blank smooth face, no eyes, no eyebrows, no nose, no mouth'
        : '';

      return `${prefix}
1. Susun alur 5 slide Carousel (Headline max 10 kata + Body max 2 kalimat untuk tiap slide).
2. LANGSUNG GENERATE GAMBAR COVER SEKARANG: Buatkan dan tampilkan langsung gambar desain visual untuk SLIDE 1 (Cover / Hook) yang paling eye-catching (gunakan fitur image generation / DALL-E / Imagen bawaanmu), rasio 1:1 atau 4:5 portrait, gaya clean & modern.${faceInstruction}${colorInstruction}
3. Sertakan prompt Bahasa Inggris untuk slide berikutnya jika ingin di-generate satu per satu (sertakan: "clean modern carousel cover, 3D clay style${faceEnglish}${colorEnglish}").`;
    }

    if (type === 'infografis') {
      const faceInstruction = isFaceless
        ? `\n* PENTING (ATURAN WAJAH): Jika terdapat karakter / figur manusia pada poster infografis, WAJIB dibuat TANPA fitur wajah (FACELESS: hilangkan alis, mata, hidung, dan mulut — permukaan wajah polos mulus / blank smooth face, hanya rambut dan gestur tubuh, gaya 3D infografis edukatif).`
        : '';
      const faceEnglish = isFaceless
        ? ', faceless 3D character, blank smooth face, no facial features, no eyes, no nose, no mouth, no eyebrows'
        : '';

      return `${prefix}
1. Rangkum poin-poin utama, data, atau langkah-langkah secara terstruktur dan ringkas.
2. LANGSUNG GENERATE GAMBAR SEKARANG: Buatkan dan render langsung visual desain poster INFOGRAFIS lengkap (format vertikal 9:16 atau 4:5, gaya clean, modern, informatif dengan ikon/elemen visual pendukung) menggunakan fitur image generation / DALL-E / Imagen bawaanmu.${faceInstruction}${colorInstruction}
3. Sertakan juga prompt Bahasa Inggris siap pakai untuk Midjourney / Flux / Ideogram (sertakan: "educational infographic poster design, modern 3D vector illustration${faceEnglish}${colorEnglish}").`;
    }

    return '';
  }

  function renderVisualPrompts() {
    ['single', 'carousel', 'infografis'].forEach(type => {
      const el = document.getElementById(`prompt-${type}`);
      if (el) {
        el.innerText = getVisualPrompt(type, isFacelessActive, isBrandColorActive, brandColorHex, false);
      }
    });
  }

  function updateFacelessMode(active, notify = true) {
    isFacelessActive = active;
    const chk = document.getElementById('toggle-faceless');
    if (chk) chk.checked = active;

    renderVisualPrompts();

    if (notify) {
      showToast(active 
        ? '👤 Mode Faceless diaktifkan: Alis, mata, hidung & mulut ditiadakan' 
        : '👤 Mode visual standar diaktifkan'
      );
    }
  }

  function updateBrandColorMode(active, notify = true) {
    isBrandColorActive = active;
    const chk = document.getElementById('toggle-brand-color');
    const container = document.getElementById('brand-color-container');

    if (chk) chk.checked = active;
    if (container) {
      if (active) container.classList.remove('hidden');
      else container.classList.add('hidden');
    }

    renderVisualPrompts();

    if (notify) {
      showToast(active 
        ? `🎨 Warna brand (${brandColorHex}) diaktifkan pada prompt visual!` 
        : '🎨 Warna brand dinonaktifkan'
      );
    }
  }

  function applyBrandColorChange(hex, notify = false) {
    const sanitized = sanitizeHex(hex);
    brandColorHex = sanitized;

    const inputHex = document.getElementById('color-hex');
    const picker = document.getElementById('color-picker');

    if (inputHex && inputHex.value !== sanitized) inputHex.value = sanitized;
    if (/^#[0-9A-Fa-f]{6}$/.test(sanitized) && picker) {
      picker.value = sanitized;
    }

    renderVisualPrompts();
    if (notify) {
      showToast(`🎨 Warna brand diubah ke ${sanitized}`);
    }
  }

  window.setBrandColorPreset = function(hex) {
    applyBrandColorChange(hex, true);
    if (!isBrandColorActive) {
      updateBrandColorMode(true, false);
    }
  };

  document.getElementById('toggle-faceless')?.addEventListener('change', (e) => {
    updateFacelessMode(e.target.checked);
  });

  document.getElementById('toggle-brand-color')?.addEventListener('change', (e) => {
    updateBrandColorMode(e.target.checked);
  });

  document.getElementById('color-picker')?.addEventListener('input', (e) => {
    applyBrandColorChange(e.target.value);
  });

  const colorHexInput = document.getElementById('color-hex');
  if (colorHexInput) {
    colorHexInput.addEventListener('input', (e) => {
      let val = e.target.value.trim();
      if (val && !val.startsWith('#')) val = '#' + val;
      if (val.length > 7) val = val.slice(0, 7);
      e.target.value = val.toUpperCase();
      if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
        applyBrandColorChange(val);
      }
    });
    colorHexInput.addEventListener('blur', (e) => {
      let val = e.target.value.trim();
      if (!val || !/^#[0-9A-Fa-f]{6}$/.test(val)) {
        e.target.value = brandColorHex;
      } else {
        applyBrandColorChange(val, true);
      }
    });
  }

  // --- Copy Visual Prompt ---
  window.copyVisualPrompt = function(type) {
    const text = document.getElementById(`prompt-${type}`).innerText;
    navigator.clipboard.writeText(text).then(() => showToast('📋 Prompt visual berhasil di-copy!'));
  };

  // --- Social Media Caption Feature ---
  function extractKeyTakeaways(text, fallbackTopic) {
    if (!text) {
      return [
        `Pahami akar masalah seputar ${fallbackTopic || 'isu ini'}`,
        `Terapkan strategi praktis langkah demi langkah`,
        `Lakukan evaluasi & jaga konsistensi hasil`
      ];
    }
    const lines = text.split('\n')
      .map(l => l.trim())
      .filter(l => l.length > 12 && (
        /^[\d\-*•]/.test(l) || 
        l.startsWith('###') || 
        l.startsWith('**') ||
        /^(Langkah|Poin|Tips|Kunci|Strategi|Solusi)/i.test(l)
      ));
    if (lines.length >= 3) {
      return lines.slice(0, 3).map(l => l.replace(/^[\d\-*•#]+\.?\s*/, '').replace(/^\*\*|\*\*$/g, '').trim());
    }
    const sentences = text.split(/[.!?]\s+/).filter(s => s.trim().length > 20 && s.trim().length < 130);
    if (sentences.length >= 3) {
      return lines.length > 0 && sentences.length >= 3 ? sentences.slice(0, 3).map(s => s.trim()) : sentences.slice(0, 3).map(s => s.trim());
    }
    return [
      `Pahami akar masalah seputar ${fallbackTopic || 'isu ini'}`,
      `Terapkan strategi praktis langkah demi langkah`,
      `Lakukan evaluasi & jaga konsistensi hasil`
    ];
  }

  function generateSocialCaption() {
    const topik = document.getElementById('topik')?.value.trim() || 'Strategi Menghasilkan Konten Berdampak';
    const pasted = document.getElementById('pasted-content')?.value.trim() || '';
    const points = extractKeyTakeaways(pasted, topik);

    return `🔥 ${topik}

Banyak yang mengira kunci sukses seputar topik ini rumit, padahal solusinya berakar dari pemahaman prinsip dasarnya yang tepat.

Poin penting yang wajib kamu ingat:
📌 ${points[0]}
📌 ${points[1]}
📌 ${points[2]}

👉 Cek visual di atas untuk rangkuman intinya!

Menurutmu bagaimana? Tulis pendapat atau pengalamanmu di kolom komentar ya! 👇`;
  }

  function renderActiveCaption() {
    const el = document.getElementById('caption-content');
    if (el) {
      el.textContent = generateSocialCaption();
    }
  }

  window.copyCaption = function() {
    const el = document.getElementById('caption-content');
    if (!el) return;
    const text = el.textContent;
    navigator.clipboard.writeText(text).then(() => {
      showToast('📋 Caption berhasil di-copy! Siap dipaste sebelum posting.');
    });
  };

  // --- Toast ---
  function showToast(msg) {
    const toast = document.getElementById('toast');
    toast.textContent = msg;
    toast.classList.remove('translate-y-20', 'opacity-0');
    setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0'), 2500);
  }

  // --- Real-time Form Validation (Disable Button until Filled) ---
  function checkStep1Validation() {
    const topik = document.getElementById('topik')?.value.trim();
    const audiens = document.getElementById('audiens')?.value.trim();
    const tujuan = document.getElementById('tujuan')?.value.trim();
    const btn = document.getElementById('btn-next-step-1');
    
    const isValid = !!(topik && audiens && tujuan);
    if (btn) {
      btn.disabled = !isValid;
      if (isValid) {
        btn.className = 'px-6 py-3 bg-indigo-600 text-white hover:bg-indigo-600 text-white rounded-lg font-medium transition-all shadow-md hover:shadow-indigo-600/20 cursor-pointer';
      } else {
        btn.className = 'px-6 py-3 bg-slate-200 text-slate-400 cursor-not-allowed rounded-lg font-medium transition-all';
      }
    }
  }

  function checkStep2Validation() {
    const pasted = document.getElementById('pasted-content')?.value.trim();
    const btn = document.getElementById('btn-next-step-2');
    const isValid = !!pasted;
    if (btn) {
      btn.disabled = !isValid;
      if (isValid) {
        btn.className = 'px-6 py-3 bg-indigo-600 text-white hover:bg-indigo-600 text-white rounded-lg font-medium transition-all shadow-md hover:shadow-indigo-600/20 cursor-pointer';
      } else {
        btn.className = 'px-6 py-3 bg-slate-200 text-slate-400 cursor-not-allowed rounded-lg font-medium transition-all';
      }
    }
  }

  ['topik', 'audiens', 'tujuan'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', checkStep1Validation);
  });
  document.getElementById('pasted-content')?.addEventListener('input', checkStep2Validation);

  // Check on load
  document.addEventListener('DOMContentLoaded', () => {
    checkStep1Validation();
    checkStep2Validation();
    renderActiveCaption();
  });
</script>
