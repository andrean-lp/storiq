<script>
  import { buildPrompt } from '../../scripts/prompts.js';
  import { generateDynamicSocialCaption } from '../../scripts/caption-generator.js';

  // --- State ---
  let currentStep = 1;
  let activeWorkflow = 'idea';

  // --- Workflow Mode Switcher ---
  window.switchWorkflowMode = function(mode) {
    activeWorkflow = mode;
    const tabIdea = document.getElementById('tab-from-idea');
    const tabArticle = document.getElementById('tab-from-article');
    const ideaIndicator = document.getElementById('workflow-idea-indicator');
    const directPanel = document.getElementById('panel-direct-article');
    const step3BackBtn = document.getElementById('btn-back-step-3');

    if (mode === 'article') {
      // Style active tab: article
      if (tabArticle) {
        tabArticle.className = 'pb-3 px-3 text-xs sm:text-sm font-bold border-b-2 border-indigo-600 text-indigo-700 flex items-center gap-2 cursor-pointer transition-all';
      }
      if (tabIdea) {
        tabIdea.className = 'pb-3 px-3 text-xs sm:text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center gap-2 cursor-pointer transition-all';
      }

      // Hide idea indicator and step panels
      if (ideaIndicator) ideaIndicator.classList.add('hidden');
      document.querySelectorAll('.step-panel').forEach(p => p.classList.add('hidden'));

      // Show direct article panel
      if (directPanel) directPanel.classList.remove('hidden');

      if (step3BackBtn) {
        step3BackBtn.textContent = '← Kembali ke Edit Naskah';
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      // Style active tab: idea
      if (tabIdea) {
        tabIdea.className = 'pb-3 px-3 text-xs sm:text-sm font-bold border-b-2 border-indigo-600 text-indigo-700 flex items-center gap-2 cursor-pointer transition-all';
      }
      if (tabArticle) {
        tabArticle.className = 'pb-3 px-3 text-xs sm:text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center gap-2 cursor-pointer transition-all';
      }

      // Show idea indicator and hide direct article panel
      if (ideaIndicator) ideaIndicator.classList.remove('hidden');
      if (directPanel) directPanel.classList.add('hidden');

      if (step3BackBtn) {
        step3BackBtn.textContent = '← Kembali';
      }

      goToStep(currentStep || 1);
    }
  };

  // --- Process Direct Article (Instan Repurpose) ---
  window.processDirectArticle = function() {
    const content = document.getElementById('direct-article-content')?.value.trim();
    if (!content) {
      showToast('⚠️ Paste naskah artikel / tulisanmu dulu ya!');
      document.getElementById('direct-article-content')?.focus();
      return;
    }

    const userTopic = document.getElementById('direct-topik')?.value.trim();
    const toneVal = document.getElementById('direct-tone')?.value || 'santai';

    // Auto-detect topic from first line if not provided
    let finalTopic = userTopic;
    if (!finalTopic) {
      const lines = content.split('\n').map(l => l.trim()).filter(Boolean);
      if (lines.length > 0) {
        finalTopic = lines[0].replace(/^#+\s*/, '').replace(/^\*\*|\*\*$/g, '').slice(0, 70).trim();
      }
      if (!finalTopic) {
        finalTopic = 'Topik Utama Artikel';
      }
    }

    // Sync to hidden / shared form elements
    const topikEl = document.getElementById('topik');
    const toneEl = document.getElementById('tone');
    const pastedEl = document.getElementById('pasted-content');

    if (topikEl) topikEl.value = finalTopic;
    if (toneEl) toneEl.value = toneVal;
    if (pastedEl) pastedEl.value = content;

    // Render dynamic caption & visual prompts
    renderActiveCaption();
    renderVisualPrompts();

    // Hide direct article panel and show Step 3
    document.getElementById('panel-direct-article')?.classList.add('hidden');
    document.querySelectorAll('.step-panel').forEach(p => p.classList.add('hidden'));
    const step3 = document.getElementById('step-3');
    if (step3) step3.classList.remove('hidden');

    const step3BackBtn = document.getElementById('btn-back-step-3');
    if (step3BackBtn) {
      step3BackBtn.textContent = '← Kembali ke Edit Naskah';
    }

    window.scrollTo({ top: 0, behavior: 'smooth' });
    showToast('✨ Naskah berhasil dipecah menjadi 8 format medsos!');
  };

  // --- Step 3 Navigation Handlers ---
  window.handleBackFromStep3 = function() {
    if (activeWorkflow === 'article') {
      document.getElementById('step-3')?.classList.add('hidden');
      document.getElementById('panel-direct-article')?.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      goToStep(2);
    }
  };

  window.handleNewIdea = function() {
    if (activeWorkflow === 'article') {
      const directContent = document.getElementById('direct-article-content');
      const directTopik = document.getElementById('direct-topik');
      if (directContent) directContent.value = '';
      if (directTopik) directTopik.value = '';
      checkDirectArticleValidation();
      document.getElementById('step-3')?.classList.add('hidden');
      document.getElementById('panel-direct-article')?.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
      if (directContent) directContent.focus();
    } else {
      const topik = document.getElementById('topik');
      const audiens = document.getElementById('audiens');
      const tujuan = document.getElementById('tujuan');
      const pasted = document.getElementById('pasted-content');
      if (topik) topik.value = '';
      if (audiens) audiens.value = '';
      if (tujuan) tujuan.value = '';
      if (pasted) pasted.value = '';
      checkStep1Validation();
      checkStep2Validation();
      goToStep(1);
    }
  };

  // --- Step Navigation ---
  window.goToStep = function(step) {
    // Validate step 1 before moving forward
    if (step > 1 && currentStep === 1) {
      const topik = document.getElementById('topik').value.trim();
      if (!topik) {
        showToast('⚠️ Tulis topik dulu ya!');
        document.getElementById('topik').focus();
        return;
      }
    }

    document.querySelectorAll('.step-panel').forEach(p => p.classList.add('hidden'));
    document.getElementById(`step-${step}`)?.classList.remove('hidden');

    // Auto-generate prompt when entering Step 2
    if (step === 2) {
      generatePrompt(null, true);
    }

    // Update indicators
    document.querySelectorAll('.step-dot').forEach(dot => {
      const s = parseInt(dot.dataset.step);
      const circle = dot.querySelector('span:first-child');
      const label = dot.querySelector('span:last-child');
      dot.classList.remove('active', 'completed');
      if (s < step) {
        dot.classList.add('completed');
        circle.style.backgroundColor = '#10b981';
        circle.style.color = '#ffffff';
        if (label) {
          label.style.color = '#10b981';
          label.style.fontWeight = '600';
        }
      } else if (s === step) {
        dot.classList.add('active');
        circle.style.backgroundColor = '#4f46e5';
        circle.style.color = '#ffffff';
        if (label) {
          label.style.color = '#4f46e5';
          label.style.fontWeight = '700';
        }
      } else {
        circle.style.backgroundColor = '';
        circle.style.color = '';
        if (label) {
          label.style.color = '';
          label.style.fontWeight = '';
        }
      }
    });

    currentStep = step;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // --- Framework Selection UI ---
  document.getElementById('framework-options')?.addEventListener('change', (e) => {
    document.querySelectorAll('.framework-option').forEach(opt => {
      opt.classList.remove('border-indigo-600', 'bg-indigo-50/60');
      opt.classList.add('border-slate-200');
      const dot = opt.querySelector('.w-2\\.5');
      if (dot) dot.remove();
    });
    const label = e.target.closest('label');
    if (label) {
      label.classList.remove('border-slate-200');
      label.classList.add('border-indigo-600', 'bg-indigo-50/60');
      const circle = label.querySelector('.w-5');
      if (circle && !circle.querySelector('.w-2\\.5')) {
        const inner = document.createElement('span');
        inner.className = 'w-2.5 h-2.5 rounded-full bg-indigo-600 text-white';
        circle.appendChild(inner);
      }
    }
  });

  // --- Gather Form Data ---
  function getFormData(formatOverride = null) {
    return {
      topik: document.getElementById('topik').value.trim(),
      audiens: document.getElementById('audiens').value.trim() || 'Umum',
      tujuan: document.getElementById('tujuan').value.trim() || 'Edukasi',
      tone: document.getElementById('tone').value,
      framework: document.querySelector('input[name="framework"]:checked')?.value || 'storiq10',
      format: formatOverride || 'blog',
    };
  }

  // --- Generate Prompt ---
  window.generatePrompt = function(formatOverride = null, silent = false) {
    const data = getFormData(formatOverride);
    if (!data.topik) {
      if (!silent) showToast('⚠️ Tulis topik dulu ya!');
      goToStep(1);
      return;
    }
    const prompt = buildPrompt(data);
    document.getElementById('prompt-text').value = prompt;
    if (!silent) showToast('✨ Prompt berhasil dibuat! Copy dan paste ke AI favoritmu.');
  };

  window.copyPrompt = function() {
    const text = document.getElementById('prompt-text')?.value || '';
    copyTextSafely(text, '📋 Prompt berhasil di-copy!');
  };

  // --- Proses Paste Content ---
  window.processPastedContent = function() {
    const pasted = document.getElementById('pasted-content').value.trim();
    if (!pasted) {
      showToast('⚠️ Paste dulu konten dari AI kalian ya!');
      return;
    }
    // Update caption preview with the pasted content
    renderActiveCaption();
    // Go to step 3 (Hasil & Visual)
    goToStep(3);
  };

  // --- Visual Settings (Portrait, Faceless, Brand Color & Typography) ---
  let isPortraitActive = false;
  let isFacelessActive = false;
  let isBrandColorActive = false;
  let primaryColorHex = '#4F46E5';
  let secondaryColorHex = '#F59E0B';
  let isTypographyActive = false;
  let primaryFontVal = 'Poppins';
  let secondaryFontVal = 'Inter';

  function sanitizeHex(val) {
    let cleaned = val.trim();
    if (!cleaned.startsWith('#')) cleaned = '#' + cleaned;
    if (cleaned.length > 7) cleaned = cleaned.slice(0, 7);
    return cleaned.toUpperCase();
  }

  function getVisualPrompt(type, isFaceless, isColorActive, primaryColor, secondaryColor, isPortrait = false, isTypography = false, primaryFont = 'Poppins', secondaryFont = 'Inter', isSumopod = false) {
    const prefix = isSumopod ? 'Berdasarkan konten artikel di atas:' : 'Berdasarkan konten di atas:';
    
    const colorInstruction = isColorActive
      ? `\n* PANDUAN WARNA BRAND: Wajib terapkan Primary Color ${primaryColor} sebagai warna dominan (latar belakang, busana karakter, atau frame desain utama) dan Secondary Color ${secondaryColor} sebagai warna sekunder / aksen kontras (badge penegas, ornamen visual, ikon, atau tombol highlight) agar tampilan feed media sosial selaras dan profesional.`
      : '';
    const colorEnglish = isColorActive
      ? `, primary brand color ${primaryColor}, secondary accent color ${secondaryColor}, cohesive brand visual palette`
      : '';

    const typographyInstruction = isTypography
      ? `\n* PANDUAN TIPOGRAFI BRAND: Pada seluruh teks di dalam desain, gunakan gaya font "${primaryFont}" untuk Headline / Judul Utama (tebal, tegas, kontras tinggi) serta font "${secondaryFont}" untuk Subjudul / Body Text / Penjelas agar keterbacaan rapi dan berkelas.`
      : '';
    const typographyEnglish = isTypography
      ? `, typography pairing: bold "${primaryFont}" for headlines and clean "${secondaryFont}" for body text`
      : '';

    if (type === 'single') {
      const faceInstruction = isFaceless
        ? `\n* PENTING (ATURAN WAJAH): Jika terdapat karakter / figur manusia dalam gambar, WAJIB dibuat TANPA fitur wajah (FACELESS: hilangkan alis, mata, hidung, dan mulut — permukaan wajah polos mulus / blank smooth face, hanya rambut, telinga, pakaian, dan gestur tubuh yang tampak, gaya 3D clay / clean vector seperti poster infografis edukatif).`
        : '';
      const faceEnglish = isFaceless
        ? ', faceless minimalist character, blank smooth face, no facial features, no eyes, no eyebrows, no nose, no mouth'
        : '';

      const sizeDescIndo = isPortrait
        ? 'ukuran 1080 x 1350 piksel (rasio 4:5 potret vertikal — format feed Instagram & LinkedIn yang optimal)'
        : 'ukuran 1080 x 1080 piksel (rasio 1:1 persegi/square — format standar feed)';
      const sizeDescEnglish = isPortrait
        ? ', 1080x1350 pixels resolution, portrait 4:5 aspect ratio'
        : ', 1080x1080 pixels resolution, square 1:1 aspect ratio';

      return `${prefix}
1. Rangkum 1 pesan inti & teks copy singkat untuk di dalam gambar.
2. LANGSUNG GENERATE GAMBAR SEKARANG: Buatkan dan tampilkan langsung gambar ilustrasinya (gunakan fitur image generation / DALL-E / Imagen bawaanmu) yang memvisualisasikan konsep tersebut, ${sizeDescIndo}, gaya modern, clean, dan relatable.${faceInstruction}${colorInstruction}${typographyInstruction}
3. Sertakan juga prompt Bahasa Inggris siap pakai untuk Midjourney / Flux / Ideogram (tambahkan deskripsi: "modern 3D clay illustration, clean aesthetic${faceEnglish}${colorEnglish}${typographyEnglish}${sizeDescEnglish}").`;
    }

    if (type === 'carousel') {
      const faceInstruction = isFaceless
        ? `\n* PENTING (ATURAN WAJAH): Jika ada ilustrasi karakter manusia pada cover/slide, WAJIB dibuat TANPA fitur wajah (FACELESS: hilangkan alis, mata, hidung, dan mulut — wajah polos mulus / blank smooth face, gaya 3D infografis modern).`
        : '';
      const faceEnglish = isFaceless
        ? ', faceless character, blank smooth face, no eyes, no eyebrows, no nose, no mouth'
        : '';

      const sizeDescIndo = isPortrait
        ? 'ukuran 1080 x 1350 piksel (rasio 4:5 potret vertikal yang pas & optimal untuk feed Instagram & LinkedIn)'
        : 'ukuran 1080 x 1080 piksel (rasio 1:1 persegi/square — format standar feed)';
      const sizeDescEnglish = isPortrait
        ? ', 1080x1350 px, vertical portrait 4:5 ratio'
        : ', 1080x1080 px, square 1:1 aspect ratio';
      const sizeDescNext = isPortrait
        ? 'rasio 4:5 potret vertikal, ukuran 1080 x 1350 piksel'
        : 'rasio 1:1 persegi/square, ukuran 1080 x 1080 piksel';

      return `${prefix}
1. Susun alur 5 slide Carousel (Headline max 10 kata + Body max 2 kalimat untuk tiap slide).
2. LANGSUNG GENERATE GAMBAR COVER SEKARANG: Buatkan dan tampilkan langsung gambar desain visual untuk SLIDE 1 (Cover / Hook) yang paling eye-catching (gunakan fitur image generation / DALL-E / Imagen bawaanmu), ${sizeDescIndo}, gaya clean & modern.${faceInstruction}${colorInstruction}${typographyInstruction}
3. Sertakan prompt Bahasa Inggris untuk slide berikutnya jika ingin di-generate satu per satu (sertakan: "clean modern carousel cover, 3D clay style${faceEnglish}${colorEnglish}${typographyEnglish}${sizeDescEnglish}").
4. ATURAN ALUR GENERASI SLIDE: Setelah gambar Slide 1 selesai dibuat, berikan instruksi penutup singkat: "👉 Ketik LANJUT untuk membuat visual SLIDE 2" agar saya bisa melanjutkan pembuatan visual Slide 2 s/d 5 satu per satu secara berurutan dengan alur, ukuran gambar (${sizeDescNext}), karakter, dan warna brand yang sama persis.`;
    }

    if (type === 'infografis') {
      const faceInstruction = isFaceless
        ? `\n* PENTING (ATURAN WAJAH): Jika terdapat karakter / figur manusia pada poster infografis, WAJIB dibuat TANPA fitur wajah (FACELESS: hilangkan alis, mata, hidung, dan mulut — permukaan wajah polos mulus / blank smooth face, hanya rambut dan gestur tubuh, gaya 3D infografis edukatif).`
        : '';
      const faceEnglish = isFaceless
        ? ', faceless 3D character, blank smooth face, no facial features, no eyes, no nose, no mouth, no eyebrows'
        : '';

      return `${prefix}
1. Rangkum poin-poin utama, data, atau langkah-langkah secara terstruktur dan ringkas.
2. LANGSUNG GENERATE GAMBAR SEKARANG: Buatkan dan render langsung visual desain poster INFOGRAFIS lengkap (format vertikal 9:16 atau 4:5, gaya clean, modern, informatif dengan ikon/elemen visual pendukung) menggunakan fitur image generation / DALL-E / Imagen bawaanmu.${faceInstruction}${colorInstruction}${typographyInstruction}
3. Sertakan juga prompt Bahasa Inggris siap pakai untuk Midjourney / Flux / Ideogram (sertakan: "educational infographic poster design, modern 3D vector illustration${faceEnglish}${colorEnglish}${typographyEnglish}").`;
    }

    return '';
  }

  function renderVisualPrompts() {
    ['single', 'carousel', 'infografis'].forEach(type => {
      const el = document.getElementById(`prompt-${type}`);
      if (el) {
        el.innerText = getVisualPrompt(
          type,
          isFacelessActive,
          isBrandColorActive,
          primaryColorHex,
          secondaryColorHex,
          isPortraitActive,
          isTypographyActive,
          primaryFontVal,
          secondaryFontVal,
          false
        );
      }
    });
  }

  function updatePortraitMode(active, notify = true) {
    isPortraitActive = active;
    const chk = document.getElementById('toggle-portrait');
    if (chk) chk.checked = active;

    renderVisualPrompts();

    if (notify) {
      showToast(active 
        ? '📱 Format Potret (1080x1350 px, 4:5) diaktifkan untuk Single Image & Carousel!' 
        : '📱 Format visual kembali ke Feed Persegi (1080x1080 px, 1:1)'
      );
    }
  }

  function updateFacelessMode(active, notify = true) {
    isFacelessActive = active;
    const chk = document.getElementById('toggle-faceless');
    if (chk) chk.checked = active;

    renderVisualPrompts();

    if (notify) {
      showToast(active 
        ? '👤 Mode Faceless diaktifkan: Alis, mata, hidung & mulut ditiadakan' 
        : '👤 Mode visual standar diaktifkan'
      );
    }
  }

  function updateBrandColorMode(active, notify = true) {
    isBrandColorActive = active;
    const chk = document.getElementById('toggle-brand-color');
    const container = document.getElementById('brand-color-container');

    if (chk) chk.checked = active;
    if (container) {
      if (active) container.classList.remove('hidden');
      else container.classList.add('hidden');
    }

    renderVisualPrompts();

    if (notify) {
      showToast(active 
        ? `🎨 Warna brand diaktifkan: Primary (${primaryColorHex}) & Secondary (${secondaryColorHex})` 
        : '🎨 Warna brand dinonaktifkan'
      );
    }
  }

  function applyPrimaryColorChange(hex, notify = false) {
    const sanitized = sanitizeHex(hex);
    primaryColorHex = sanitized;

    const inputHex = document.getElementById('color-hex-primary');
    const picker = document.getElementById('color-picker-primary');
    const dot = document.getElementById('preview-dot-primary');

    if (inputHex && inputHex.value !== sanitized) inputHex.value = sanitized;
    if (/^#[0-9A-Fa-f]{6}$/.test(sanitized) && picker) picker.value = sanitized;
    if (dot) dot.style.backgroundColor = sanitized;

    renderVisualPrompts();
    if (notify) showToast(`🎨 Primary color diubah ke ${sanitized}`);
  }

  function applySecondaryColorChange(hex, notify = false) {
    const sanitized = sanitizeHex(hex);
    secondaryColorHex = sanitized;

    const inputHex = document.getElementById('color-hex-secondary');
    const picker = document.getElementById('color-picker-secondary');
    const dot = document.getElementById('preview-dot-secondary');

    if (inputHex && inputHex.value !== sanitized) inputHex.value = sanitized;
    if (/^#[0-9A-Fa-f]{6}$/.test(sanitized) && picker) picker.value = sanitized;
    if (dot) dot.style.backgroundColor = sanitized;

    renderVisualPrompts();
    if (notify) showToast(`🎨 Secondary color diubah ke ${sanitized}`);
  }

  window.setPrimaryColorPreset = function(hex) {
    applyPrimaryColorChange(hex, true);
    if (!isBrandColorActive) updateBrandColorMode(true, false);
  };

  window.setSecondaryColorPreset = function(hex) {
    applySecondaryColorChange(hex, true);
    if (!isBrandColorActive) updateBrandColorMode(true, false);
  };

  function updateTypographyMode(active, notify = true) {
    isTypographyActive = active;
    const chk = document.getElementById('toggle-typography');
    const container = document.getElementById('typography-container');

    if (chk) chk.checked = active;
    if (container) {
      if (active) container.classList.remove('hidden');
      else container.classList.add('hidden');
    }

    renderVisualPrompts();

    if (notify) {
      showToast(active 
        ? `🔤 Tipografi brand diaktifkan: ${primaryFontVal} & ${secondaryFontVal}` 
        : '🔤 Tipografi brand dinonaktifkan'
      );
    }
  }

  function handlePrimaryFontChange() {
    const select = document.getElementById('font-select-primary');
    const customInput = document.getElementById('font-custom-primary');
    if (!select) return;

    if (select.value === 'custom') {
      if (customInput) {
        customInput.classList.remove('hidden');
        primaryFontVal = customInput.value.trim() || 'Custom Sans';
      }
    } else {
      if (customInput) customInput.classList.add('hidden');
      primaryFontVal = select.value;
    }
    renderVisualPrompts();
  }

  function handleSecondaryFontChange() {
    const select = document.getElementById('font-select-secondary');
    const customInput = document.getElementById('font-custom-secondary');
    if (!select) return;

    if (select.value === 'custom') {
      if (customInput) {
        customInput.classList.remove('hidden');
        secondaryFontVal = customInput.value.trim() || 'Custom Sans';
      }
    } else {
      if (customInput) customInput.classList.add('hidden');
      secondaryFontVal = select.value;
    }
    renderVisualPrompts();
  }

  document.getElementById('toggle-portrait')?.addEventListener('change', (e) => {
    updatePortraitMode(e.target.checked);
  });

  document.getElementById('toggle-faceless')?.addEventListener('change', (e) => {
    updateFacelessMode(e.target.checked);
  });

  document.getElementById('toggle-brand-color')?.addEventListener('change', (e) => {
    updateBrandColorMode(e.target.checked);
  });

  document.getElementById('toggle-typography')?.addEventListener('change', (e) => {
    updateTypographyMode(e.target.checked);
  });

  document.getElementById('color-picker-primary')?.addEventListener('input', (e) => {
    applyPrimaryColorChange(e.target.value);
  });

  document.getElementById('color-picker-secondary')?.addEventListener('input', (e) => {
    applySecondaryColorChange(e.target.value);
  });

  const colorHexPrimaryInput = document.getElementById('color-hex-primary');
  if (colorHexPrimaryInput) {
    colorHexPrimaryInput.addEventListener('input', (e) => {
      let val = e.target.value.trim();
      if (val && !val.startsWith('#')) val = '#' + val;
      if (val.length > 7) val = val.slice(0, 7);
      e.target.value = val.toUpperCase();
      if (/^#[0-9A-Fa-f]{6}$/.test(val)) applyPrimaryColorChange(val);
    });
    colorHexPrimaryInput.addEventListener('blur', (e) => {
      let val = e.target.value.trim();
      if (!val || !/^#[0-9A-Fa-f]{6}$/.test(val)) {
        e.target.value = primaryColorHex;
      } else {
        applyPrimaryColorChange(val, true);
      }
    });
  }

  const colorHexSecondaryInput = document.getElementById('color-hex-secondary');
  if (colorHexSecondaryInput) {
    colorHexSecondaryInput.addEventListener('input', (e) => {
      let val = e.target.value.trim();
      if (val && !val.startsWith('#')) val = '#' + val;
      if (val.length > 7) val = val.slice(0, 7);
      e.target.value = val.toUpperCase();
      if (/^#[0-9A-Fa-f]{6}$/.test(val)) applySecondaryColorChange(val);
    });
    colorHexSecondaryInput.addEventListener('blur', (e) => {
      let val = e.target.value.trim();
      if (!val || !/^#[0-9A-Fa-f]{6}$/.test(val)) {
        e.target.value = secondaryColorHex;
      } else {
        applySecondaryColorChange(val, true);
      }
    });
  }

  document.getElementById('font-select-primary')?.addEventListener('change', () => {
    handlePrimaryFontChange();
  });

  document.getElementById('font-custom-primary')?.addEventListener('input', () => {
    handlePrimaryFontChange();
  });

  document.getElementById('font-select-secondary')?.addEventListener('change', () => {
    handleSecondaryFontChange();
  });

  document.getElementById('font-custom-secondary')?.addEventListener('input', () => {
    handleSecondaryFontChange();
  });

  // --- Robust Clipboard Helper with execCommand Fallback ---
  function copyTextSafely(text, successMessage) {
    if (!text) return;
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text)
        .then(() => showToast(successMessage))
        .catch(() => fallbackCopy(text, successMessage));
    } else {
      fallbackCopy(text, successMessage);
    }
  }

  function fallbackCopy(text, successMessage) {
    try {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.left = '-9999px';
      textarea.style.top = '0';
      document.body.appendChild(textarea);
      textarea.focus();
      textarea.select();
      const successful = document.execCommand('copy');
      document.body.removeChild(textarea);
      if (successful) {
        showToast(successMessage);
      } else {
        showToast('⚠️ Gagal menyalin teks otomatis.');
      }
    } catch {
      showToast('⚠️ Gagal menyalin teks otomatis.');
    }
  }

  // --- Copy Visual Prompt ---
  window.copyVisualPrompt = function(type) {
    const el = document.getElementById(`prompt-${type}`);
    const text = el ? (el.innerText || el.textContent || '') : '';
    copyTextSafely(text, '📋 Prompt visual berhasil di-copy!');
  };

  window.copyCarouselFollowUp = function() {
    const sizeInstruction = isPortraitActive
      ? 'rasio 4:5 potret vertikal, ukuran 1080 x 1350 piksel'
      : 'rasio 1:1 persegi/square, ukuran 1080 x 1080 piksel';

    let extraGuide = '';
    if (isFacelessActive) {
      extraGuide += '\n- Karakter manusia: WAJIB faceless (tanpa alis, mata, hidung, mulut — permukaan wajah polos mulus).';
    }
    if (isBrandColorActive) {
      extraGuide += `\n- Warna Brand: Dominan Primary Color ${primaryColorHex} dan aksen Secondary Color ${secondaryColorHex}.`;
    }
    if (isTypographyActive) {
      extraGuide += `\n- Tipografi: Font "${primaryFontVal}" untuk Headline dan "${secondaryFontVal}" untuk Subjudul / Body Text.`;
    }

    const text = `Bagus! Sekarang lanjutkan generate gambar visual untuk SLIDE BERIKUTNYA sesuai alur konten yang sudah kamu buat di atas.

Instruksi:
1. Buatkan dan tampilkan langsung gambar visual untuk slide berikutnya (${sizeInstruction}).
2. Wajib pertahankan konsistensi karakter orang, gaya ilustrasi 3D clay, warna dominan dan aksen brand yang sama persis seperti Slide 1.${extraGuide}
3. Setelah gambar ini selesai, berikan lagi ajakan: "👉 Ketik LANJUT untuk membuat visual slide berikutnya".`;
    copyTextSafely(text, '📋 Prompt Lanjutan Slide 2-5 disalin! Paste ke ChatGPT.');
  };

  // --- Social Media Caption Feature (Dynamic & Context-Aware) ---
  window.renderActiveCaption = function(showFeedback = false) {
    const el = document.getElementById('caption-content');
    if (!el) return;
    const topik = document.getElementById('topik')?.value.trim() || '';
    const audiens = document.getElementById('audiens')?.value.trim() || '';
    const tone = document.getElementById('tone')?.value || 'santai';
    const pasted = document.getElementById('pasted-content')?.value.trim() || '';

    el.textContent = generateDynamicSocialCaption({
      text: pasted,
      topik: topik || 'Strategi Menghasilkan Konten Berdampak',
      audiens,
      tone
    });

    if (showFeedback) {
      showToast('✨ Caption berhasil dirangkum ulang dari naskah artikel!');
    }
  };

  window.copyCaption = function() {
    const el = document.getElementById('caption-content');
    if (!el) return;
    const text = el.textContent || '';
    copyTextSafely(text, '📋 Caption berhasil di-copy! Siap dipaste sebelum posting.');
  };

  // --- Toast ---
  function showToast(msg) {
    const toast = document.getElementById('toast');
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.remove('translate-y-20', 'opacity-0');
    setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0'), 2500);
  }

  // --- Real-time Form Validation (Disable Button until Filled) ---
  function checkStep1Validation() {
    const topik = document.getElementById('topik')?.value.trim();
    const btn = document.getElementById('btn-next-step-1');
    
    const isValid = !!topik;
    if (btn) {
      btn.disabled = !isValid;
      if (isValid) {
        btn.className = 'px-6 py-3 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white rounded-lg font-medium transition-all shadow-md hover:shadow-indigo-600/20 cursor-pointer';
      } else {
        btn.className = 'px-6 py-3 bg-slate-200 text-slate-400 cursor-not-allowed rounded-lg font-medium transition-all';
      }
    }
  }

  function checkStep2Validation() {
    const pasted = document.getElementById('pasted-content')?.value.trim();
    const btn = document.getElementById('btn-next-step-2');
    const isValid = !!pasted;
    if (btn) {
      btn.disabled = !isValid;
      if (isValid) {
        btn.className = 'px-6 py-3 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white rounded-lg font-medium transition-all shadow-md hover:shadow-indigo-600/20 cursor-pointer';
      } else {
        btn.className = 'px-6 py-3 bg-slate-200 text-slate-400 cursor-not-allowed rounded-lg font-medium transition-all';
      }
    }
  }

  function checkDirectArticleValidation() {
    const content = document.getElementById('direct-article-content')?.value.trim();
    const btn = document.getElementById('btn-direct-process');
    const isValid = !!content;
    if (btn) {
      btn.disabled = !isValid;
      if (isValid) {
        btn.className = 'w-full sm:w-auto px-6 py-3 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2 shadow-md hover:shadow-indigo-600/20 cursor-pointer';
      } else {
        btn.className = 'w-full sm:w-auto px-6 py-3 bg-slate-200 text-slate-400 cursor-not-allowed rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2 shadow-xs';
      }
    }
  }

  ['topik', 'audiens', 'tujuan'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', checkStep1Validation);
  });
  document.getElementById('pasted-content')?.addEventListener('input', checkStep2Validation);
  document.getElementById('direct-article-content')?.addEventListener('input', checkDirectArticleValidation);

  // --- Auto-select Framework dari URL jika diarahkan dari halaman Framework ---
  function selectFrameworkFromURL() {
    try {
      const params = new URLSearchParams(window.location.search);
      const fw = params.get('framework');
      if (fw) {
        const radio = document.querySelector(`input[name="framework"][value="${fw}"]`);
        if (radio) {
          radio.checked = true;
          document.querySelectorAll('.framework-option').forEach(opt => {
            opt.classList.remove('border-indigo-600', 'bg-indigo-50/60');
            opt.classList.add('border-slate-200');
            const dot = opt.querySelector('.w-2\\.5');
            if (dot) dot.remove();
          });
          const label = radio.closest('label');
          if (label) {
            label.classList.remove('border-slate-200');
            label.classList.add('border-indigo-600', 'bg-indigo-50/60');
            const circle = label.querySelector('.w-5');
            if (circle && !circle.querySelector('.w-2\\.5')) {
              const inner = document.createElement('span');
              inner.className = 'w-2.5 h-2.5 rounded-full bg-indigo-600 text-white';
              circle.appendChild(inner);
            }
          }
        }
      }
    } catch (e) {
      console.warn('Gagal membaca parameter framework dari URL:', e);
    }
  }

  // --- Inisialisasi aman tanpa race condition DOM ---
  function initPromptGenerator() {
    selectFrameworkFromURL();
    checkStep1Validation();
    checkStep2Validation();
    checkDirectArticleValidation();
    renderActiveCaption();

    // Cek parameter URL ?mode=article
    try {
      const params = new URLSearchParams(window.location.search);
      if (params.get('mode') === 'article') {
        switchWorkflowMode('article');
      }
    } catch (e) {
      console.warn('Gagal membaca parameter mode dari URL:', e);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPromptGenerator);
  } else {
    initPromptGenerator();
  }
</script>
