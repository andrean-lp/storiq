---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { FRAMEWORKS } from '../../scripts/prompts.js';

const baseUrl = import.meta.env.BASE_URL;
---

<Base title="API Key SumoPod Generator — STORIQ" description="Generate konten storytelling otomatis menggunakan API Key SumoPod langsung di STORIQ.">
  <Header slot="header" />

  <!-- Top bar with Mode Badge & Switch Link -->
  <div class="bg-navy-900 border-b border-navy-700 py-2.5 px-4 text-xs">
    <div class="max-w-3xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2 text-slate-300">
        <span class="w-2 h-2 rounded-full bg-blue-400"></span>
        <span class="font-semibold text-white">Mode: API Key SumoPod (Otomatis)</span>
      </div>
      <a href={`${baseUrl}generator/`} class="text-blue-400 hover:text-blue-300 transition-colors flex items-center gap-1 font-medium">
        ← Ganti Mode
      </a>
    </div>
  </div>

  <!-- Step Indicator -->
  <div class="bg-navy-800 text-white py-4 px-4">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center justify-between text-xs sm:text-sm" id="step-indicators">
        <button data-step="1" class="step-dot active flex flex-col items-center gap-1">
          <span class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center font-bold">1</span>
          <span class="hidden sm:block">Ide Konten</span>
        </button>
        <div class="flex-1 h-0.5 bg-navy-600 mx-2 sm:mx-4"></div>
        <button data-step="2" class="step-dot flex flex-col items-center gap-1">
          <span class="w-8 h-8 rounded-full bg-navy-600 flex items-center justify-center font-bold">2</span>
          <span class="hidden sm:block">Hasil & Visual</span>
        </button>
      </div>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-8">

    <!-- STEP 1: Input Ide & Status API -->
    <section id="step-1" class="step-panel">
      <h2 class="text-2xl font-bold text-slate-800 mb-1">💡 Masukkan Ide Konten</h2>
      <p class="text-slate-500 mb-6">Tuliskan ide dasarmu. AI SumoPod akan mengembangkannya menjadi artikel storytelling lengkap secara otomatis.</p>

      <div class="space-y-5">
        <div>
          <label for="topik" class="block text-sm font-medium text-slate-700 mb-1">Topik / Ide Utama</label>
          <textarea id="topik" rows="3" placeholder="Contoh: Kenapa landing page yang bagus belum tentu menghasilkan konversi?" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none resize-none text-slate-800"></textarea>
        </div>

        <div>
          <label for="audiens" class="block text-sm font-medium text-slate-700 mb-1">Target Audiens</label>
          <input id="audiens" type="text" placeholder="Contoh: Pemilik bisnis online, marketer pemula" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-slate-800" />
        </div>

        <div>
          <label for="tujuan" class="block text-sm font-medium text-slate-700 mb-1">Tujuan Konten</label>
          <input id="tujuan" type="text" placeholder="Contoh: Edukasi + personal branding" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-slate-800" />
        </div>

        <div>
          <label for="tone" class="block text-sm font-medium text-slate-700 mb-1">Tone / Gaya Bahasa</label>
          <select id="tone" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none bg-white text-slate-800">
            <option value="santai">🗣️ Santai & Friendly</option>
            <option value="profesional">💼 Profesional</option>
            <option value="edukatif">📚 Edukatif & Informatif</option>
            <option value="inspiratif">✨ Inspiratif & Motivasi</option>
            <option value="storytelling">📖 Storytelling (bercerita)</option>
          </select>
        </div>

        <!-- Framework Selection -->
        <div class="mt-8 border-t border-slate-200 pt-8">
          <h3 class="text-lg font-semibold text-slate-700 mb-1">Pilih Framework Storytelling</h3>
          <p class="text-slate-500 mb-6 text-sm">Framework menentukan alur dan struktur psikologi ceritamu.</p>
          <div class="grid gap-3 mb-8" id="framework-options">
            {FRAMEWORKS.map((fw, index) => (
              <label class={`framework-option border-2 rounded-lg p-4 cursor-pointer hover:border-slate-300 ${index === 0 ? 'border-blue-500 bg-blue-50' : 'border-slate-200'}`}>
                <input type="radio" name="framework" value={fw.id} checked={index === 0} class="sr-only" />
                <div class="flex items-start gap-3">
                  <span class={`w-5 h-5 mt-0.5 rounded-full border-2 flex items-center justify-center flex-shrink-0 ${index === 0 ? 'border-blue-500' : 'border-slate-300'}`}>
                    {index === 0 && <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>}
                  </span>
                  <div>
                    <p class="font-semibold text-slate-800">
                      {fw.label} 
                      {index === 0 && <span class="text-xs text-blue-600 bg-blue-100 px-2 py-0.5 rounded-full ml-1">Recommended</span>}
                    </p>
                    <p class="text-sm text-slate-500 mt-0.5">{fw.desc}</p>
                  </div>
                </div>
              </label>
            ))}
          </div>
        </div>
      </div>

      <!-- SumoPod Connection Card & Action Button -->
      <div class="mt-8 border-t border-slate-200 pt-8">
        <input type="hidden" id="provider" value="sumopod" />
        <input type="hidden" id="apikey" value="" />

        <!-- State Connected -->
        <div id="sumopod-state-connected" class="hidden flex-col items-center bg-emerald-50 border border-emerald-200 rounded-2xl p-6 text-center">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-3 h-3 rounded-full bg-emerald-500 animate-ping"></span>
            <span class="font-bold text-emerald-800 text-sm">API Key SumoPod Terhubung</span>
          </div>
          <p class="text-sm text-emerald-700 mb-5 max-w-md">
            Koneksi API SumoPod aktif. Klik tombol di bawah untuk langsung men-generate konten storytelling.
          </p>
          <button id="btn-generate-api" onclick="generateWithAPI()" class="px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold text-lg transition-all shadow-lg shadow-blue-500/30 flex items-center gap-2 hover:scale-[1.02]">
            <span>⚡</span> Mulai Generate Otomatis
          </button>
          <a href={`${baseUrl}pengaturan/`} class="mt-4 text-xs text-slate-500 hover:text-slate-700 underline">
            Kelola atau ganti API Key di Pengaturan
          </a>
        </div>

        <!-- State Disconnected -->
        <div id="sumopod-state-disconnected" class="flex flex-col items-center bg-slate-50 border border-slate-200 rounded-2xl p-6 text-center">
          <span class="px-3 py-1 bg-amber-100 text-amber-800 text-xs font-bold uppercase tracking-wider rounded-full mb-3 border border-amber-200">
            ⚠️ Belum Terhubung
          </span>
          <h3 class="font-bold text-slate-800 text-base mb-1">API Key SumoPod Belum Diisi</h3>
          <p class="text-sm text-slate-500 mb-6 max-w-md">
            Untuk menggunakan mode otomatis ini, kamu perlu memasukkan API Key SumoPod terlebih dahulu di halaman Pengaturan.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href={`${baseUrl}pengaturan/`} class="px-6 py-3 bg-slate-900 hover:bg-blue-600 text-white rounded-lg font-semibold text-sm transition-colors flex items-center justify-center gap-2 shadow-sm">
              ⚙️ Hubungkan API Key di Pengaturan
            </a>
            <a href={`${baseUrl}panduan/`} class="px-6 py-3 bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 rounded-lg font-semibold text-sm transition-colors flex items-center justify-center gap-2">
              📖 Cara Dapat API Key Gratis
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- STEP 2: Hasil & Repurpose Visual -->
    <section id="step-2" class="step-panel hidden">
      <div class="flex items-center justify-between mb-1">
        <h2 class="text-2xl font-bold text-slate-800">✨ Hasil Konten SumoPod</h2>
        <span id="output-format-badge" class="text-xs bg-blue-100 text-blue-700 px-2.5 py-1 rounded-full font-medium">Artikel Blog</span>
      </div>
      <p class="text-slate-500 mb-6">Konten berhasil di-generate secara otomatis via SumoPod AI.</p>

      <!-- Loading State -->
      <div id="output-loading" class="hidden text-center py-16 bg-white border border-slate-200 rounded-2xl">
        <div class="inline-block w-10 h-10 border-4 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
        <p class="mt-4 font-semibold text-slate-700">Sedang men-generate konten dengan SumoPod AI...</p>
        <p class="text-xs text-slate-400 mt-1">Menggunakan model AI terbaik. Ini membutuhkan beberapa detik.</p>
      </div>

      <!-- Error State -->
      <div id="output-error" class="hidden bg-red-50 border border-red-200 rounded-xl p-5 mb-6">
        <p class="text-red-700 font-bold flex items-center gap-2">
          <span>❌</span> Terjadi Kesalahan
        </p>
        <p id="error-message" class="text-sm text-red-600 mt-2"></p>
        <button onclick="goToStep(1)" class="mt-4 px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-lg transition-colors">
          ← Kembali dan Coba Lagi
        </button>
      </div>

      <!-- Output Content -->
      <div id="output-content" class="hidden">
        <!-- Main Generated Article -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm mb-8">
          <div class="flex items-center justify-between px-5 py-3.5 border-b border-slate-100 bg-slate-50 rounded-t-xl">
            <span class="text-xs font-bold text-slate-600 uppercase tracking-wider">Artikel Hasil Generate</span>
            <div class="flex gap-2">
              <button onclick="copyOutput()" class="text-xs px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 font-medium rounded-md transition-colors flex items-center gap-1 shadow-2xs">
                📋 Copy
              </button>
              <button onclick="downloadOutput()" class="text-xs px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 font-medium rounded-md transition-colors flex items-center gap-1 shadow-2xs">
                💾 Download .md
              </button>
            </div>
          </div>
          <div id="output-text" class="px-5 py-5 prose prose-sm max-w-none text-slate-800 whitespace-pre-wrap leading-relaxed"></div>
          <div class="px-5 py-3 bg-blue-50/70 border-t border-slate-100 rounded-b-xl flex items-center gap-2 text-xs text-slate-600">
            <span>💡</span>
            <span><strong>Catatan:</strong> Artikel hasil generate ini bisa langsung kamu gunakan untuk postingan blog di <strong>WordPress</strong>, <strong>Blogger</strong>, <strong>Medium</strong>, maupun <strong>Substack</strong>!</span>
          </div>
        </div>

        <!-- Visual Repurpose Section -->
        <div class="mt-8 border-t border-slate-200 pt-8">
          <div class="bg-blue-50 border border-blue-200 rounded-xl p-5 mb-6">
            <h4 class="font-bold text-blue-900 text-base mb-1">🎨 Repurpose ke Format Visual</h4>
            <p class="text-xs sm:text-sm text-blue-700">Pecah artikel di atas menjadi konten visual. Copy prompt di bawah ini dan paste ke AI favoritmu untuk membuat konsep grafisnya.</p>
          </div>
          
          <div class="space-y-4 mb-8">
            <!-- Single Image -->
            <div class="border border-slate-200 rounded-xl p-4 bg-white shadow-2xs">
              <div class="flex justify-between items-center mb-2">
                <span class="font-semibold text-sm text-slate-800">🖼️ Single Image</span>
                <button onclick="copyVisualPrompt('single')" class="text-xs px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-md font-medium transition-colors">Copy Prompt</button>
              </div>
              <p id="prompt-single" class="text-xs text-slate-500 font-mono bg-slate-50 p-2.5 rounded leading-relaxed">Berdasarkan konten artikel di atas:
1. Rangkum 1 pesan inti & teks copy singkat untuk di dalam gambar.
2. LANGSUNG GENERATE GAMBAR SEKARANG: Buatkan dan tampilkan langsung gambar ilustrasinya (gunakan fitur image generation / DALL-E / Imagen bawaanmu) yang memvisualisasikan konsep tersebut, rasio 1:1 (square), gaya modern, clean, dan relatable.
3. Sertakan juga prompt Bahasa Inggris siap pakai untuk Midjourney / Flux / Ideogram.</p>
            </div>

            <!-- Carousel -->
            <div class="border border-slate-200 rounded-xl p-4 bg-white shadow-2xs">
              <div class="flex justify-between items-center mb-2">
                <span class="font-semibold text-sm text-slate-800">📱 Carousel</span>
                <button onclick="copyVisualPrompt('carousel')" class="text-xs px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-md font-medium transition-colors">Copy Prompt</button>
              </div>
              <p id="prompt-carousel" class="text-xs text-slate-500 font-mono bg-slate-50 p-2.5 rounded leading-relaxed">Berdasarkan konten artikel di atas, tolong pecah menjadi 5-7 slide Carousel. Untuk setiap slide, berikan:
1. Teks Headline (max 10 kata)
2. Teks Body (max 2 kalimat)
3. Visual Direction (ide visual/ikon pendukung yang relevan)</p>
            </div>

            <!-- Infografis -->
            <div class="border border-slate-200 rounded-xl p-4 bg-white shadow-2xs">
              <div class="flex justify-between items-center mb-2">
                <span class="font-semibold text-sm text-slate-800">📊 Infografis</span>
                <button onclick="copyVisualPrompt('infografis')" class="text-xs px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-md font-medium transition-colors">Copy Prompt</button>
              </div>
              <p id="prompt-infografis" class="text-xs text-slate-500 font-mono bg-slate-50 p-2.5 rounded leading-relaxed">Berdasarkan konten artikel di atas, tolong ekstrak data, langkah-langkah, atau poin utama untuk dijadikan desain Infografis. Berikan struktur hierarki informasinya (Judul utama, sub-judul, poin-poin singkat) agar mudah didesain secara visual.</p>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <button onclick="goToStep(1)" class="flex-1 py-3.5 border border-slate-300 text-slate-700 rounded-xl font-semibold hover:bg-slate-50 transition-colors text-sm text-center">
              ✏️ Buat Ide Baru (Mulai dari Awal)
            </button>
            <a href={`${baseUrl}generator/`} class="py-3.5 px-6 border border-slate-200 text-slate-500 hover:text-slate-800 rounded-xl font-semibold hover:bg-slate-50 transition-colors text-sm text-center">
              Ganti Mode Generator
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- Toast Notification -->
  <div id="toast" class="fixed bottom-4 right-4 bg-slate-800 text-white px-4 py-2.5 rounded-lg text-sm shadow-lg transform translate-y-20 opacity-0 transition-all duration-300 z-50"></div>

  <Footer slot="footer" />
</Base>

<style>
  .step-dot.active span:first-child { background-color: #3b82f6; }
  .step-dot.completed span:first-child { background-color: #22c55e; }
</style>

<script>
  import { buildPrompt } from '../../scripts/prompts.js';
  import { generate } from '../../scripts/ai-client.js';
  import { getApiKey } from '../../scripts/storage.js';

  // --- State ---
  let currentStep = 1;
  let abortController = null;

  // --- Step Navigation ---
  window.goToStep = function(step) {
    if (step > 1 && currentStep === 1) {
      const topik = document.getElementById('topik').value.trim();
      if (!topik) {
        showToast('⚠️ Tulis topik dulu ya!');
        document.getElementById('topik').focus();
        return;
      }
    }

    document.querySelectorAll('.step-panel').forEach(p => p.classList.add('hidden'));
    document.getElementById(`step-${step}`)?.classList.remove('hidden');

    // Update indicators
    document.querySelectorAll('.step-dot').forEach(dot => {
      const s = parseInt(dot.dataset.step);
      const circle = dot.querySelector('span:first-child');
      dot.classList.remove('active', 'completed');
      if (s < step) {
        dot.classList.add('completed');
        circle.style.backgroundColor = '#22c55e';
      } else if (s === step) {
        dot.classList.add('active');
        circle.style.backgroundColor = '#3b82f6';
      } else {
        circle.style.backgroundColor = '';
      }
    });

    currentStep = step;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // --- Framework Selection UI ---
  document.getElementById('framework-options')?.addEventListener('change', (e) => {
    document.querySelectorAll('.framework-option').forEach(opt => {
      opt.classList.remove('border-blue-500', 'bg-blue-50');
      opt.classList.add('border-slate-200');
      const dot = opt.querySelector('.w-2\\.5');
      if (dot) dot.remove();
    });
    const label = e.target.closest('label');
    if (label) {
      label.classList.remove('border-slate-200');
      label.classList.add('border-blue-500', 'bg-blue-50');
      const circle = label.querySelector('.w-5');
      if (circle && !circle.querySelector('.w-2\\.5')) {
        const inner = document.createElement('span');
        inner.className = 'w-2.5 h-2.5 rounded-full bg-blue-500';
        circle.appendChild(inner);
      }
    }
  });

  // --- Form Data ---
  function getFormData() {
    return {
      topik: document.getElementById('topik').value.trim(),
      audiens: document.getElementById('audiens').value.trim() || 'Umum',
      tujuan: document.getElementById('tujuan').value.trim() || 'Edukasi',
      tone: document.getElementById('tone').value,
      framework: document.querySelector('input[name="framework"]:checked')?.value || 'storiq10',
      format: 'blog',
    };
  }

  // --- Generate with SumoPod API ---
  window.generateWithAPI = async function() {
    const data = getFormData();
    if (!data.topik) {
      showToast('⚠️ Tulis topik dulu ya!');
      document.getElementById('topik').focus();
      return;
    }

    const provider = document.getElementById('provider').value;
    const apiKey = document.getElementById('apikey').value.trim();

    if (!apiKey) {
      showToast('⚠️ Hubungkan API Key SumoPod di Pengaturan terlebih dahulu!');
      return;
    }

    // Move to step 2 (Hasil)
    goToStep(2);
    document.getElementById('output-loading').classList.remove('hidden');
    document.getElementById('output-content').classList.add('hidden');
    document.getElementById('output-error').classList.add('hidden');

    const prompt = buildPrompt(data);
    const outputEl = document.getElementById('output-text');
    outputEl.textContent = '';

    if (abortController) abortController.abort();
    abortController = new AbortController();

    try {
      await generate({
        provider,
        apiKey,
        prompt,
        signal: abortController.signal,
        onChunk: (chunk) => {
          document.getElementById('output-loading').classList.add('hidden');
          document.getElementById('output-content').classList.remove('hidden');
          outputEl.textContent += chunk;
        },
      });

      document.getElementById('output-loading').classList.add('hidden');
      document.getElementById('output-content').classList.remove('hidden');
      if (!outputEl.textContent) {
        outputEl.textContent = '(Tidak ada output yang dihasilkan. Silakan coba lagi.)';
      }
      showToast('✨ Konten berhasil di-generate!');
    } catch (err) {
      if (err.name === 'AbortError') return;
      document.getElementById('output-loading').classList.add('hidden');
      document.getElementById('output-error').classList.remove('hidden');
      document.getElementById('error-message').textContent = err.message || 'Gagal terhubung ke AI SumoPod. Cek API key dan koneksi internet.';
    }
  };

  // --- Copy & Download ---
  window.copyOutput = function() {
    const text = document.getElementById('output-text').textContent;
    navigator.clipboard.writeText(text).then(() => showToast('📋 Konten berhasil di-copy!'));
  };

  window.downloadOutput = function() {
    const text = document.getElementById('output-text').textContent;
    const blob = new Blob([text], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `storiq-sumopod-${Date.now()}.md`;
    a.click();
    URL.revokeObjectURL(url);
    showToast('💾 File berhasil didownload!');
  };

  // --- Copy Visual Prompt ---
  window.copyVisualPrompt = function(type) {
    const text = document.getElementById(`prompt-${type}`).innerText;
    navigator.clipboard.writeText(text).then(() => showToast('📋 Prompt visual berhasil di-copy!'));
  };

  // --- Toast ---
  function showToast(msg) {
    const toast = document.getElementById('toast');
    toast.textContent = msg;
    toast.classList.remove('translate-y-20', 'opacity-0');
    setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0'), 2500);
  }

  // --- Check API Key on Load ---
  document.addEventListener('DOMContentLoaded', () => {
    const sumopodKey = getApiKey('sumopod');
    const connectedPanel = document.getElementById('sumopod-state-connected');
    const disconnectedPanel = document.getElementById('sumopod-state-disconnected');
    const apiKeyInput = document.getElementById('apikey');

    if (sumopodKey) {
      if (apiKeyInput) apiKeyInput.value = sumopodKey;
      if (connectedPanel) connectedPanel.classList.replace('hidden', 'flex');
      if (disconnectedPanel) disconnectedPanel.classList.replace('flex', 'hidden');
    } else {
      if (apiKeyInput) apiKeyInput.value = '';
      if (connectedPanel) connectedPanel.classList.replace('flex', 'hidden');
      if (disconnectedPanel) disconnectedPanel.classList.replace('hidden', 'flex');
    }
  });
</script>
