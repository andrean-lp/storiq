---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { FRAMEWORKS } from '../../scripts/prompts.js';

const baseUrl = import.meta.env.BASE_URL;
---

<Base title="API Key SumoPod Generator — STORIQ" description="Generate konten storytelling otomatis menggunakan API Key SumoPod langsung di STORIQ.">
  <Header slot="header" />

  <!-- Top bar with Mode Badge & Switch Link -->
  <div class="bg-white border-b border-slate-200/80 py-2.5 px-4 text-xs">
    <div class="max-w-3xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2 text-slate-700">
        <span class="w-2 h-2 rounded-full bg-blue-400"></span>
        <span class="font-bold text-slate-900">Mode: API Key SumoPod (Otomatis)</span>
      </div>
      <a href={`${baseUrl}generator/`} class="text-indigo-600 hover:text-indigo-700 font-semibold transition-colors flex items-center gap-1">
        ← Ganti Mode
      </a>
    </div>
  </div>

  <!-- Step Indicator -->
  <div class="bg-slate-50/90 border-b border-slate-200/80 py-4 px-4">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center justify-between text-xs sm:text-sm" id="step-indicators">
        <button data-step="1" class="step-dot active flex flex-col items-center gap-1 cursor-pointer">
          <span class="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-sm shadow-xs transition-colors">1</span>
          <span class="hidden sm:block font-medium text-xs text-indigo-600">Ide Konten</span>
        </button>
        <div class="flex-1 h-0.5 bg-slate-200 mx-2 sm:mx-4"></div>
        <button data-step="2" class="step-dot flex flex-col items-center gap-1 cursor-pointer">
          <span class="w-8 h-8 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-sm shadow-xs transition-colors">2</span>
          <span class="hidden sm:block font-medium text-xs text-slate-500">Hasil & Visual</span>
        </button>
      </div>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-8">

    <!-- STEP 1: Input Ide & Status API -->
    <section id="step-1" class="step-panel">
      <h2 class="text-2xl font-bold text-slate-800 mb-1">💡 Masukkan Ide Konten</h2>
      <p class="text-slate-500 mb-6">Tuliskan ide dasarmu. AI SumoPod akan mengembangkannya menjadi artikel storytelling lengkap secara otomatis.</p>

      <div class="space-y-5">
        <div>
          <label for="topik" class="block text-sm font-medium text-slate-700 mb-1">Topik / Ide Utama</label>
          <textarea id="topik" rows="3" placeholder="Contoh: Kenapa landing page yang bagus belum tentu menghasilkan konversi?" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none resize-none text-slate-800"></textarea>
        </div>

        <div>
          <label for="audiens" class="block text-sm font-medium text-slate-700 mb-1">Target Audiens</label>
          <input id="audiens" type="text" placeholder="Contoh: Pemilik bisnis online, marketer pemula" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none text-slate-800" />
        </div>

        <div>
          <label for="tujuan" class="block text-sm font-medium text-slate-700 mb-1">Tujuan Konten</label>
          <input id="tujuan" type="text" placeholder="Contoh: Edukasi + personal branding" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none text-slate-800" />
        </div>

        <div>
          <label for="tone" class="block text-sm font-medium text-slate-700 mb-1">Tone / Gaya Bahasa</label>
          <select id="tone" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none bg-white text-slate-800">
            <option value="santai">🗣️ Santai & Friendly</option>
            <option value="profesional">💼 Profesional</option>
            <option value="edukatif">📚 Edukatif & Informatif</option>
            <option value="inspiratif">✨ Inspiratif & Motivasi</option>
            <option value="storytelling">📖 Storytelling (bercerita)</option>
          </select>
        </div>

        <!-- Framework Selection -->
        <div class="mt-8 border-t border-slate-200 pt-8">
          <h3 class="text-lg font-semibold text-slate-700 mb-1">Pilih Framework Storytelling</h3>
          <p class="text-slate-500 mb-6 text-sm">Framework menentukan alur dan struktur psikologi ceritamu.</p>
          <div class="grid gap-3 mb-8" id="framework-options">
            {FRAMEWORKS.map((fw, index) => (
              <label class={`framework-option border-2 rounded-lg p-4 cursor-pointer hover:border-slate-300 ${index === 0 ? 'border-indigo-600 bg-indigo-50/60' : 'border-slate-200'}`}>
                <input type="radio" name="framework" value={fw.id} checked={index === 0} class="sr-only" />
                <div class="flex items-start gap-3">
                  <span class={`w-5 h-5 mt-0.5 rounded-full border-2 flex items-center justify-center flex-shrink-0 ${index === 0 ? 'border-indigo-600' : 'border-slate-300'}`}>
                    {index === 0 && <span class="w-2.5 h-2.5 rounded-full bg-indigo-600 text-white"></span>}
                  </span>
                  <div>
                    <p class="font-semibold text-slate-800">
                      {fw.label} 
                      {index === 0 && <span class="text-xs text-indigo-600 bg-blue-100 px-2 py-0.5 rounded-full ml-1">Recommended</span>}
                    </p>
                    <p class="text-sm text-slate-500 mt-0.5">{fw.desc}</p>
                  </div>
                </div>
              </label>
            ))}
          </div>
        </div>
      </div>

      <!-- SumoPod Connection Card & Action Button -->
      <div class="mt-8 border-t border-slate-200 pt-8">
        <input type="hidden" id="provider" value="sumopod" />
        <input type="hidden" id="apikey" value="" />

        <!-- State Connected -->
        <div id="sumopod-state-connected" class="hidden flex-col items-center bg-emerald-50 border border-emerald-200 rounded-2xl p-6 text-center">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-3 h-3 rounded-full bg-emerald-500 animate-ping"></span>
            <span class="font-bold text-emerald-800 text-sm">API Key SumoPod Terhubung</span>
          </div>
          <p class="text-sm text-emerald-700 mb-5 max-w-md">
            Koneksi API SumoPod aktif. Klik tombol di bawah untuk langsung men-generate konten storytelling.
          </p>
          <button id="btn-generate-api" onclick="generateWithAPI()" disabled class="px-8 py-4 bg-slate-200 text-slate-400 cursor-not-allowed rounded-xl font-bold text-lg transition-all shadow-md flex items-center gap-2">
            <span>⚡</span> Mulai Generate Otomatis
          </button>
          <a href={`${baseUrl}pengaturan/`} class="mt-4 text-xs text-slate-500 hover:text-slate-700 underline">
            Kelola atau ganti API Key di Pengaturan
          </a>
        </div>

        <!-- State Disconnected -->
        <div id="sumopod-state-disconnected" class="flex flex-col items-center bg-slate-50 border border-slate-200 rounded-2xl p-6 text-center">
          <span class="px-3 py-1 bg-amber-100 text-amber-800 text-xs font-bold uppercase tracking-wider rounded-full mb-3 border border-amber-200">
            ⚠️ Belum Terhubung
          </span>
          <h3 class="font-bold text-slate-800 text-base mb-1">API Key SumoPod Belum Diisi</h3>
          <p class="text-sm text-slate-500 mb-6 max-w-md">
            Untuk menggunakan mode otomatis ini, kamu perlu memasukkan API Key SumoPod terlebih dahulu di halaman Pengaturan.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href={`${baseUrl}pengaturan/`} class="px-6 py-3 bg-slate-900 hover:bg-indigo-600 text-white rounded-lg font-semibold text-sm transition-colors flex items-center justify-center gap-2 shadow-sm">
              ⚙️ Hubungkan API Key di Pengaturan
            </a>
            <a href={`${baseUrl}panduan/`} class="px-6 py-3 bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 rounded-lg font-semibold text-sm transition-colors flex items-center justify-center gap-2">
              📖 Cara Dapat API Key SumoPod
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- STEP 2: Hasil & Repurpose Visual -->
    <section id="step-2" class="step-panel hidden">
      <div class="flex items-center justify-between mb-1">
        <h2 class="text-2xl font-bold text-slate-800">✨ Hasil Konten SumoPod</h2>
        <span id="output-format-badge" class="text-xs bg-blue-100 text-indigo-700 px-2.5 py-1 rounded-full font-medium">Artikel Blog</span>
      </div>
      <p class="text-slate-500 mb-6">Konten berhasil di-generate secara otomatis via SumoPod AI.</p>

      <!-- Loading State -->
      <div id="output-loading" class="hidden text-center py-16 bg-white border border-slate-200 rounded-2xl">
        <div class="inline-block w-10 h-10 border-4 border-indigo-600 border-t-transparent rounded-full animate-spin"></div>
        <p class="mt-4 font-semibold text-slate-700">Sedang men-generate konten dengan SumoPod AI...</p>
        <p class="text-xs text-slate-400 mt-1">Menggunakan model AI terbaik. Ini membutuhkan beberapa detik.</p>
      </div>

      <!-- Error State -->
      <div id="output-error" class="hidden bg-red-50 border border-red-200 rounded-xl p-5 mb-6">
        <p class="text-red-700 font-bold flex items-center gap-2">
          <span>❌</span> Terjadi Kesalahan
        </p>
        <p id="error-message" class="text-sm text-red-600 mt-2"></p>
        <button onclick="goToStep(1)" class="mt-4 px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-lg transition-colors">
          ← Kembali dan Coba Lagi
        </button>
      </div>

      <!-- Output Content -->
      <div id="output-content" class="hidden">
        <!-- Main Generated Article -->
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm mb-8">
          <div class="flex items-center justify-between px-5 py-3.5 border-b border-slate-100 bg-slate-50 rounded-t-xl">
            <span class="text-xs font-bold text-slate-600 uppercase tracking-wider">Artikel Hasil Generate</span>
            <div class="flex gap-2">
              <button onclick="copyOutput()" class="text-xs px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 font-medium rounded-md transition-colors flex items-center gap-1 shadow-2xs">
                📋 Copy
              </button>
              <button onclick="downloadOutput()" class="text-xs px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 font-medium rounded-md transition-colors flex items-center gap-1 shadow-2xs">
                💾 Download .md
              </button>
            </div>
          </div>
          <div id="output-text" class="px-5 py-5 prose prose-sm max-w-none text-slate-800 whitespace-pre-wrap leading-relaxed"></div>
          <div class="px-5 py-3 bg-indigo-50/60/70 border-t border-slate-100 rounded-b-xl flex items-center gap-2 text-xs text-slate-600">
            <span>💡</span>
            <span><strong>Catatan:</strong> Artikel hasil generate ini bisa langsung kamu gunakan untuk postingan blog di <strong>WordPress</strong>, <strong>Blogger</strong>, <strong>Medium</strong>, maupun <strong>Substack</strong>!</span>
          </div>
        </div>

        <!-- Visual Repurpose Section -->
        <div class="mt-8 border-t border-slate-200 pt-8">
          <div class="bg-indigo-50/60 border border-indigo-200 rounded-xl p-5 mb-5">
            <h4 class="font-bold text-blue-900 text-base mb-1">🎨 Repurpose ke Format Visual</h4>
            <p class="text-xs sm:text-sm text-indigo-700">Pecah artikel di atas menjadi konten visual. Copy prompt di bawah ini dan paste ke AI favoritmu untuk membuat konsep grafisnya.</p>
          </div>

          <!-- Opsi Pengaturan Visual: Karakter Tanpa Wajah & Warna Utama Brand -->
          <div class="space-y-3 mb-6">
            <!-- Fitur Karakter Tanpa Wajah (Faceless) -->
            <div class="p-4 bg-white border border-slate-200 hover:border-indigo-300 rounded-xl transition-all shadow-2xs">
              <label class="flex items-start gap-3.5 cursor-pointer select-none">
                <div class="flex items-center h-5 mt-0.5">
                  <input
                    type="checkbox"
                    id="toggle-faceless-sumopod"
                    class="w-5 h-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-0 cursor-pointer transition-all"
                  />
                </div>
                <div class="flex-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-sm font-bold text-slate-800 flex items-center gap-1.5">
                      👤 Karakter Tanpa Wajah (Faceless Illustration)
                    </span>
                    <span class="text-[11px] font-semibold px-2.5 py-0.5 bg-amber-50 text-amber-700 rounded-full border border-amber-200">
                      Tanpa Alis, Mata, Hidung & Mulut
                    </span>
                  </div>
                  <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
                    Centang untuk <strong>menghilangkan alis, mata, hidung, dan mulut</strong> saat generate gambar berkarakter manusia (gaya ilustrasi 3D clay / flat vector tanpa fitur wajah — sangat cocok untuk infografis edukatif, modern, dan syar'i).
                  </p>
                </div>
              </label>
            </div>

            <!-- Fitur Warna Utama Brand (Primary Brand Color) -->
            <div class="p-4 bg-white border border-slate-200 hover:border-indigo-300 rounded-xl transition-all shadow-2xs">
              <label class="flex items-start gap-3.5 cursor-pointer select-none">
                <div class="flex items-center h-5 mt-0.5">
                  <input
                    type="checkbox"
                    id="toggle-brand-color-sumopod"
                    class="w-5 h-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-0 cursor-pointer transition-all"
                  />
                </div>
                <div class="flex-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-sm font-bold text-slate-800 flex items-center gap-1.5">
                      🎨 Warna Utama Brand (Primary Brand Color)
                    </span>
                    <span class="text-[11px] font-semibold px-2.5 py-0.5 bg-indigo-50 text-indigo-700 rounded-full border border-indigo-200/60">
                      Seragamkan Feed Sosmed
                    </span>
                  </div>
                  <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
                    Centang untuk menetapkan <strong>kode warna utama brand</strong> (contoh: <code class="bg-slate-100 text-indigo-700 px-1 py-0.5 rounded text-[11px] font-mono">#4F46E5</code> atau <code class="bg-slate-100 text-indigo-700 px-1 py-0.5 rounded text-[11px] font-mono">#0055A5</code>) agar seluruh gambar dan cover memiliki nuansa warna yang seragam di Instagram, LinkedIn, & blog.
                  </p>
                </div>
              </label>

              <!-- Color Input Area (Muncul saat dicentang) -->
              <div id="brand-color-container-sumopod" class="mt-3 pt-3 border-t border-slate-100 hidden">
                <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                  <div class="flex items-center gap-2.5">
                    <div class="relative w-10 h-10 rounded-lg overflow-hidden border border-slate-300 shadow-2xs shrink-0 cursor-pointer">
                      <input
                        type="color"
                        id="color-picker-sumopod"
                        value="#4F46E5"
                        class="absolute -top-2 -left-2 w-14 h-14 cursor-pointer border-0 p-0"
                        title="Klik untuk memilih warna dari palet"
                      />
                    </div>
                    <div class="relative">
                      <input
                        type="text"
                        id="color-hex-sumopod"
                        value="#4F46E5"
                        placeholder="#4F46E5"
                        maxlength="7"
                        class="w-28 px-3 py-2 border border-slate-300 rounded-lg text-xs font-mono font-bold text-slate-800 uppercase focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none"
                      />
                    </div>
                  </div>

                  <!-- Quick Presets -->
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-[11px] text-slate-400 mr-1 font-medium">Preset Cepat:</span>
                    <button type="button" onclick="setBrandColorPresetSumopod('#4F46E5')" class="w-6 h-6 rounded-full bg-[#4F46E5] hover:scale-110 transition-transform shadow-xs cursor-pointer" title="Indigo (#4F46E5)"></button>
                    <button type="button" onclick="setBrandColorPresetSumopod('#2563EB')" class="w-6 h-6 rounded-full bg-[#2563EB] hover:scale-110 transition-transform shadow-xs cursor-pointer" title="Royal Blue (#2563EB)"></button>
                    <button type="button" onclick="setBrandColorPresetSumopod('#0284C7')" class="w-6 h-6 rounded-full bg-[#0284C7] hover:scale-110 transition-transform shadow-xs cursor-pointer" title="Sky Cyan (#0284C7)"></button>
                    <button type="button" onclick="setBrandColorPresetSumopod('#059669')" class="w-6 h-6 rounded-full bg-[#059669] hover:scale-110 transition-transform shadow-xs cursor-pointer" title="Emerald (#059669)"></button>
                    <button type="button" onclick="setBrandColorPresetSumopod('#EA580C')" class="w-6 h-6 rounded-full bg-[#EA580C] hover:scale-110 transition-transform shadow-xs cursor-pointer" title="Orange (#EA580C)"></button>
                    <button type="button" onclick="setBrandColorPresetSumopod('#DC2626')" class="w-6 h-6 rounded-full bg-[#DC2626] hover:scale-110 transition-transform shadow-xs cursor-pointer" title="Red (#DC2626)"></button>
                    <button type="button" onclick="setBrandColorPresetSumopod('#0F172A')" class="w-6 h-6 rounded-full bg-[#0F172A] hover:scale-110 transition-transform shadow-xs cursor-pointer" title="Dark Slate (#0F172A)"></button>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Label Kategori: Format Generate Gambar (Visual AI) -->
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-indigo-700 bg-indigo-50 border border-indigo-200/80 px-3 py-1 rounded-lg flex items-center gap-1.5">
              🎨 Format Generate Gambar (Visual AI)
            </span>
            <span class="text-[11px] text-slate-500 hidden sm:inline">Menerapkan opsi tanpa wajah & warna brand di atas</span>
          </div>

          <div class="space-y-4 mb-6">
            <!-- Single Image -->
            <div class="border border-slate-200 rounded-xl p-4 bg-white shadow-2xs">
              <div class="flex justify-between items-center mb-2">
                <span class="font-semibold text-sm text-slate-800">🖼️ Single Image</span>
                <button onclick="copyVisualPrompt('single')" class="text-xs px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-md font-medium transition-colors cursor-pointer">Copy Prompt</button>
              </div>
              <p id="prompt-single" class="text-xs text-slate-500 font-mono bg-slate-50 p-2.5 rounded leading-relaxed">Berdasarkan konten artikel di atas:
1. Rangkum 1 pesan inti & teks copy singkat untuk di dalam gambar.
2. LANGSUNG GENERATE GAMBAR SEKARANG: Buatkan dan tampilkan langsung gambar ilustrasinya (gunakan fitur image generation / DALL-E / Imagen bawaanmu) yang memvisualisasikan konsep tersebut, rasio 1:1 (square), gaya modern, clean, dan relatable.
3. Sertakan juga prompt Bahasa Inggris siap pakai untuk Midjourney / Flux / Ideogram.</p>
            </div>

            <!-- Carousel -->
            <div class="border border-slate-200 rounded-xl p-4 bg-white shadow-2xs">
              <div class="flex justify-between items-center mb-2">
                <span class="font-semibold text-sm text-slate-800">📱 Carousel</span>
                <button onclick="copyVisualPrompt('carousel')" class="text-xs px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-md font-medium transition-colors cursor-pointer">Copy Prompt</button>
              </div>
              <p id="prompt-carousel" class="text-xs text-slate-500 font-mono bg-slate-50 p-2.5 rounded leading-relaxed">Berdasarkan konten artikel di atas:
1. Susun alur 5 slide Carousel (Headline max 10 kata + Body max 2 kalimat untuk tiap slide).
2. LANGSUNG GENERATE GAMBAR COVER SEKARANG: Buatkan dan tampilkan langsung gambar desain visual untuk SLIDE 1 (Cover / Hook) yang paling eye-catching (gunakan fitur image generation / DALL-E / Imagen bawaanmu), rasio 1:1 atau 4:5 portrait, gaya clean & modern.
3. Sertakan prompt Bahasa Inggris untuk slide berikutnya jika ingin di-generate satu per satu.</p>
            </div>

            <!-- Infografis -->
            <div class="border border-slate-200 rounded-xl p-4 bg-white shadow-2xs">
              <div class="flex justify-between items-center mb-2">
                <span class="font-semibold text-sm text-slate-800">📊 Infografis</span>
                <button onclick="copyVisualPrompt('infografis')" class="text-xs px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-md font-medium transition-colors cursor-pointer">Copy Prompt</button>
              </div>
              <p id="prompt-infografis" class="text-xs text-slate-500 font-mono bg-slate-50 p-2.5 rounded leading-relaxed">Berdasarkan konten artikel di atas:
1. Rangkum poin-poin utama, data, atau langkah-langkah secara terstruktur dan ringkas.
2. LANGSUNG GENERATE GAMBAR SEKARANG: Buatkan dan render langsung visual desain poster INFOGRAFIS lengkap (format vertikal 9:16 atau 4:5, gaya clean, modern, informatif dengan ikon/elemen visual pendukung) menggunakan fitur image generation / DALL-E / Imagen bawaanmu.
3. Sertakan juga prompt Bahasa Inggris siap pakai untuk Midjourney / Flux / Ideogram.</p>
            </div>
          </div>

          <!-- Garis Pemisah Antara Format Gambar dan Format Naskah/Teks -->
          <div class="relative my-8">
            <div class="absolute inset-0 flex items-center" aria-hidden="true">
              <div class="w-full border-t border-slate-200"></div>
            </div>
            <div class="relative flex justify-center">
              <span class="bg-white px-4 py-1.5 text-xs font-bold text-slate-700 rounded-full border border-slate-200 shadow-2xs flex items-center gap-1.5">
                ✍️ Format Naskah & Teks (Tanpa Generate Gambar)
              </span>
            </div>
          </div>

          <div class="space-y-4 mb-6">
            <!-- Threads -->
            <div class="border border-slate-200 rounded-xl p-4 bg-white shadow-2xs">
              <div class="flex justify-between items-center mb-2">
                <span class="font-semibold text-sm text-slate-800">🧵 Threads</span>
                <button onclick="copyVisualPrompt('threads')" class="text-xs px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-md font-medium transition-colors cursor-pointer">Copy Prompt</button>
              </div>
              <p id="prompt-threads" class="text-xs text-slate-500 font-mono bg-slate-50 p-2.5 rounded leading-relaxed">Berdasarkan konten artikel di atas:
1. Rangkum dan ubah menjadi serial postingan Threads / Twitter (3-5 post ringkas, punchy, dan padat insight).
2. Buat Hook memikat di post pertama, 2-3 post inti daging (maksimal 2-3 kalimat per post agar nyaman dibaca cepat), dan 1 post penutup yang mengundang diskusi/komentar.
3. Fokus murni pada kekuatan tulisan / copywriting saja (tidak perlu generate gambar).</p>
            </div>

            <!-- YouTube Video Script -->
            <div class="border border-slate-200 rounded-xl p-4 bg-white shadow-2xs">
              <div class="flex justify-between items-center mb-2">
                <span class="font-semibold text-sm text-slate-800">▶️ YouTube Video Script</span>
                <button onclick="copyVisualPrompt('youtube')" class="text-xs px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-md font-medium transition-colors cursor-pointer">Copy Prompt</button>
              </div>
              <p id="prompt-youtube" class="text-xs text-slate-500 font-mono bg-slate-50 p-2.5 rounded leading-relaxed">Berdasarkan konten artikel di atas:
1. Susun Video Script YouTube lengkap (durasi 5-8 menit, gaya storytelling edukatif dan engaging).
2. Buat struktur naskah:
   - [0:00-0:30] Hook 15-30 detik pertama (visual pattern interrupt + kalimat pemantik rasa ingin tahu).
   - [0:30-1:30] Intro & Masalah Utama (Validasi rasa frustrasi penonton).
   - [1:30-6:00] 3-4 Poin Daging / Solusi (Lengkap dengan instruksi Visual/B-roll dan Voiceover/Audio).
   - [6:00-7:00] Ringkasan & Actionable Takeaway.
   - [7:00-selesai] CTA (Subscribe, like, dan ajakan cek link di deskripsi).
3. Berikan juga 3 opsi Judul Video High-CTR serta deskripsi video siap pakai (termasuk 3 hashtag utama).</p>
            </div>
          </div>

          <!-- Pemberitahuan Rekomendasi ChatGPT Go -->
          <div class="px-4 py-3.5 bg-emerald-50/90 border border-emerald-200 rounded-xl mb-6 flex items-start gap-3 shadow-2xs">
            <span class="text-xl shrink-0 mt-0.5">🚀</span>
            <div class="text-xs sm:text-sm leading-relaxed text-emerald-950">
              <strong class="text-emerald-800">Tips Hasil Optimal:</strong> Copy prompt visual di atas lalu paste ke <strong>ChatGPT Go</strong> (atau ChatGPT Plus) untuk fitur generate gambar langsung bawaan AI yang jauh lebih tajam, batas kuota lebih banyak, dan pemahaman instruksi prompt yang lebih presisi.
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <button onclick="goToStep(1)" class="flex-1 py-3.5 border border-slate-300 text-slate-700 rounded-xl font-semibold hover:bg-slate-50 transition-colors text-sm text-center">
              ✏️ Buat Ide Baru (Mulai dari Awal)
            </button>
            <a 
              href="https://wa.me/6285187437036?text=Kirim%20testimoni%20STORIQ" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="py-3.5 px-6 border border-indigo-200 hover:border-indigo-400 bg-indigo-50/70 hover:bg-indigo-100/80 text-indigo-600 hover:text-indigo-700 rounded-xl font-semibold transition-all text-sm text-center flex items-center justify-center gap-1.5 shadow-2xs"
            >
              💬 Kirim Testimoni
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- Toast Notification -->
  <div id="toast" class="fixed bottom-4 right-4 bg-slate-800 text-white px-4 py-2.5 rounded-lg text-sm shadow-lg transform translate-y-20 opacity-0 transition-all duration-300 z-50"></div>

  <Footer slot="footer" />
</Base>

<style>
  .step-dot.active span:first-child { 
    background-color: #4f46e5 !important; 
    color: #ffffff !important; 
  }
  .step-dot.active span:last-child { 
    color: #4f46e5 !important; 
    font-weight: 700 !important; 
  }
  .step-dot.completed span:first-child { 
    background-color: #10b981 !important; 
    color: #ffffff !important; 
  }
  .step-dot.completed span:last-child { 
    color: #10b981 !important; 
    font-weight: 600 !important; 
  }
</style>

<script>
  import { buildPrompt } from '../../scripts/prompts.js';
  import { generate } from '../../scripts/ai-client.js';
  import { getApiKey } from '../../scripts/storage.js';

  // --- State ---
  let currentStep = 1;
  let abortController = null;

  // --- Step Navigation ---
  window.goToStep = function(step) {
    if (step > 1 && currentStep === 1) {
      const topik = document.getElementById('topik').value.trim();
      if (!topik) {
        showToast('⚠️ Tulis topik dulu ya!');
        document.getElementById('topik').focus();
        return;
      }
    }

    document.querySelectorAll('.step-panel').forEach(p => p.classList.add('hidden'));
    document.getElementById(`step-${step}`)?.classList.remove('hidden');

    // Update indicators
    document.querySelectorAll('.step-dot').forEach(dot => {
      const s = parseInt(dot.dataset.step);
      const circle = dot.querySelector('span:first-child');
      const label = dot.querySelector('span:last-child');
      dot.classList.remove('active', 'completed');
      if (s < step) {
        dot.classList.add('completed');
        circle.style.backgroundColor = '#10b981';
        circle.style.color = '#ffffff';
        if (label) {
          label.style.color = '#10b981';
          label.style.fontWeight = '600';
        }
      } else if (s === step) {
        dot.classList.add('active');
        circle.style.backgroundColor = '#4f46e5';
        circle.style.color = '#ffffff';
        if (label) {
          label.style.color = '#4f46e5';
          label.style.fontWeight = '700';
        }
      } else {
        circle.style.backgroundColor = '';
        circle.style.color = '';
        if (label) {
          label.style.color = '';
          label.style.fontWeight = '';
        }
      }
    });

    currentStep = step;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // --- Framework Selection UI ---
  document.getElementById('framework-options')?.addEventListener('change', (e) => {
    document.querySelectorAll('.framework-option').forEach(opt => {
      opt.classList.remove('border-indigo-600', 'bg-indigo-50/60');
      opt.classList.add('border-slate-200');
      const dot = opt.querySelector('.w-2\\.5');
      if (dot) dot.remove();
    });
    const label = e.target.closest('label');
    if (label) {
      label.classList.remove('border-slate-200');
      label.classList.add('border-indigo-600', 'bg-indigo-50/60');
      const circle = label.querySelector('.w-5');
      if (circle && !circle.querySelector('.w-2\\.5')) {
        const inner = document.createElement('span');
        inner.className = 'w-2.5 h-2.5 rounded-full bg-indigo-600 text-white';
        circle.appendChild(inner);
      }
    }
  });

  // --- Form Data ---
  function getFormData() {
    return {
      topik: document.getElementById('topik').value.trim(),
      audiens: document.getElementById('audiens').value.trim() || 'Umum',
      tujuan: document.getElementById('tujuan').value.trim() || 'Edukasi',
      tone: document.getElementById('tone').value,
      framework: document.querySelector('input[name="framework"]:checked')?.value || 'storiq10',
      format: 'blog',
    };
  }

  // --- Generate with SumoPod API ---
  window.generateWithAPI = async function() {
    const data = getFormData();
    if (!data.topik) {
      showToast('⚠️ Tulis topik dulu ya!');
      document.getElementById('topik').focus();
      return;
    }

    const provider = document.getElementById('provider').value;
    const apiKey = document.getElementById('apikey').value.trim();

    if (!apiKey) {
      showToast('⚠️ Hubungkan API Key SumoPod di Pengaturan terlebih dahulu!');
      return;
    }

    // Move to step 2 (Hasil)
    goToStep(2);
    document.getElementById('output-loading').classList.remove('hidden');
    document.getElementById('output-content').classList.add('hidden');
    document.getElementById('output-error').classList.add('hidden');

    const prompt = buildPrompt(data);
    const outputEl = document.getElementById('output-text');
    outputEl.textContent = '';

    if (abortController) abortController.abort();
    abortController = new AbortController();

    try {
      await generate({
        provider,
        apiKey,
        prompt,
        signal: abortController.signal,
        onChunk: (chunk) => {
          document.getElementById('output-loading').classList.add('hidden');
          document.getElementById('output-content').classList.remove('hidden');
          outputEl.textContent += chunk;
        },
      });

      document.getElementById('output-loading').classList.add('hidden');
      document.getElementById('output-content').classList.remove('hidden');
      if (!outputEl.textContent) {
        outputEl.textContent = '(Tidak ada output yang dihasilkan. Silakan coba lagi.)';
      }
      showToast('✨ Konten berhasil di-generate!');
    } catch (err) {
      if (err.name === 'AbortError') return;
      document.getElementById('output-loading').classList.add('hidden');
      document.getElementById('output-error').classList.remove('hidden');
      document.getElementById('error-message').textContent = err.message || 'Gagal terhubung ke AI SumoPod. Cek API key dan koneksi internet.';
    }
  };

  // --- Copy & Download ---
  window.copyOutput = function() {
    const text = document.getElementById('output-text').textContent;
    navigator.clipboard.writeText(text).then(() => showToast('📋 Konten berhasil di-copy!'));
  };

  window.downloadOutput = function() {
    const text = document.getElementById('output-text').textContent;
    const blob = new Blob([text], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `storiq-sumopod-${Date.now()}.md`;
    a.click();
    URL.revokeObjectURL(url);
    showToast('💾 File berhasil didownload!');
  };

  // --- Visual Settings (Faceless & Brand Color) ---
  let isFacelessActiveSumopod = false;
  let isBrandColorActiveSumopod = false;
  let brandColorHexSumopod = '#4F46E5';

  function sanitizeHex(val) {
    let cleaned = val.trim();
    if (!cleaned.startsWith('#')) cleaned = '#' + cleaned;
    if (cleaned.length > 7) cleaned = cleaned.slice(0, 7);
    return cleaned.toUpperCase();
  }

  function getVisualPromptSumopod(type, isFaceless, isColorActive, colorHex) {
    const prefix = 'Berdasarkan konten artikel di atas:';
    const colorInstruction = isColorActive
      ? `\n* WARNA UTAMA BRAND: Wajib terapkan warna primer brand kode hex ${colorHex} (beserta palet aksen turunan senada) sebagai warna dominan pada elemen grafis, badge teks, latar/frame, atau pakaian karakter agar feed media sosial seragam dan konsisten.`
      : '';
    const colorEnglish = isColorActive
      ? `, primary brand color hex ${colorHex}, cohesive brand visual identity palette`
      : '';

    if (type === 'single') {
      const faceInstruction = isFaceless
        ? `\n* PENTING (ATURAN WAJAH): Jika terdapat karakter / figur manusia dalam gambar, WAJIB dibuat TANPA fitur wajah (FACELESS: hilangkan alis, mata, hidung, dan mulut — permukaan wajah polos mulus / blank smooth face, hanya rambut, telinga, pakaian, dan gestur tubuh yang tampak, gaya 3D clay / clean vector seperti poster infografis edukatif).`
        : '';
      const faceEnglish = isFaceless
        ? ', faceless minimalist character, blank smooth face, no facial features, no eyes, no eyebrows, no nose, no mouth'
        : '';

      return `${prefix}
1. Rangkum 1 pesan inti & teks copy singkat untuk di dalam gambar.
2. LANGSUNG GENERATE GAMBAR SEKARANG: Buatkan dan tampilkan langsung gambar ilustrasinya (gunakan fitur image generation / DALL-E / Imagen bawaanmu) yang memvisualisasikan konsep tersebut, rasio 1:1 (square), gaya modern, clean, dan relatable.${faceInstruction}${colorInstruction}
3. Sertakan juga prompt Bahasa Inggris siap pakai untuk Midjourney / Flux / Ideogram (tambahkan deskripsi: "modern 3D clay illustration, clean aesthetic${faceEnglish}${colorEnglish}").`;
    }

    if (type === 'carousel') {
      const faceInstruction = isFaceless
        ? `\n* PENTING (ATURAN WAJAH): Jika ada ilustrasi karakter manusia pada cover/slide, WAJIB dibuat TANPA fitur wajah (FACELESS: hilangkan alis, mata, hidung, dan mulut — wajah polos mulus / blank smooth face, gaya 3D infografis modern).`
        : '';
      const faceEnglish = isFaceless
        ? ', faceless character, blank smooth face, no eyes, no eyebrows, no nose, no mouth'
        : '';

      return `${prefix}
1. Susun alur 5 slide Carousel (Headline max 10 kata + Body max 2 kalimat untuk tiap slide).
2. LANGSUNG GENERATE GAMBAR COVER SEKARANG: Buatkan dan tampilkan langsung gambar desain visual untuk SLIDE 1 (Cover / Hook) yang paling eye-catching (gunakan fitur image generation / DALL-E / Imagen bawaanmu), rasio 1:1 atau 4:5 portrait, gaya clean & modern.${faceInstruction}${colorInstruction}
3. Sertakan prompt Bahasa Inggris untuk slide berikutnya jika ingin di-generate satu per satu (sertakan: "clean modern carousel cover, 3D clay style${faceEnglish}${colorEnglish}").`;
    }

    if (type === 'infografis') {
      const faceInstruction = isFaceless
        ? `\n* PENTING (ATURAN WAJAH): Jika terdapat karakter / figur manusia pada poster infografis, WAJIB dibuat TANPA fitur wajah (FACELESS: hilangkan alis, mata, hidung, dan mulut — permukaan wajah polos mulus / blank smooth face, hanya rambut dan gestur tubuh, gaya 3D infografis edukatif).`
        : '';
      const faceEnglish = isFaceless
        ? ', faceless 3D character, blank smooth face, no facial features, no eyes, no nose, no mouth, no eyebrows'
        : '';

      return `${prefix}
1. Rangkum poin-poin utama, data, atau langkah-langkah secara terstruktur dan ringkas.
2. LANGSUNG GENERATE GAMBAR SEKARANG: Buatkan dan render langsung visual desain poster INFOGRAFIS lengkap (format vertikal 9:16 atau 4:5, gaya clean, modern, informatif dengan ikon/elemen visual pendukung) menggunakan fitur image generation / DALL-E / Imagen bawaanmu.${faceInstruction}${colorInstruction}
3. Sertakan juga prompt Bahasa Inggris siap pakai untuk Midjourney / Flux / Ideogram (sertakan: "educational infographic poster design, modern 3D vector illustration${faceEnglish}${colorEnglish}").`;
    }

    return '';
  }

  function renderVisualPromptsSumopod() {
    ['single', 'carousel', 'infografis'].forEach(type => {
      const el = document.getElementById(`prompt-${type}`);
      if (el) {
        el.innerText = getVisualPromptSumopod(type, isFacelessActiveSumopod, isBrandColorActiveSumopod, brandColorHexSumopod);
      }
    });
  }

  function updateFacelessModeSumopod(active, notify = true) {
    isFacelessActiveSumopod = active;
    const chk = document.getElementById('toggle-faceless-sumopod');
    if (chk) chk.checked = active;

    renderVisualPromptsSumopod();

    if (notify) {
      showToast(active 
        ? '👤 Mode Faceless diaktifkan: Alis, mata, hidung & mulut ditiadakan' 
        : '👤 Mode visual standar diaktifkan'
      );
    }
  }

  function updateBrandColorModeSumopod(active, notify = true) {
    isBrandColorActiveSumopod = active;
    const chk = document.getElementById('toggle-brand-color-sumopod');
    const container = document.getElementById('brand-color-container-sumopod');

    if (chk) chk.checked = active;
    if (container) {
      if (active) container.classList.remove('hidden');
      else container.classList.add('hidden');
    }

    renderVisualPromptsSumopod();

    if (notify) {
      showToast(active 
        ? `🎨 Warna brand (${brandColorHexSumopod}) diaktifkan pada prompt visual!` 
        : '🎨 Warna brand dinonaktifkan'
      );
    }
  }

  function applyBrandColorChangeSumopod(hex, notify = false) {
    const sanitized = sanitizeHex(hex);
    brandColorHexSumopod = sanitized;

    const inputHex = document.getElementById('color-hex-sumopod');
    const picker = document.getElementById('color-picker-sumopod');

    if (inputHex && inputHex.value !== sanitized) inputHex.value = sanitized;
    if (/^#[0-9A-Fa-f]{6}$/.test(sanitized) && picker) {
      picker.value = sanitized;
    }

    renderVisualPromptsSumopod();
    if (notify) {
      showToast(`🎨 Warna brand diubah ke ${sanitized}`);
    }
  }

  window.setBrandColorPresetSumopod = function(hex) {
    applyBrandColorChangeSumopod(hex, true);
    if (!isBrandColorActiveSumopod) {
      updateBrandColorModeSumopod(true, false);
    }
  };

  document.getElementById('toggle-faceless-sumopod')?.addEventListener('change', (e) => {
    updateFacelessModeSumopod(e.target.checked);
  });

  document.getElementById('toggle-brand-color-sumopod')?.addEventListener('change', (e) => {
    updateBrandColorModeSumopod(e.target.checked);
  });

  document.getElementById('color-picker-sumopod')?.addEventListener('input', (e) => {
    applyBrandColorChangeSumopod(e.target.value);
  });

  const colorHexSumopodInput = document.getElementById('color-hex-sumopod');
  if (colorHexSumopodInput) {
    colorHexSumopodInput.addEventListener('input', (e) => {
      let val = e.target.value.trim();
      if (val && !val.startsWith('#')) val = '#' + val;
      if (val.length > 7) val = val.slice(0, 7);
      e.target.value = val.toUpperCase();
      if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
        applyBrandColorChangeSumopod(val);
      }
    });
    colorHexSumopodInput.addEventListener('blur', (e) => {
      let val = e.target.value.trim();
      if (!val || !/^#[0-9A-Fa-f]{6}$/.test(val)) {
        e.target.value = brandColorHexSumopod;
      } else {
        applyBrandColorChangeSumopod(val, true);
      }
    });
  }

  // --- Copy Visual Prompt ---
  window.copyVisualPrompt = function(type) {
    const text = document.getElementById(`prompt-${type}`).innerText;
    navigator.clipboard.writeText(text).then(() => showToast('📋 Prompt visual berhasil di-copy!'));
  };

  // --- Toast ---
  function showToast(msg) {
    const toast = document.getElementById('toast');
    toast.textContent = msg;
    toast.classList.remove('translate-y-20', 'opacity-0');
    setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0'), 2500);
  }

  // --- Form Validation (Disable Button until Filled) ---
  function checkFormValidation() {
    const topik = document.getElementById('topik')?.value.trim();
    const audiens = document.getElementById('audiens')?.value.trim();
    const tujuan = document.getElementById('tujuan')?.value.trim();
    const btn = document.getElementById('btn-generate-api');
    const isValid = !!(topik && audiens && tujuan);

    if (btn) {
      btn.disabled = !isValid;
      if (isValid) {
        btn.className = 'px-8 py-4 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold text-lg transition-all shadow-lg shadow-blue-500/30 flex items-center gap-2 hover:scale-[1.02] cursor-pointer';
      } else {
        btn.className = 'px-8 py-4 bg-slate-200 text-slate-400 cursor-not-allowed rounded-xl font-bold text-lg transition-all shadow-md flex items-center gap-2';
      }
    }
  }

  ['topik', 'audiens', 'tujuan'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', checkFormValidation);
  });

  // --- Check API Key on Load ---
  document.addEventListener('DOMContentLoaded', () => {
    checkFormValidation();
    const sumopodKey = getApiKey('sumopod');
    const connectedPanel = document.getElementById('sumopod-state-connected');
    const disconnectedPanel = document.getElementById('sumopod-state-disconnected');
    const apiKeyInput = document.getElementById('apikey');

    if (sumopodKey) {
      if (apiKeyInput) apiKeyInput.value = sumopodKey;
      if (connectedPanel) connectedPanel.classList.replace('hidden', 'flex');
      if (disconnectedPanel) disconnectedPanel.classList.replace('flex', 'hidden');
    } else {
      if (apiKeyInput) apiKeyInput.value = '';
      if (connectedPanel) connectedPanel.classList.replace('flex', 'hidden');
      if (disconnectedPanel) disconnectedPanel.classList.replace('hidden', 'flex');
    }
  });
</script>
