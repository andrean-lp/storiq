---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<Base title="Pengaturan & Integrasi API - STORIQ">
  <Header slot="header" />

  <!-- HERO -->
    <!-- HERO -->
  <section class="py-14 sm:py-20 text-center max-w-4xl mx-auto px-4">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs font-semibold mb-5">
      <span>⚙️</span>
      <span>Pengaturan &amp; Integrasi</span>
    </div>
    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
      Pengaturan API
    </h1>
    <p class="text-slate-600 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
      Kelola integrasi dan konfigurasi API key kamu secara aman. Seluruh data disimpan secara lokal hanya di browsermu (BYOK).
    </p>
  </section>

  <!-- KONTEN -->
  <section class="py-12 sm:py-16 px-4">
    <div class="max-w-3xl mx-auto">
      
      <div class="bg-white border-2 border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <div class="p-6 sm:p-8 border-b border-slate-100 bg-slate-50 flex items-center justify-between">
          <div>
            <h2 class="text-xl font-bold text-slate-800 mb-1">Integrasi SumoPod BYOK</h2>
            <p class="text-sm text-slate-500">Gunakan API key SumoPod kamu untuk generate konten otomatis (Mode 2).</p>
          </div>
          <span id="sumopod-status-badge" class="px-3 py-1 bg-slate-200 text-slate-600 text-xs font-bold uppercase tracking-wider rounded-full">
            Belum Terhubung
          </span>
        </div>
        
        <div class="p-6 sm:p-8">
          <form id="sumopod-form" onsubmit="saveSumopodKey(event)">
            <label for="apikey-sumopod" class="block text-sm font-semibold text-slate-700 mb-2">API Key SumoPod</label>
            <div class="flex flex-col sm:flex-row gap-3">
              <div class="relative flex-1">
                <input 
                  id="apikey-sumopod" 
                  type="password" 
                  placeholder="Masukkan API key SumoPod kamu..." 
                  class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none text-slate-800 transition-shadow bg-slate-50 focus:bg-white" 
                />
                <button 
                  type="button"
                  onclick="toggleKeyVisibility('apikey-sumopod')" 
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1" 
                  title="Tampilkan/sembunyikan"
                >
                  👁️
                </button>
              </div>
              <button 
                type="submit" 
                class="px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-semibold text-sm transition-colors whitespace-nowrap shadow-sm shadow-blue-500/30"
              >
                Simpan & Hubungkan
              </button>
            </div>
            <p id="sumopod-message" class="mt-3 text-sm hidden"></p>
          </form>

          <div class="mt-8 pt-6 border-t border-slate-100">
            <h3 class="text-sm font-semibold text-slate-700 mb-3">Keamanan Privasi 🔒</h3>
            <ul class="text-sm text-slate-600 space-y-2">
              <li class="flex items-start gap-2">
                <span class="text-green-500">✓</span>
                API key disimpan secara lokal di browser kamu (localStorage).
              </li>
              <li class="flex items-start gap-2">
                <span class="text-green-500">✓</span>
                STORIQ tidak pernah mengirimkan API key kamu ke server kami.
              </li>
              <li class="flex items-start gap-2">
                <span class="text-green-500">✓</span>
                Kamu bisa menghapus kunci API kapan saja dengan mengosongkan form dan menyimpannya.
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Card Penjelasan: Apa Itu SumoPod? -->
      <div class="mt-8 bg-white border-2 border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <div class="p-6 sm:p-8 border-b border-slate-100 bg-slate-50 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-indigo-100/70 text-indigo-700 text-xs font-semibold mb-2">
              <span>🇮🇩</span>
              <span>Karya Anak Bangsa</span>
            </div>
            <h2 class="text-xl font-bold text-slate-800">Apa Itu SumoPod?</h2>
            <p class="text-sm text-slate-500 mt-0.5">Mengenal platform cloud dan AI Gateway yang menggerakkan generator otomatis STORIQ.</p>
          </div>
          <a 
            href="https://sumopod.com/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-1.5 px-4 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 rounded-xl text-xs font-bold transition-colors shrink-0 self-start sm:self-center cursor-pointer"
          >
            <span>Kunjungi sumopod.com</span>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </div>

        <div class="p-6 sm:p-8 space-y-6">
          <!-- Ringkasan Resmi -->
          <div class="prose prose-sm max-w-none text-slate-600 leading-relaxed space-y-3">
            <p>
              <strong class="text-slate-800">SumoPod</strong> (<a href="https://sumopod.com/" target="_blank" rel="noopener noreferrer" class="text-indigo-600 hover:underline font-semibold">sumopod.com</a>) adalah platform cloud modern (*Platform-as-a-Service* / PaaS) yang dikembangkan oleh <strong>PT Koding Kreasi Indonesia (KodingWorks)</strong>. SumoPod dirancang untuk menyederhanakan manajemen kontainer, hosting aplikasi, dan penyediaan <strong>AI API Gateway</strong> bagi developer, bisnis, dan kreator konten di Indonesia.
            </p>
            <p>
              Di dalam ekosistem <strong>STORIQ</strong>, SumoPod bertindak sebagai jembatan cerdas (*AI Gateway*) yang menghubungkan aplikasi dengan model-model kecerdasan buatan kelas dunia (seperti DeepSeek dan model LLM lainnya) secara aman menggunakan konsep <em>Bring Your Own Key</em> (BYOK).
            </p>
          </div>

          <!-- Grid Keunggulan SumoPod -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-xl border border-slate-200/90 bg-slate-50/60 hover:bg-slate-50 transition-colors">
              <div class="flex items-center gap-2 mb-2 font-bold text-slate-800 text-sm">
                <span>⚡</span>
                <h4>AI API OpenAI-Compatible</h4>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                Menyediakan akses mudah dan cepat ke model Generative AI canggih melalui antarmuka API standar industri tanpa konfigurasi yang rumit.
              </p>
            </div>

            <div class="p-4 rounded-xl border border-slate-200/90 bg-slate-50/60 hover:bg-slate-50 transition-colors">
              <div class="flex items-center gap-2 mb-2 font-bold text-slate-800 text-sm">
                <span>🇮🇩</span>
                <h4>Infrastruktur Server Lokal</h4>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                Didukung data center berlatensi rendah di Jakarta dan metode pembayaran lokal (Rupiah & QRIS) tanpa keharusan kartu kredit luar negeri.
              </p>
            </div>

            <div class="p-4 rounded-xl border border-slate-200/90 bg-slate-50/60 hover:bg-slate-50 transition-colors">
              <div class="flex items-center gap-2 mb-2 font-bold text-slate-800 text-sm">
                <span>🔒</span>
                <h4>Privasi & Keamanan Terjamin</h4>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                Kunci API dikelola langsung oleh pengguna dan hanya tersimpan di memori browser lokal, menjaga kerahasiaan data dan kuota penggunaan.
              </p>
            </div>

            <div class="p-4 rounded-xl border border-slate-200/90 bg-slate-50/60 hover:bg-slate-50 transition-colors">
              <div class="flex items-center gap-2 mb-2 font-bold text-slate-800 text-sm">
                <span>🚀</span>
                <h4>Cocok untuk Otomasi Konten</h4>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                Sangat ideal dipasangkan dengan STORIQ untuk mengubah ide mentah menjadi naskah artikel blog panjang, carousel, dan copywriting secara instan.
              </p>
            </div>
          </div>

          <!-- Cara Mendapatkan API Key SumoPod -->
          <div class="pt-6 border-t border-slate-100">
            <h3 class="text-sm font-bold text-slate-800 mb-3 flex items-center gap-2">
              <span>📋</span>
              <span>Cara Mendapatkan API Key SumoPod:</span>
            </h3>
            <ol class="text-xs sm:text-sm text-slate-600 space-y-2.5 list-decimal list-inside pl-1">
              <li class="leading-relaxed">
                Buka website resmi di <a href="https://sumopod.com/" target="_blank" rel="noopener noreferrer" class="text-indigo-600 hover:underline font-semibold">sumopod.com</a> dan lakukan pendaftaran akun (gratis).
              </li>
              <li class="leading-relaxed">
                Masuk ke dashboard akun Anda, lalu navigasikan ke menu <strong>API Keys</strong> / <strong>AI Services</strong>.
              </li>
              <li class="leading-relaxed">
                Klik tombol <strong>Create New API Key</strong>, lalu salin (*copy*) kunci API yang dihasilkan.
              </li>
              <li class="leading-relaxed">
                Kembali ke halaman ini, tempelkan (*paste*) kuncinya ke form di atas, lalu klik <strong>"Simpan & Hubungkan"</strong>.
              </li>
            </ol>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-2xl font-bold mb-3 text-slate-800">API Key Sudah Siap?</h2>
      <p class="text-slate-600 mb-6">Kembali ke Generator untuk mulai membuat konten dengan otomatis.</p>
      <a href={`${baseUrl}generator/`} class="inline-block px-8 py-3.5 bg-slate-800 hover:bg-slate-900 text-white rounded-lg font-semibold text-lg transition-colors shadow-lg shadow-slate-900/20">
        Buka Generator →
      </a>
    </div>
  </section>

  <Footer slot="footer" />

  <script>
    import { saveApiKey, getApiKey, removeApiKey } from '../scripts/storage.js';

    // Password visibility toggle
    window.toggleKeyVisibility = function(inputId) {
      const input = document.getElementById(inputId) as HTMLInputElement;
      if (input.type === 'password') {
        input.type = 'text';
      } else {
        input.type = 'password';
      }
    };

    // Save logic
    window.saveSumopodKey = async function(e) {
      e.preventDefault();
      const input = document.getElementById('apikey-sumopod') as HTMLInputElement;
      const key = input.value.trim();
      const msg = document.getElementById('sumopod-message');
      const btn = e.target.querySelector('button[type="submit"]') as HTMLButtonElement;
      
      if (!key) {
        removeApiKey('sumopod');
        updateStatusBadge(false);
        if(msg) {
          msg.textContent = 'API Key berhasil dihapus.';
          msg.className = 'mt-3 text-sm text-amber-600 block';
          setTimeout(() => msg.classList.add('hidden'), 3000);
        }
        return;
      }

      // Verifying state
      if(btn) {
        btn.disabled = true;
        btn.textContent = 'Memverifikasi...';
        btn.classList.add('opacity-75', 'cursor-not-allowed');
      }
      if(msg) {
        msg.textContent = 'Menghubungkan ke server SumoPod...';
        msg.className = 'mt-3 text-sm text-indigo-600 block';
      }

      try {
        const response = await fetch('https://ai.sumopod.com/v1/models', {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${key}`
          }
        });

        if (response.ok) {
          saveApiKey('sumopod', key);
          updateStatusBadge(true);
          if(msg) {
            msg.textContent = 'Berhasil! API Key valid dan telah tersimpan.';
            msg.className = 'mt-3 text-sm text-green-600 block font-medium';
          }
        } else {
          updateStatusBadge(false);
          removeApiKey('sumopod');
          if(msg) {
            msg.textContent = 'API Key tidak valid. Silakan periksa kembali.';
            msg.className = 'mt-3 text-sm text-red-600 block font-medium';
          }
        }
      } catch (err) {
        updateStatusBadge(false);
        removeApiKey('sumopod');
        if(msg) {
          msg.textContent = 'Terjadi kesalahan jaringan saat memverifikasi API Key.';
          msg.className = 'mt-3 text-sm text-red-600 block font-medium';
        }
      } finally {
        if(btn) {
          btn.disabled = false;
          btn.textContent = 'Simpan & Hubungkan';
          btn.classList.remove('opacity-75', 'cursor-not-allowed');
        }
        setTimeout(() => {
          if(msg) msg.classList.add('hidden');
        }, 4000);
      }
    };

    // UI updater
    function updateStatusBadge(isConnected) {
      const badge = document.getElementById('sumopod-status-badge');
      if (!badge) return;
      
      if (isConnected) {
        badge.textContent = 'Terhubung';
        badge.className = 'px-3 py-1 bg-green-100 text-green-700 text-xs font-bold uppercase tracking-wider rounded-full border border-green-200';
      } else {
        badge.textContent = 'Belum Terhubung';
        badge.className = 'px-3 py-1 bg-slate-200 text-slate-600 text-xs font-bold uppercase tracking-wider rounded-full border border-slate-300';
      }
    }

    // Load initial state
    document.addEventListener('DOMContentLoaded', () => {
      const key = getApiKey('sumopod');
      const input = document.getElementById('apikey-sumopod') as HTMLInputElement;
      if (key && input) {
        input.value = key;
        updateStatusBadge(true);
      } else {
        updateStatusBadge(false);
      }
    });
  </script>
</Base>