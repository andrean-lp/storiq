---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const baseUrl = import.meta.env.BASE_URL;

// 12 fitur utama bergaya Dikasir
const coreFeatures = [
  {
    icon: '💡',
    title: '100% Gratis & Bebas',
    desc: 'Semua fitur terbuka penuh tanpa tier berbayar, paywall tersembunyi, maupun watermark.'
  },
  {
    icon: '📐',
    title: 'Framework Storytelling',
    desc: 'Dibangun di atas formula naratif teruji: STORIQ 10 Elemen, PAS, AIDA, Hero\'s Journey, dan BAB.'
  },
  {
    icon: '⚡',
    title: 'Dua Mode Penggunaan',
    desc: 'Gunakan Mode Manual (Prompt Generator) untuk ChatGPT/Gemini, atau Mode Otomatis via API SumoPod.'
  },
  {
    icon: '🧵',
    title: 'Serial Threads & X',
    desc: 'Pecah ide panjang menjadi utas postingan ringkas, padat insight, dan nyaman dibaca cepat di smartphone.'
  },
  {
    icon: '🎨',
    title: 'Visual Prompt Bawaan',
    desc: 'Langsung render gambar via fitur bawaan AI (DALL-E / Imagen) untuk Single Image, Carousel, dan Infografis.'
  },
  {
    icon: '🔒',
    title: 'Privasi Terjamin (BYOK)',
    desc: 'API Key disimpan aman hanya di browser lokal Anda (localStorage), tidak pernah dikirim ke server luar.'
  },
  {
    icon: '📱',
    title: 'Mobile-First & Ringan',
    desc: 'Antarmuka super cepat dan responsif, nyaman diakses langsung dari ponsel tanpa lag.'
  },
  {
    icon: '🌐',
    title: 'Open Source MIT',
    desc: 'Kode sumber terbuka di GitHub. Bebas Anda fork, modifikasi, dan gunakan untuk kebutuhan komersial.'
  },
  {
    icon: '📝',
    title: 'Artikel Blog & Medium',
    desc: 'Hasilkan artikel 800-1200 kata dengan hook memikat, struktur sub-heading rapi, dan siap publish.'
  },
  {
    icon: '🎬',
    title: 'Skrip Video Pendek',
    desc: 'Dilengkapi panduan visual 0-5 detik penahan scroll untuk TikTok, Instagram Reels, dan YouTube Shorts.'
  },
  {
    icon: '🤖',
    title: 'Dukungan Multi-AI',
    desc: 'Kompatibel dengan model AI terdepan: ChatGPT (OpenAI), Claude, Google Gemini, Llama 3, dan DeepSeek.'
  },
  {
    icon: '🚀',
    title: 'Tanpa Login Apapun',
    desc: 'Langsung buka website dan pakai seketika. Tidak perlu daftar akun, verifikasi email, atau langganan.'
  }
];

const stats = [
  { value: '100%', label: 'Gratis & Bebas Iklan' },
  { value: '10+', label: 'Elemen Storytelling' },
  { value: 'MIT', label: 'Lisensi Open Source' },
  { value: '4+', label: 'Format Repurpose' },
];

const faqs = [
  {
    q: 'Apakah STORIQ benar-benar gratis?',
    a: 'Ya, 100% gratis tanpa biaya tersembunyi. Proyek ini dibangun sebagai kontribusi open source untuk komunitas kreator dan pemilik bisnis di Indonesia.'
  },
  {
    q: 'Bagaimana cara kerja dua mode di STORIQ?',
    a: 'Mode 1 (Prompt Generator) cocok jika Anda ingin meng-copy prompt berkualitas dan menjalankannya langsung di ChatGPT, Gemini, atau Claude. Mode 2 (API Key SumoPod) memungkinkan Anda meng-generate konten langsung di dalam STORIQ secara otomatis menggunakan API key gratis.'
  },
  {
    q: 'Apakah API key saya aman di Mode SumoPod?',
    a: 'Sangat aman. STORIQ adalah aplikasi statis (Client-Side). API Key Anda hanya disimpan di memori browser lokal (localStorage) Anda sendiri dan langsung berkomunikasi ke endpoint penyedia AI tanpa melalui server perantara.'
  },
  {
    q: 'Apakah hasil visual langsung me-render gambar?',
    a: 'Ya! Untuk Single Image, Carousel Instagram, dan Infografis, prompt visual kami sudah dilengkapi perintah render langsung sehingga AI (seperti ChatGPT Plus DALL-E atau Gemini Imagen) akan otomatis menghasilkan gambar.'
  },
  {
    q: 'Apakah konten Threads juga membuat gambar?',
    a: 'Khusus Threads, kami memfokuskan prompt 100% pada kekuatan teks/copywriting (hook, isi daging, dan kalimat pemantik diskusi) karena ekosistem Threads berakar pada kenyamanan membaca teks cepat.'
  }
];
---

<Base
  title="STORIQ — Content Repurposing Engine Berbasis Storytelling"
  description="Ubah satu ide menjadi artikel, carousel, caption, quote, video script — semua berbasis framework storytelling yang terstruktur."
>
  <Header slot="header" />

  <!-- 1. HERO SECTION -->
  <section class="pt-14 pb-16 sm:pt-20 sm:pb-24 overflow-hidden relative text-center">
    <!-- Subtle gradient background glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-gradient-to-b from-indigo-50/70 via-indigo-50/20 to-transparent pointer-events-none -z-10"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <!-- Pill Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs font-semibold mb-6 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>✨ Open Source • 100% Gratis • Tanpa Login</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.18] mb-6">
        Content Repurposing Engine<br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-indigo-600 via-violet-600 to-indigo-500 bg-clip-text text-transparent">
          Gratis & Open Source
        </span>
      </h1>

      <!-- Subheadline -->
      <p class="text-sm sm:text-base md:text-lg text-slate-600 max-w-2xl mx-auto mb-8 leading-relaxed font-normal">
        Ubah satu ide menjadi artikel berbobot, slide carousel, poster infografis, hingga serial threads — semua terstruktur berbasis formula storytelling yang memikat.
      </p>

      <!-- Dual CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full max-w-md mx-auto mb-14">
        <a
          href={`${baseUrl}generator/`}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm shadow-md shadow-indigo-600/20 hover:shadow-indigo-600/30 hover:-translate-y-0.5 transition-all"
        >
          <span>Buka Generator</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href={`${baseUrl}framework/`}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm border border-slate-200 shadow-2xs hover:border-slate-300 transition-all"
        >
          Pelajari Framework
        </a>
      </div>

      <!-- App Mockup Window (macOS style frame) -->
      <div class="max-w-4xl mx-auto rounded-2xl bg-white border border-slate-200/90 shadow-xl shadow-slate-200/60 overflow-hidden text-left">
        <!-- Window Header -->
        <div class="bg-slate-50/90 px-4 py-3 border-b border-slate-200 flex items-center justify-between text-xs text-slate-500">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-rose-400 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-amber-400 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block"></span>
            <span class="ml-2 font-mono text-[11px] text-slate-400 hidden sm:inline-block">storiq.web.id/generator</span>
          </div>
          <div class="flex items-center gap-2 font-medium text-indigo-600 text-xs">
            <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
            <span>Repurposing Active</span>
          </div>
        </div>

        <!-- Window Mockup Body -->
        <div class="p-5 sm:p-7 bg-white grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
          <!-- Input Side -->
          <div class="md:col-span-5 bg-slate-50 rounded-xl p-4 border border-slate-200/70">
            <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
              Input: 1 Ide Dasar
            </div>
            <p class="text-xs sm:text-sm font-semibold text-slate-800 leading-snug mb-3">
              "Cara konsisten bikin konten setiap hari tanpa merasa burnout."
            </p>
            <div class="flex flex-wrap gap-1.5 text-[11px]">
              <span class="bg-white px-2 py-0.5 rounded-md border border-slate-200 text-slate-600 font-medium">📐 STORIQ 10</span>
              <span class="bg-white px-2 py-0.5 rounded-md border border-slate-200 text-slate-600 font-medium">☕ Santai</span>
            </div>
          </div>

          <!-- Process Center Indicator -->
          <div class="md:col-span-2 flex flex-col items-center justify-center text-center py-2">
            <div class="w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-100 text-indigo-600 flex items-center justify-center font-bold text-lg mb-1 shadow-2xs">
              ⚡
            </div>
            <span class="text-[11px] font-bold text-indigo-600 uppercase tracking-wider">STORIQ</span>
          </div>

          <!-- Output Side -->
          <div class="md:col-span-5 bg-slate-50 rounded-xl p-4 border border-slate-200/70">
            <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2 flex items-center justify-between">
              <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                Output Terdistribusi
              </span>
              <span class="text-emerald-600 font-semibold text-[10px]">4+ Format</span>
            </div>
            <div class="grid grid-cols-2 gap-2 text-xs text-slate-700">
              <div class="bg-white p-2 rounded-lg border border-slate-200 flex items-center gap-1.5 shadow-2xs">
                <span>🖼️</span>
                <span class="truncate font-medium">Single Image</span>
              </div>
              <div class="bg-white p-2 rounded-lg border border-slate-200 flex items-center gap-1.5 shadow-2xs">
                <span>📱</span>
                <span class="truncate font-medium">Carousel IG</span>
              </div>
              <div class="bg-white p-2 rounded-lg border border-slate-200 flex items-center gap-1.5 shadow-2xs">
                <span>📊</span>
                <span class="truncate font-medium">Infografis</span>
              </div>
              <div class="bg-white p-2 rounded-lg border border-slate-200 flex items-center gap-1.5 shadow-2xs">
                <span>🧵</span>
                <span class="truncate font-medium">Threads / X</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Stats Bar (4 columns like Dikasir) -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 pt-14 max-w-3xl mx-auto border-t border-slate-200/70 mt-14">
        {stats.map((s) => (
          <div class="text-center">
            <div class="text-2xl sm:text-4xl font-extrabold text-indigo-600 tracking-tight">{s.value}</div>
            <div class="text-xs text-slate-500 font-medium mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. TAMPILAN APLIKASI / MODE SHOWCASE -->
  <section class="py-16 sm:py-20 bg-slate-50/60 border-t border-slate-200/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-xs font-bold text-indigo-600 tracking-wider uppercase mb-2 block">Tampilan Aplikasi</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Dua Mode Fleksibel Sesuai Kenyamananmu
        </h2>
        <p class="mt-3 text-xs sm:text-sm text-slate-600 leading-relaxed">
          Pilih metode manual jika Anda menyukai ChatGPT/Claude, atau metode otomatis jika ingin hasil instan.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <!-- Mode 1 Card -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-7 shadow-2xs hover:shadow-md hover:border-indigo-200 transition-all flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-2xl mb-5">
              📋
            </div>
            <div class="inline-block px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700 text-xs font-bold mb-2">
              Paling Populer
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Prompt Generator (Manual)</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
              Isi ide Anda &rarr; Dapatkan master prompt &rarr; Paste di ChatGPT / Claude / Gemini &rarr; Paste hasil kembali untuk mendapatkan prompt visual.
            </p>
          </div>
          <a
            href={`${baseUrl}generator/prompt-generator/`}
            class="inline-flex items-center justify-center gap-1.5 w-full py-2.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold text-xs sm:text-sm transition-colors"
          >
            <span>Gunakan Prompt Generator</span>
            <span>&rarr;</span>
          </a>
        </div>

        <!-- Mode 2 Card -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-7 shadow-2xs hover:shadow-md hover:border-indigo-200 transition-all flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-2xl mb-5">
              ⚡
            </div>
            <div class="inline-block px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold mb-2">
              Otomatis Sekali Klik
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">API Key SumoPod (Otomatis)</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
              Hubungkan API Key gratis SumoPod (BYOK) &rarr; Klik Generate &rarr; Artikel dan seluruh prompt visual selesai otomatis dalam beberapa detik.
            </p>
          </div>
          <a
            href={`${baseUrl}generator/api-key-sumopod/`}
            class="inline-flex items-center justify-center gap-1.5 w-full py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs sm:text-sm shadow-xs transition-colors"
          >
            <span>Gunakan Mode Otomatis</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. FITUR LENGKAP UNTUK BISNIS NYATA (Grid 12 Kartu bergaya Dikasir) -->
  <section class="py-16 sm:py-24 bg-white border-t border-slate-200/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-xs font-bold text-indigo-600 tracking-wider uppercase mb-2 block">Fitur Lengkap</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Semua yang Kamu Butuhkan untuk Distribusi Konten
        </h2>
        <p class="mt-3 text-xs sm:text-sm text-slate-600 leading-relaxed">
          Dirancang untuk kreator, affiliate marketer, konsultan, dan pemilik bisnis yang ingin hadir di banyak channel tanpa kelelahan.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {coreFeatures.map((f) => (
          <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-2xs hover:shadow-md hover:border-indigo-200 hover:-translate-y-0.5 transition-all duration-150">
            <div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl mb-4">
              {f.icon}
            </div>
            <h3 class="text-base font-bold text-slate-900 mb-2">{f.title}</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. TECH STACK MODERN (Badges Bar seperti Dikasir) -->
  <section class="py-14 bg-slate-50/80 border-t border-slate-200/80 text-center">
    <div class="max-w-4xl mx-auto px-4">
      <span class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4 block">Tech Stack Modern</span>
      <div class="flex flex-wrap justify-center items-center gap-2.5 text-xs font-semibold text-slate-700">
        <span class="px-3.5 py-1.5 rounded-full bg-white border border-slate-200/80 shadow-2xs flex items-center gap-1.5">
          🚀 Astro 5
        </span>
        <span class="px-3.5 py-1.5 rounded-full bg-white border border-slate-200/80 shadow-2xs flex items-center gap-1.5">
          🎨 Tailwind CSS v4
        </span>
        <span class="px-3.5 py-1.5 rounded-full bg-white border border-slate-200/80 shadow-2xs flex items-center gap-1.5">
          ⚡ TypeScript
        </span>
        <span class="px-3.5 py-1.5 rounded-full bg-white border border-slate-200/80 shadow-2xs flex items-center gap-1.5">
          🤖 Google Gemini 2.5
        </span>
        <span class="px-3.5 py-1.5 rounded-full bg-white border border-slate-200/80 shadow-2xs flex items-center gap-1.5">
          🔌 SumoPod AI
        </span>
        <span class="px-3.5 py-1.5 rounded-full bg-white border border-slate-200/80 shadow-2xs flex items-center gap-1.5">
          🐙 GitHub Pages
        </span>
      </div>
    </div>
  </section>

  <!-- 5. INSTALASI DALAM HITUNGAN MENIT (Terminal Box seperti Dikasir) -->
  <section class="py-16 sm:py-20 bg-white border-t border-slate-200/80">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-8">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Jalankan Sendiri dalam Hitungan Menit
        </h2>
        <p class="mt-2 text-xs sm:text-sm text-slate-600">
          Ingin deploy ke server atau domainmu sendiri? Fork dan jalankan dengan mudah.
        </p>
      </div>

      <div class="bg-slate-900 rounded-2xl p-5 sm:p-6 text-slate-200 font-mono text-xs sm:text-sm shadow-xl overflow-x-auto">
        <div class="flex items-center gap-2 pb-3 mb-4 border-b border-slate-800 text-slate-500 text-xs">
          <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
          <span class="ml-2 text-slate-400">Terminal</span>
        </div>
        <pre class="leading-relaxed"><code>git clone https://github.com/andrean-lp/storiq.git
cd storiq
npm install
npm run dev

# Aplikasi aktif di http://localhost:4321/storiq/</code></pre>
      </div>

      <div class="text-center mt-5">
        <a href={`${baseUrl}kontribusi/`} class="text-xs text-indigo-600 hover:text-indigo-700 font-semibold inline-flex items-center gap-1">
          <span>Baca Panduan Kontribusi Lengkap</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 6. PERTANYAAN UMUM (FAQ) -->
  <section class="py-16 sm:py-20 bg-slate-50/60 border-t border-slate-200/80">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Pertanyaan Umum
        </h2>
        <p class="mt-2 text-xs sm:text-sm text-slate-600">
          Jawaban untuk hal-hal yang sering ditanyakan seputar STORIQ.
        </p>
      </div>

      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group bg-white rounded-2xl border border-slate-200/80 p-4 sm:p-5 shadow-2xs open:border-indigo-200 transition-all">
            <summary class="font-bold text-slate-800 text-xs sm:text-sm cursor-pointer list-none flex items-center justify-between gap-4">
              <span>{faq.q}</span>
              <span class="text-slate-400 group-open:rotate-180 transition-transform duration-200 text-base">&darr;</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-3 font-normal">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. BIG CALLOUT BANNER CTA (Indigo Gradient Container seperti Dikasir) -->
  <section class="py-16 sm:py-24 bg-white border-t border-slate-200/80">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="bg-gradient-to-r from-indigo-600 via-indigo-700 to-violet-700 rounded-3xl p-8 sm:p-14 text-center text-white shadow-xl shadow-indigo-600/15 relative overflow-hidden">
        <!-- Glow circles -->
        <div class="absolute -top-24 -right-24 w-72 h-72 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-indigo-400/20 rounded-full blur-2xl pointer-events-none"></div>

        <div class="relative z-10 max-w-xl mx-auto">
          <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight mb-4 text-white">
            Siap Buat Konten dengan STORIQ?
          </h2>
          <p class="text-xs sm:text-sm text-indigo-100 leading-relaxed mb-8">
            Ubah satu ide menjadi puluhan konten bernilai hari ini juga. 100% gratis, tanpa bayar, dan tanpa login.
          </p>

          <div class="flex flex-wrap justify-center items-center gap-3">
            <a
              href={`${baseUrl}generator/`}
              class="px-6 py-3.5 rounded-xl bg-white text-indigo-700 font-bold text-xs sm:text-sm shadow-md hover:bg-indigo-50 hover:-translate-y-0.5 transition-all"
            >
              Buka Generator Sekarang
            </a>
            <a
              href="https://github.com/andrean-lp/storiq"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3.5 rounded-xl bg-white/15 text-white font-bold text-xs sm:text-sm border border-white/20 hover:bg-white/20 transition-all inline-flex items-center gap-1.5"
            >
              ⭐ Star di GitHub
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>
