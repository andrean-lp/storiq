---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const baseUrl = import.meta.env.BASE_URL;

// 6-step workflow data
const workflowSteps = [
  {
    step: '01',
    title: 'Masukkan Ide',
    desc: 'Tuliskan topik bahasan, target audiens, dan tujuan kontenmu — bahkan ide 1-2 kalimat pun cukup.',
    icon: '💡',
    badge: 'Langkah Awal',
  },
  {
    step: '02',
    title: 'Pilih Framework',
    desc: 'Pilih formula storytelling teruji: STORIQ 10 Elemen, PAS, AIDA, atau Before-After-Bridge.',
    icon: '📐',
    badge: 'Strukturasi',
  },
  {
    step: '03',
    title: 'Buat Story Blueprint',
    desc: 'Bangun alur narasi yang kokoh: dari hook yang memikat, konflik yang relatable, hingga resolusi bernilai.',
    icon: '🗺️',
    badge: 'Arsitektur Cerita',
  },
  {
    step: '04',
    title: 'Generate Konten',
    desc: 'Hasilkan draft konten berkualitas tinggi yang mengalir alami dengan tone pilihanmu.',
    icon: '⚡',
    badge: 'Produksi AI',
  },
  {
    step: '05',
    title: 'Pecah ke Content Atoms',
    desc: 'Ekstraksi elemen penting: hook tajam, punchline, quotes berbobot, poin edukatif, dan CTA kuat.',
    icon: '🔬',
    badge: 'Dekomposisi',
  },
  {
    step: '06',
    title: 'Repurpose ke Banyak Format',
    desc: 'Sebarkan ke berbagai format media: artikel, carousel IG, video script, thread, hingga LinkedIn.',
    icon: '🚀',
    badge: 'Multi-Channel',
  },
];

// Output formats
const outputFormats = [
  {
    icon: '📝',
    name: 'Artikel Blog',
    platform: 'Blog & Medium',
    desc: '800-1200 kata dengan hook memikat, struktur sub-heading yang rapi, dan SEO-ready.',
    badge: 'Long-form',
  },
  {
    icon: '📱',
    name: 'Carousel IG',
    platform: 'Instagram & LinkedIn',
    desc: '8-10 slide visual terstruktur: cover pemikat swipe, problem relatable, insight, dan CTA.',
    badge: 'Visual Slides',
  },
  {
    icon: '💬',
    name: 'Caption Social Media',
    platform: 'IG, FB, & Threads',
    desc: 'Hook baris pertama, cerita ringkas bernilai, spasi nyaman dibaca, dan rekomendasi hashtag.',
    badge: 'Micro-content',
  },
  {
    icon: '🎬',
    name: 'Video Script',
    platform: 'TikTok, Reels, & Shorts',
    desc: 'Hook 0-5 detik penahan scroll, narasi 60-120 detik, dilengkapi panduan visual [Visual Note].',
    badge: 'Short Video',
  },
  {
    icon: '🐦',
    name: 'X/Twitter Thread',
    platform: 'X (Twitter)',
    desc: '8-12 cuitan punchy, hook provokatif, satu insight per tweet, dan CTA bookmark.',
    badge: 'Viral Thread',
  },
  {
    icon: '💡',
    name: 'Quote Image',
    platform: 'Story, Feed, & Pin',
    desc: '5-8 kutipan bermakna yang berdiri sendiri (standalone), inspiratif, dan shareable.',
    badge: 'Shareable Quotes',
  },
  {
    icon: '💼',
    name: 'LinkedIn Post',
    platform: 'LinkedIn',
    desc: 'Gaya profesional-personal berformat storytelling, studi kasus, atau pembelajaran karier.',
    badge: 'Professional',
  },
  {
    icon: '📌',
    name: 'Pinterest Pin',
    platform: 'Pinterest',
    desc: 'Judul SEO-friendly tinggi klik, deskripsi targeted, dan 5-8 keyword pencarian relevan.',
    badge: 'SEO Traffic',
  },
];

// Why STORIQ cards
const whyFeatures = [
  {
    icon: '🎁',
    title: '100% Gratis Tanpa Biaya',
    desc: 'Tidak ada tier berbayar, tidak ada paywall tersembunyi, dan tanpa watermark. Semua fitur terbuka penuh.',
  },
  {
    icon: '🌐',
    title: 'Open Source di GitHub',
    desc: 'Kode sumber terbuka di bawah lisensi MIT. Transparan, aman, dan bisa kamu kembangkan sesuka hati.',
  },
  {
    icon: '🤖',
    title: 'Powered by Your Favorite AI',
    desc: 'Hubungkan AI pilihanmu sendiri: Google Gemini, Groq (Llama 3), Mistral, atau OpenRouter secara bebas.',
  },
  {
    icon: '📱',
    title: 'Mobile Friendly & Ringan',
    desc: 'Tampilan responsif dan cepat dibuka di smartphone. Catat dan olah idemu langsung kapan saja di mana saja.',
  },
];
---

<Base
  title="STORIQ — Content Repurposing Engine Berbasis Storytelling"
  description="Ubah satu ide menjadi artikel, carousel, caption, quote, video script — semua berbasis framework storytelling yang terstruktur."
>
  <Header slot="header" />

  <!-- 1. HERO SECTION -->
  <section class="relative bg-gradient-to-b from-navy-900 via-navy-800 to-navy-900 text-white pt-16 pb-20 sm:pt-24 sm:pb-28 overflow-hidden border-b border-navy-700">
    <!-- Ambient background glow decoration -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-blue-600/15 blur-[120px] rounded-full"></div>
      <div class="absolute top-1/2 -right-48 w-80 h-80 bg-blue-500/10 blur-[90px] rounded-full"></div>
      <div class="absolute -bottom-20 -left-48 w-80 h-80 bg-sky-500/10 blur-[90px] rounded-full"></div>
    </div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-400/30 text-blue-300 text-xs sm:text-sm font-medium mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        100% Gratis • Tanpa Login • Langsung Pakai
      </div>

      <!-- Headline -->
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-tight sm:leading-tight md:leading-tight mb-6 text-white">
        Satu Ide. <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-sky-300 to-blue-200">Banyak Peluang.</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-base sm:text-lg md:text-xl text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        Ubah satu ide menjadi artikel, carousel, caption, quote, video script — semua berbasis framework storytelling yang terstruktur.
      </p>

      <!-- Two CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full max-w-md mx-auto mb-14">
        <a
          href={`${baseUrl}generator/`}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-base transition-all shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40 hover:-translate-y-0.5 active:translate-y-0"
        >
          <span>Mulai Sekarang</span>
          <span aria-hidden="true">→</span>
        </a>
        <a
          href={`${baseUrl}framework/`}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-navy-700/80 hover:bg-navy-700 text-slate-200 hover:text-white font-semibold text-base border border-navy-600 hover:border-slate-500 transition-all"
        >
          Pelajari Framework
        </a>
      </div>

      <!-- Hero Visual / Preview Box -->
      <div class="max-w-3xl mx-auto rounded-2xl bg-navy-800/80 border border-navy-700/90 p-5 sm:p-7 shadow-2xl backdrop-blur-sm text-left">
        <div class="flex items-center justify-between border-b border-navy-700 pb-3 mb-5 text-xs text-slate-400">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
            <span class="ml-2 font-mono text-slate-300 font-medium">storiq-repurposing-engine</span>
          </div>
          <span class="text-blue-400 font-medium hidden sm:inline-block">Storytelling Blueprint Ready</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
          <!-- Input Preview -->
          <div class="md:col-span-5 bg-navy-900/90 rounded-xl p-4 border border-navy-700">
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-2 uppercase tracking-wide">
              <span class="w-2 h-2 rounded-full bg-blue-400"></span>
              Input: 1 Ide Dasar
            </div>
            <p class="text-sm text-slate-200 font-medium mb-2">
              "Cara konsisten bikin konten setiap hari tanpa burnout."
            </p>
            <div class="flex flex-wrap gap-1.5 text-[11px] text-slate-400">
              <span class="bg-navy-800 px-2 py-0.5 rounded border border-navy-700">Framework: STORIQ 10</span>
              <span class="bg-navy-800 px-2 py-0.5 rounded border border-navy-700">Tone: Santai</span>
            </div>
          </div>

          <!-- Flow Arrow / Engine Indicator -->
          <div class="md:col-span-2 flex flex-col items-center justify-center py-2 text-blue-400 font-mono text-xs">
            <div class="p-2 rounded-full bg-blue-500/10 border border-blue-400/30 text-blue-400 mb-1">
              <svg class="w-5 h-5 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <span class="text-[11px] font-semibold text-blue-300">STORIQ</span>
          </div>

          <!-- Output Preview -->
          <div class="md:col-span-5 bg-navy-900/90 rounded-xl p-4 border border-navy-700">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-400 mb-2 uppercase tracking-wide">
              <span class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                Output: 8 Format Konten
              </span>
              <span class="text-emerald-400 text-[11px] font-normal">Siap Pakai</span>
            </div>
            <div class="grid grid-cols-2 gap-1.5 text-xs text-slate-300">
              <div class="flex items-center gap-1.5 bg-navy-800/80 px-2 py-1 rounded border border-navy-700/60">
                <span>📝</span>
                <span class="truncate">Artikel Blog</span>
              </div>
              <div class="flex items-center gap-1.5 bg-navy-800/80 px-2 py-1 rounded border border-navy-700/60">
                <span>📱</span>
                <span class="truncate">Carousel IG</span>
              </div>
              <div class="flex items-center gap-1.5 bg-navy-800/80 px-2 py-1 rounded border border-navy-700/60">
                <span>🎬</span>
                <span class="truncate">Video Script</span>
              </div>
              <div class="flex items-center gap-1.5 bg-navy-800/80 px-2 py-1 rounded border border-navy-700/60">
                <span>🐦</span>
                <span class="truncate">X Thread</span>
              </div>
            </div>
            <p class="text-[11px] text-slate-400 mt-2 text-center">
              + Caption IG, Quotes, LinkedIn Post, Pinterest Pin
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. PROBLEM SECTION -->
  <section class="bg-white py-16 sm:py-24 border-b border-slate-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="inline-block text-xs font-bold uppercase tracking-wider text-rose-600 bg-rose-50 px-3 py-1 rounded-full mb-3 border border-rose-100">
          Tantangan Kreator
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-snug">
          Punya Ide Bagus, Tapi Mandek di Satu Format?
        </h2>
        <p class="text-base text-slate-600 mt-4 leading-relaxed">
          Pernah ngalamin ini? Kamu dapat ide cemerlang waktu lagi santai atau di jalan. Tapi begitu buka laptop atau HP mau bikin konten, energi mendadak habis sebelum posting.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        <!-- Pain Point 1 -->
        <div class="rounded-2xl bg-slate-50 border border-slate-200/80 p-6 sm:p-7 hover:border-slate-300 transition-colors flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center text-2xl mb-5">
              🧩
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3">
              Bingung Mau Bikin Konten Apa dari Ide yang Ada
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Ide cuma numpuk di catatan handphone. Begitu duduk mau bikin konten, kamu bingung menyusun alur ceritanya dari mana, apa hook pembukanya, dan bagaimana membuatnya relevan bagi audiens.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200/60 text-xs font-medium text-rose-600">
            Dampak: Ide cemerlang terlupakan begitu saja.
          </div>
        </div>

        <!-- Pain Point 2 -->
        <div class="rounded-2xl bg-slate-50 border border-slate-200/80 p-6 sm:p-7 hover:border-slate-300 transition-colors flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-2xl mb-5">
              ⏳
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3">
              Capek Bikin Konten dari Nol untuk Setiap Platform
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Habis waktu berjam-jam nulis artikel blog, lalu harus peras otak lagi bikin slide carousel Instagram, mikir script Reels, dan susun thread Twitter. Waktumu habis di format, bukan berkarya.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200/60 text-xs font-medium text-amber-600">
            Dampak: Burnout dan kehabisan tenaga setiap minggu.
          </div>
        </div>

        <!-- Pain Point 3 -->
        <div class="rounded-2xl bg-slate-50 border border-slate-200/80 p-6 sm:p-7 hover:border-slate-300 transition-colors flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-slate-200 text-slate-700 flex items-center justify-center text-2xl mb-5">
              📉
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3">
              Konten Terasa Datar Karena Tidak Ada Struktur Cerita
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Sudah rajin posting tiap hari tapi interaksi sepi? Masalahnya seringkali bukan topikmu, melainkan penyampaiannya yang hambar tanpa hook emosional, konflik yang relate, dan alur narasi yang jelas.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200/60 text-xs font-medium text-slate-700">
            Dampak: Konten dilewati begitu saja oleh audiens.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. SOLUTION SECTION -->
  <section class="bg-slate-50 py-16 sm:py-24 border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="inline-block text-xs font-bold uppercase tracking-wider text-blue-600 bg-blue-100/70 px-3 py-1 rounded-full mb-3 border border-blue-200/60">
          Solusi Praktis
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-snug">
          STORIQ Bantu Kamu Dari Ide Sampai Banyak Konten
        </h2>
        <p class="text-lg font-medium text-blue-600 mt-2">
          Content Repurposing Engine berbasis storytelling
        </p>
        <p class="text-sm sm:text-base text-slate-600 mt-3 leading-relaxed">
          STORIQ memandu kamu melalui workflow 6 langkah terstruktur. Alih-alih menulis acak, kamu membangun fondasi cerita yang solid yang kemudian dapat bertransformasi ke beragam format secara instan.
        </p>
      </div>

      <!-- 6-step workflow grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {workflowSteps.map((step) => (
          <div class="relative bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md hover:border-blue-300 transition-all flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-2xl" role="img" aria-label={step.title}>
                  {step.icon}
                </span>
                <span class="font-mono text-xs font-bold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 group-hover:bg-blue-50 group-hover:text-blue-600 transition-colors">
                  LANGKAH {step.step}
                </span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-blue-600 transition-colors">
                {step.title}
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                {step.desc}
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
              <span>{step.badge}</span>
              <span class="text-blue-500 font-semibold group-hover:translate-x-0.5 transition-transform">Tahap {step.step} →</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Quick Action Prompt to Framework -->
      <div class="mt-12 text-center">
        <a
          href={`${baseUrl}framework/`}
          class="inline-flex items-center gap-2 text-sm font-semibold text-blue-600 hover:text-blue-700 hover:underline"
        >
          <span>Pelajari rincian Framework STORIQ 10 Elemen</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. TWO MODES SECTION -->
  <section class="bg-white py-16 sm:py-24 border-b border-slate-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="inline-block text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-3 py-1 rounded-full mb-3 border border-emerald-100">
          Fleksibilitas Penuh
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-snug">
          Dua Cara Pakai, Pilih yang Nyaman
        </h2>
        <p class="text-base text-slate-600 mt-4 leading-relaxed">
          STORIQ dirancang fleksibel untuk semua orang. Mau yang serba otomatis dengan API key sendiri, atau manual copy-paste ke ChatGPT tanpa setup? Keduanya tersedia gratis!
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Mode 1: AI API (Otomatis) -->
        <div class="rounded-2xl border-2 border-blue-500/80 bg-gradient-to-b from-blue-50/50 to-white p-6 sm:p-8 flex flex-col justify-between shadow-sm hover:shadow-md transition-shadow relative">
          <div class="absolute -top-3 right-6 bg-blue-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow-sm">
            Rekomendasi
          </div>
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 rounded-xl bg-blue-600 text-white flex items-center justify-center text-xl shadow-md shadow-blue-500/20">
                ⚡
              </div>
              <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-blue-600">Mode 1 • Otomatis</span>
                <h3 class="text-xl font-extrabold text-slate-900">AI API (BYOK)</h3>
              </div>
            </div>
            
            <p class="text-sm text-slate-600 mb-6 leading-relaxed">
              <strong>Bring Your Own Key:</strong> Masukkan API key gratis dari provider favoritmu. Generate hasil konten lengkap langsung di dalam antarmuka STORIQ tanpa perlu berpindah tab.
            </p>

            <ul class="space-y-3 text-sm text-slate-700 mb-8">
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span><strong>Sekali Klik:</strong> Generate artikel, carousel, atau script langsung dalam detik.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span><strong>Privasi Terjamin:</strong> API key hanya disimpan di browser (localStorage) perangkatmu, tidak pernah dikirim ke server kami.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span><strong>Provider Gratis:</strong> Mendukung Google Gemini (Free Tier), Groq (Super Cepat), OpenRouter, dan Mistral.</span>
              </li>
            </ul>
          </div>

          <a
            href={`${baseUrl}generator/`}
            class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm transition-colors text-center"
          >
            Gunakan Mode AI API →
          </a>
        </div>

        <!-- Mode 2: Prompt Generator (Manual) -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 flex flex-col justify-between shadow-sm hover:shadow-md transition-shadow">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 rounded-xl bg-slate-800 text-white flex items-center justify-center text-xl">
                📋
              </div>
              <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Mode 2 • Manual</span>
                <h3 class="text-xl font-extrabold text-slate-900">Prompt Generator</h3>
              </div>
            </div>

            <p class="text-sm text-slate-600 mb-6 leading-relaxed">
              <strong>Tanpa Setup:</strong> Belum punya API key? Tidak masalah sama sekali! STORIQ akan meracik prompt terstruktur lengkap dengan instruksi storytelling siap pakai.
            </p>

            <ul class="space-y-3 text-sm text-slate-700 mb-8">
              <li class="flex items-start gap-2.5">
