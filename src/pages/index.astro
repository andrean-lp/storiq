---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const baseUrl = import.meta.env.BASE_URL;

// 12 fitur utama bergaya Dikasir
const coreFeatures = [
  {
    icon: '💡',
    title: '100% Gratis & Bebas',
    desc: 'Semua fitur terbuka penuh tanpa tier berbayar, paywall tersembunyi, maupun watermark.'
  },
  {
    icon: '📐',
    title: 'Framework Storytelling',
    desc: 'Dibangun di atas formula naratif teruji: STORIQ 10 Elemen, PAS, AIDA, Hero\'s Journey, dan BAB.'
  },
  {
    icon: '⚡',
    title: 'Dua Mode Penggunaan',
    desc: 'Gunakan Mode Manual (Prompt Generator) untuk ChatGPT/Gemini, atau Mode Otomatis via API SumoPod.'
  },
  {
    icon: '🧵',
    title: 'Serial Threads & X',
    desc: 'Pecah ide panjang menjadi utas postingan ringkas, padat insight, dan nyaman dibaca cepat di smartphone.'
  },
  {
    icon: '🎨',
    title: 'Visual Prompt Bawaan',
    desc: 'Langsung render gambar via fitur bawaan AI (DALL-E / Imagen) untuk Single Image, Carousel, dan Infografis.'
  },
  {
    icon: '🔒',
    title: 'Privasi Terjamin (BYOK)',
    desc: 'API Key disimpan aman hanya di browser lokal Anda (localStorage), tidak pernah dikirim ke server luar.'
  },
  {
    icon: '📱',
    title: 'Mobile-First & Ringan',
    desc: 'Antarmuka super cepat dan responsif, nyaman diakses langsung dari ponsel tanpa lag.'
  },
  {
    icon: '🌐',
    title: 'Open Source MIT',
    desc: 'Kode sumber terbuka di GitHub. Bebas Anda fork, modifikasi, dan gunakan untuk kebutuhan komersial.'
  },
  {
    icon: '📝',
    title: 'Artikel Blog & Medium',
    desc: 'Hasilkan artikel 800-1200 kata dengan hook memikat, struktur sub-heading rapi, dan siap publish.'
  },
  {
    icon: '🎬',
    title: 'Skrip Video Pendek',
    desc: 'Dilengkapi panduan visual 0-5 detik penahan scroll untuk TikTok, Instagram Reels, dan YouTube Shorts.'
  },
  {
    icon: '🤖',
    title: 'Dukungan Multi-AI',
    desc: 'Kompatibel dengan model AI terdepan: ChatGPT (OpenAI), Claude, Google Gemini, Llama 3, dan DeepSeek.'
  },
  {
    icon: '🚀',
    title: 'Tanpa Login Apapun',
    desc: 'Langsung buka website dan pakai seketika. Tidak perlu daftar akun, verifikasi email, atau langganan.'
  }
];

const stats = [
  { value: '100%', label: 'Gratis & Bebas Iklan' },
  { value: '10+', label: 'Elemen Storytelling' },
  { value: 'MIT', label: 'Lisensi Open Source' },
  { value: '4+', label: 'Format Repurpose' },
];

const faqs = [
  {
    q: 'Apakah STORIQ benar-benar gratis?',
    a: 'Ya, 100% gratis tanpa biaya tersembunyi. Proyek ini dibangun sebagai kontribusi open source untuk komunitas kreator dan pemilik bisnis di Indonesia.'
  },
  {
    q: 'Bagaimana cara kerja dua mode di STORIQ?',
    a: 'Mode 1 (Prompt Generator) cocok jika Anda ingin meng-copy prompt berkualitas dan menjalankannya langsung di ChatGPT, Gemini, atau Claude. Mode 2 (API Key SumoPod) memungkinkan Anda meng-generate konten langsung di dalam STORIQ secara otomatis menggunakan API key gratis.'
  },
  {
    q: 'Apakah API key saya aman di Mode SumoPod?',
    a: 'Sangat aman. STORIQ adalah aplikasi statis (Client-Side). API Key Anda hanya disimpan di memori browser lokal (localStorage) Anda sendiri dan langsung berkomunikasi ke endpoint penyedia AI tanpa melalui server perantara.'
  },
  {
    q: 'Apakah hasil visual langsung me-render gambar?',
    a: 'Ya! Untuk Single Image, Carousel Instagram, dan Infografis, prompt visual kami sudah dilengkapi perintah render langsung sehingga AI (seperti ChatGPT Plus DALL-E atau Gemini Imagen) akan otomatis menghasilkan gambar.'
  },
  {
    q: 'Apakah konten Threads juga membuat gambar?',
    a: 'Khusus Threads, kami memfokuskan prompt 100% pada kekuatan teks/copywriting (hook, isi daging, dan kalimat pemantik diskusi) karena ekosistem Threads berakar pada kenyamanan membaca teks cepat.'
  }
];
---

<Base
  title="STORIQ — Content Repurposing Engine Berbasis Storytelling"
  description="Ubah satu ide menjadi artikel, carousel, caption, quote, video script — semua berbasis framework storytelling yang terstruktur."
>
  <Header slot="header" />

  <!-- 1. HERO SECTION -->
  <section class="pt-14 pb-16 sm:pt-20 sm:pb-24 overflow-hidden relative text-center">
    <!-- Subtle gradient background glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-gradient-to-b from-indigo-50/70 via-indigo-50/20 to-transparent pointer-events-none -z-10"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <!-- Pill Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs font-semibold mb-6 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>✨ Open Source • 100% Gratis • Tanpa Login</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.18] mb-6">
        Tulis Sekali.<br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-indigo-600 via-violet-600 to-indigo-500 bg-clip-text text-transparent">
          Banjiri Semua Platform.
        </span>
      </h1>

      <!-- Subheadline -->
      <p class="text-sm sm:text-base md:text-lg text-slate-600 max-w-2xl mx-auto mb-8 leading-relaxed font-normal">
        Satu ide cerita, puluhan format konten siap publish. Hasilkan artikel blog, slide Instagram, rangkuman infografis, dan serial threads tanpa perlu nulis ulang dari awal.
      </p>

      <!-- Dual CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full max-w-md mx-auto mb-14">
        <a
          href={`${baseUrl}generator/`}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm shadow-md shadow-indigo-600/20 hover:shadow-indigo-600/30 hover:-translate-y-0.5 transition-all"
        >
          <span>Buka Generator</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href={`${baseUrl}framework/`}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm border border-slate-200 shadow-2xs hover:border-slate-300 transition-all"
        >
          Pelajari Framework
        </a>
      </div>

            <!-- App Mockup Window with Animated Repurposing Flow Simulation -->
      <div class="max-w-4xl mx-auto rounded-3xl bg-white border border-slate-200/90 shadow-xl shadow-slate-200/60 overflow-hidden text-left">
        <!-- Window Header -->
        <div class="bg-slate-50/90 px-5 py-3.5 border-b border-slate-200 flex items-center justify-between text-xs text-slate-500">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-rose-400 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-amber-400 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block"></span>
            <span class="ml-2 font-mono text-[11px] text-slate-400 hidden sm:inline-block">storiq.web.id/generator</span>
          </div>
          <div class="flex items-center gap-2 font-medium text-indigo-600 text-xs">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-600"></span>
            </span>
            <span class="font-semibold">Repurposing Active</span>
          </div>
        </div>

        <!-- Window Mockup Body: Interactive Flow Simulation -->
        <div class="p-6 sm:p-10 bg-slate-50/40">
          <div class="flex flex-col md:flex-row items-center justify-between gap-6 md:gap-0 max-w-3xl mx-auto">
            
            <!-- Left Source Card (1 Master Artikel / Ide) -->
            <div class="w-full max-w-[260px] shrink-0">
              <div class="relative bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-5 shadow-lg shadow-indigo-500/5 hover:border-indigo-300 transition-all text-center group">
                <!-- Top Floating Badge -->
                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 whitespace-nowrap">
                  <span class="bg-indigo-600 text-white text-[10px] sm:text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-xs flex items-center gap-1.5">
                    <span>📄</span>
                    <span>1 Master Artikel</span>
                  </span>
                </div>

                <!-- Card Thumbnail Preview -->
                <div class="mt-2 bg-gradient-to-br from-indigo-500 via-indigo-600 to-violet-700 rounded-xl p-4 text-white text-left aspect-[4/3] flex flex-col justify-between shadow-inner relative overflow-hidden">
                  <!-- Decorative background circle -->
                  <div class="absolute -right-6 -top-6 w-24 h-24 bg-white/10 rounded-full blur-xl pointer-events-none"></div>
                  
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] font-semibold bg-white/20 backdrop-blur-xs px-2 py-0.5 rounded-full">
                      Blueprint Story
                    </span>
                    <span class="text-xs">⚡</span>
                  </div>

                  <div class="my-auto text-center py-2">
                    <div class="w-9 h-9 rounded-full bg-white/20 backdrop-blur-md mx-auto flex items-center justify-center text-white text-sm shadow-xs mb-1.5">
                      ▶
                    </div>
                    <p class="text-[11px] font-bold text-white leading-snug px-1">
                      "1 Ide Dasar Jadi 6 Format Konten"
                    </p>
                  </div>

                  <div class="flex items-center justify-between text-[9px] text-indigo-100 font-mono">
                    <span>1,200 kata</span>
                    <span>STORIQ 10</span>
                  </div>
                </div>

                <!-- Bottom Status -->
                <div class="mt-3.5 pt-2.5 border-t border-slate-100 flex items-center justify-center gap-2">
                  <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                  </span>
                  <span class="text-[11px] text-slate-500 font-mono font-medium">distributing...</span>
                </div>
              </div>
            </div>

            <!-- Center Branch Connector Lines (SVG Animated Curves on Desktop) -->
            <div class="hidden md:flex items-center justify-center w-28 shrink-0 self-stretch">
              <svg class="w-full h-[360px] overflow-visible pointer-events-none" viewBox="0 0 100 360" fill="none">
                <defs>
                  <!-- Gradient for dashed pulse -->
                  <linearGradient id="flowGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#818cf8" />
                    <stop offset="100%" stop-color="#4f46e5" />
                  </linearGradient>
                </defs>

                <!-- Base static guide lines (gray) -->
                <path d="M 0 180 C 50 180, 50 25, 100 25" stroke="#e2e8f0" stroke-width="1.5" />
                <path d="M 0 180 C 50 180, 50 87, 100 87" stroke="#e2e8f0" stroke-width="1.5" />
                <path d="M 0 180 C 50 180, 50 149, 100 149" stroke="#e2e8f0" stroke-width="1.5" />
                <path d="M 0 180 C 50 180, 50 211, 100 211" stroke="#e2e8f0" stroke-width="1.5" />
                <path d="M 0 180 C 50 180, 50 273, 100 273" stroke="#e2e8f0" stroke-width="1.5" />
                <path d="M 0 180 C 50 180, 50 335, 100 335" stroke="#e2e8f0" stroke-width="1.5" />

                <!-- Animated Dashed Curves -->
                <path d="M 0 180 C 50 180, 50 25, 100 25" stroke="url(#flowGrad)" stroke-width="2" stroke-dasharray="6 8" class="animate-flow-dash" />
                <path d="M 0 180 C 50 180, 50 87, 100 87" stroke="url(#flowGrad)" stroke-width="2" stroke-dasharray="6 8" class="animate-flow-dash" style="animation-delay: -0.3s;" />
                <path d="M 0 180 C 50 180, 50 149, 100 149" stroke="url(#flowGrad)" stroke-width="2" stroke-dasharray="6 8" class="animate-flow-dash" style="animation-delay: -0.6s;" />
                <path d="M 0 180 C 50 180, 50 211, 100 211" stroke="url(#flowGrad)" stroke-width="2" stroke-dasharray="6 8" class="animate-flow-dash" style="animation-delay: -0.9s;" />
                <path d="M 0 180 C 50 180, 50 273, 100 273" stroke="url(#flowGrad)" stroke-width="2" stroke-dasharray="6 8" class="animate-flow-dash" style="animation-delay: -1.2s;" />
                <path d="M 0 180 C 50 180, 50 335, 100 335" stroke="url(#flowGrad)" stroke-width="2" stroke-dasharray="6 8" class="animate-flow-dash" style="animation-delay: -1.5s;" />

                <!-- Flowing Pulse Dots (Pure SVG animateMotion, 60fps) -->
                <circle r="3.5" fill="#4f46e5">
                  <animateMotion path="M 0 180 C 50 180, 50 25, 100 25" dur="2.2s" repeatCount="indefinite" />
                </circle>
                <circle r="3.5" fill="#4f46e5">
                  <animateMotion path="M 0 180 C 50 180, 50 87, 100 87" dur="2.2s" begin="0.35s" repeatCount="indefinite" />
                </circle>
                <circle r="3.5" fill="#4f46e5">
                  <animateMotion path="M 0 180 C 50 180, 50 149, 100 149" dur="2.2s" begin="0.7s" repeatCount="indefinite" />
                </circle>
                <circle r="3.5" fill="#4f46e5">
                  <animateMotion path="M 0 180 C 50 180, 50 211, 100 211" dur="2.2s" begin="1.05s" repeatCount="indefinite" />
                </circle>
                <circle r="3.5" fill="#4f46e5">
                  <animateMotion path="M 0 180 C 50 180, 50 273, 100 273" dur="2.2s" begin="1.4s" repeatCount="indefinite" />
                </circle>
                <circle r="3.5" fill="#4f46e5">
                  <animateMotion path="M 0 180 C 50 180, 50 335, 100 335" dur="2.2s" begin="1.75s" repeatCount="indefinite" />
                </circle>
              </svg>
            </div>

            <!-- Mobile Downward Indicator (< md) -->
            <div class="flex md:hidden flex-col items-center my-1 text-indigo-500 font-mono text-xs">
              <span class="animate-bounce text-base">↓</span>
              <span class="text-[10px] font-semibold text-indigo-600 uppercase tracking-wider">Otomatis Terurai ke 6 Format</span>
            </div>

            <!-- Right Destination Stack Cards (6 Platforms) -->
            <div class="w-full max-w-[320px] flex flex-col justify-between h-[360px] shrink-0">
              
              <!-- 1. Instagram Carousel -->
              <div class="bg-white rounded-xl border border-slate-200/90 px-3.5 py-2.5 shadow-2xs hover:border-indigo-300 hover:shadow-xs transition-all flex items-center justify-between gap-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-white border border-slate-200/90 flex items-center justify-center shrink-0 shadow-2xs">
                    <svg class="w-4 h-4 text-[#E1306C]" role="img" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                      <title>Instagram</title>
                      <path d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077"/>
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-xs font-bold text-slate-900 leading-tight">Instagram</h4>
                    <p class="text-[10px] font-mono text-emerald-600 font-medium">carousel ready • 10 slide</p>
                  </div>
                </div>
                <div class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold shrink-0">
                  ✓
                </div>
              </div>

              <!-- 2. Threads -->
              <div class="bg-white rounded-xl border border-slate-200/90 px-3.5 py-2.5 shadow-2xs hover:border-indigo-300 hover:shadow-xs transition-all flex items-center justify-between gap-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-white border border-slate-200/90 flex items-center justify-center shrink-0 shadow-2xs">
                    <svg class="w-4 h-4 text-black" role="img" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                      <title>Threads</title>
                      <path d="M18.263 11.097c-.03-3.486-1.92-5.586-5.111-5.586-2.13 0-3.922.963-4.863 2.499l2.062 1.438c.535-.843 1.272-1.543 2.628-1.543 1.528 0 2.318.85 2.544 2.431a15 15 0 0 0-2.236-.173c-4.125 0-6.068 1.867-6.068 4.336s1.943 3.99 4.804 3.99c3.139 0 5.013-2.115 5.781-4.735.798.361 1.348 1.204 1.348 2.47 0 3.387-3.907 5.232-7.22 5.232-4.885 0-8.077-3.207-8.077-8.424 0-6.392 4.223-10.487 9.9-10.487 3.808 0 5.69 1.671 6.97 3.914l2.108-1.475C21.44 2.078 18.331 0 13.663 0 6.227 0 1.168 5.277 1.168 12.934c0 7 4.953 11.066 10.856 11.066 4.878 0 9.809-2.846 9.809-7.716 0-2.545-1.46-4.231-3.569-5.187m-6.33 4.855c-1.077 0-2.026-.512-2.026-1.453 0-1.483 1.822-1.934 3.606-1.934.678 0 1.34.045 1.927.173-.422 1.927-1.671 3.215-3.508 3.214Z"/>
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-xs font-bold text-slate-900 leading-tight">Threads</h4>
                    <p class="text-[10px] font-mono text-emerald-600 font-medium">posted • 5 serial post</p>
                  </div>
                </div>
                <div class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold shrink-0">
                  ✓
                </div>
              </div>

              <!-- 3. WordPress / Blog -->
              <div class="bg-white rounded-xl border border-slate-200/90 px-3.5 py-2.5 shadow-2xs hover:border-indigo-300 hover:shadow-xs transition-all flex items-center justify-between gap-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-white border border-slate-200/90 flex items-center justify-center shrink-0 shadow-2xs">
                    <svg class="w-4 h-4 text-[#21759B]" role="img" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                      <title>WordPress</title>
