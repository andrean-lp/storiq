---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const baseUrl = import.meta.env.BASE_URL;

const docSections = [
  {
    category: 'Mulai Cepat',
    items: [
      {
        title: 'Getting Started',
        desc: 'Panduan setup lengkap dari input ide dasar pertama hingga menghasilkan konten multi-format.',
        href: `${baseUrl}generator/`
      },
      {
        title: 'Konfigurasi API Key SumoPod',
        desc: 'Cara mendaftar akun gratis di SumoPod, generate API key, dan menyimpannya di browser.',
        href: `${baseUrl}pengaturan/`
      },
      {
        title: 'Mode Manual vs Mode Otomatis',
        desc: 'Kapan sebaiknya memakai Prompt Generator dan kapan memakai API Key SumoPod.',
        href: `${baseUrl}generator/`
      },
      {
        title: 'Indeks Framework Storytelling',
        desc: "Penjelasan lengkap 7 formula narasi: STORIQ 10, Hero's Journey, StoryBrand, Andy Raskin, Pixar Spine, Three-Act, dan Golden Circle.",
        href: `${baseUrl}framework/`
      }
    ]
  },
  {
    category: 'Format Distribusi Konten',
    items: [
      {
        title: 'Artikel Blog & Medium',
        desc: 'Struktur artikel 800-1200 kata dengan sub-heading SEO-friendly dan hook pemikat.',
        href: `${baseUrl}generator/prompt-generator/`
      },
      {
        title: 'Carousel Instagram & LinkedIn',
        desc: 'Panduan slide visual berurutan: cover swipe, problem framing, dan call to action.',
        href: `${baseUrl}generator/prompt-generator/`
      },
      {
        title: 'Poster Infografis Vertikal',
        desc: 'Perintah otomatis generate visual 9:16 atau 4:5 berisi ringkasan data penting.',
        href: `${baseUrl}generator/prompt-generator/`
      },
      {
        title: 'Serial 🧵 Threads / Twitter (X)',
        desc: 'Utas 3-5 postingan pendek yang fokus 100% pada kekuatan copywriting teks.',
        href: `${baseUrl}generator/prompt-generator/`
      }
    ]
  },
  {
    category: 'Storytelling & Konversi Playbook',
    items: [
      {
        title: 'Formula Hook 3 Detik Pertama',
        desc: 'Teknik membuka cerita yang langsung menghentikan jari audiens saat scrolling.',
        href: `${baseUrl}framework/#storiq10`
      },
      {
        title: 'Menyusun Konflik yang Relatable',
        desc: 'Cara menggali masalah nyata audiens tanpa terkesan menghakimi atau menggurui.',
        href: `${baseUrl}framework/#heros_journey`
      },
      {
        title: 'Call to Action (CTA) yang Bernilai',
        desc: 'Mengubah pembaca pasif menjadi pengikut loyal atau pembeli tanpa hard-selling.',
        href: `${baseUrl}framework/#storybrand`
      },
      {
        title: 'Alur Cerita Naratif & Emosional',
        desc: 'Formula sebab-akibat yang mengikat emosi audiens dari awal hingga transformasi akhir.',
        href: `${baseUrl}framework/#pixar`
      }
    ]
  }
];
---

<Base
  title="Dokumentasi Lengkap — STORIQ"
  description="Semua panduan penggunaan, integrasi API, dan formula storytelling STORIQ tersedia secara terbuka."
>
  <Header slot="header" />

  <!-- Hero Section -->
  <section class="py-14 sm:py-20 text-center max-w-4xl mx-auto px-4">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs font-semibold mb-5">
      <span>📖</span>
      <span>Dokumentasi</span>
    </div>
    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
      Dokumentasi Lengkap
    </h1>
    <p class="text-slate-600 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
      Semua panduan penggunaan dan API tersedia secara terbuka di repository GitHub — selalu terbaru, ikut berkembang bersama kode.
    </p>
  </section>

  <!-- Categorized Documentation Grid (2-Column seperti Dikasir) -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pb-24 space-y-12">
    {docSections.map((sec) => (
      <section>
        <!-- Category Title with blue bar -->
        <div class="flex items-center gap-2.5 mb-5">
          <span class="w-4 h-0.5 bg-indigo-600 rounded-full inline-block"></span>
          <h2 class="text-sm sm:text-base font-bold text-slate-900">{sec.category}</h2>
        </div>

        <!-- 2-Column Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {sec.items.map((item) => (
            <a
              href={item.href}
              target={item.href.startsWith('http') ? '_blank' : '_self'}
              rel={item.href.startsWith('http') ? 'noopener noreferrer' : ''}
              class="group bg-white rounded-2xl border border-slate-200/80 p-5 shadow-2xs hover:border-indigo-200 hover:shadow-xs transition-all flex items-start justify-between gap-3"
            >
              <div>
                <h3 class="text-sm font-bold text-slate-900 group-hover:text-indigo-600 transition-colors flex items-center gap-1.5">
                  <span>{item.title}</span>
                  {item.href.startsWith('http') && (
                    <span class="text-[10px] text-slate-400 font-normal">↗</span>
                  )}
                </h3>
                <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
                  {item.desc}
                </p>
              </div>
              <span class="text-slate-400 group-hover:text-indigo-600 group-hover:translate-x-0.5 transition-all text-sm shrink-0 mt-0.5">
                &rarr;
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- Bottom Help Box (seperti Dikasir) -->
    <div class="bg-white rounded-2xl border border-slate-200/80 p-8 text-center shadow-2xs max-w-2xl mx-auto space-y-4">
      <h3 class="text-lg font-bold text-slate-900">
        Dokumentasi Kurang Jelas?
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-md mx-auto">
        Dokumentasi kami juga open source — perbaiki dan buat PR di GitHub, atau tanyakan langsung melalui forum diskusi komunitas.
      </p>
      <div class="flex flex-wrap justify-center items-center gap-3 pt-2">
        <a
          href="https://github.com/andrean-lp/storiq"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs sm:text-sm shadow-xs transition-colors"
        >
          Lihat Semua Docs di GitHub
        </a>
        <a
          href="https://github.com/andrean-lp/storiq/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs sm:text-sm border border-slate-200 shadow-2xs transition-colors"
        >
          Tanya di Issues / Discussions
        </a>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</Base>