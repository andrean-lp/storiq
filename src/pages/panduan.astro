---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<Base
  title="Panduan Lengkap STORIQ — Tutorial & Cara Dapat API Key Gratis"
  description="Panduan langkah demi langkah menggunakan STORIQ dan cara mendapatkan API key gratis dari Google Gemini, Groq, OpenRouter, Cerebras, dan SambaNova."
>
  <Header slot="header" />

  <!-- ==================== 1. HERO SECTION (navy-800) ==================== -->
  <section class="bg-navy-800 text-white py-14 sm:py-20 relative overflow-hidden border-b border-navy-700">
    <!-- Background subtle glow -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-4 text-center relative z-10">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-400/30 text-blue-400 text-xs sm:text-sm font-medium mb-6">
        <span>📖</span>
        <span>Tutorial & Panduan Praktis</span>
      </div>

      <!-- Title & Subtitle -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-tight text-white">
        Panduan Lengkap <span class="text-blue-400">STORIQ</span>
      </h1>
      <p class="text-base sm:text-lg md:text-xl text-slate-300 max-w-2xl mx-auto mt-4 leading-relaxed">
        Dari nol sampai bisa generate konten pertamamu. Pelajari cara pakai engine dan dapatkan API key AI gratis tanpa kartu kredit!
      </p>

      <!-- Quick Benefit Badges -->
      <div class="flex flex-wrap justify-center items-center gap-2 sm:gap-4 mt-8 text-xs sm:text-sm text-slate-300">
        <span class="inline-flex items-center gap-1.5 bg-navy-700/80 px-3 py-1.5 rounded-lg border border-navy-600">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          100% Gratis Selamanya
        </span>
        <span class="inline-flex items-center gap-1.5 bg-navy-700/80 px-3 py-1.5 rounded-lg border border-navy-600">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          Tanpa Perlu Login
        </span>
        <span class="inline-flex items-center gap-1.5 bg-navy-700/80 px-3 py-1.5 rounded-lg border border-navy-600">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          Privasi Aman (Browser Local)
        </span>
      </div>

      <!-- Quick Nav Buttons -->
      <div class="flex flex-wrap justify-center items-center gap-3 mt-8">
        <a
          href="#cara-pakai"
          class="px-4 py-2 rounded-lg bg-white/10 hover:bg-white/20 text-white text-sm font-medium transition-all duration-200 border border-white/10"
        >
          👇 Cara Pakai STORIQ
        </a>
        <a
          href="#api-key-gratis"
          class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium transition-all duration-200 shadow-sm"
        >
          🔑 Dapatkan API Key Gratis
        </a>
        <a
          href="#tips-pemula"
          class="px-4 py-2 rounded-lg bg-white/10 hover:bg-white/20 text-white text-sm font-medium transition-all duration-200 border border-white/10"
        >
          💡 Tips & FAQ
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== 2. CARA PAKAI STORIQ (white bg) ==================== -->
  <section id="cara-pakai" class="bg-white py-16 sm:py-20 text-slate-800">
    <div class="max-w-5xl mx-auto px-4">
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-blue-600 bg-blue-50 px-3 py-1 rounded-full border border-blue-200/60">
          Langkah Demi Langkah
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-navy-900 mt-3">
          Cara Pakai STORIQ
        </h2>
        <p class="text-slate-600 mt-3 text-sm sm:text-base leading-relaxed">
          Ubah satu ide kasar di kepala menjadi aneka format konten berstruktur storytelling yang siap dipublikasikan dalam 7 langkah mudah.
        </p>
      </div>

      <!-- Steps Timeline Grid -->
      <div class="relative">
        <!-- Connecting vertical line on desktop -->
        <div class="hidden md:block absolute left-8 top-8 bottom-8 w-0.5 bg-slate-200"></div>

        <div class="space-y-6 sm:space-y-8">
          <!-- Step 1 -->
          <div class="relative flex flex-col md:flex-row items-start gap-4 md:gap-6 bg-slate-50/80 p-5 sm:p-6 rounded-2xl border border-slate-200/80 hover:border-blue-300 transition-all duration-200">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-blue-600 text-white font-bold text-lg flex items-center justify-center shadow-md shadow-blue-500/20 z-10">
              1
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-lg sm:text-xl font-bold text-navy-900">Buka Halaman Generator</h3>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-200 text-slate-700">Langkah Awal</span>
              </div>
              <p class="text-slate-600 mt-2 text-sm sm:text-base leading-relaxed">
                Kunjungi menu <a href={`${baseUrl}generator/`} class="text-blue-600 hover:text-blue-700 font-medium underline underline-offset-2">Generator</a> pada navigasi atas atau klik tombol CTA. Kamu langsung masuk ke workspace generator tanpa perlu pendaftaran akun, tanpa kartu kredit, dan tanpa antrean.
              </p>
              <div class="mt-3 p-3 bg-blue-50/70 border border-blue-100 rounded-lg text-xs sm:text-sm text-blue-900 flex items-start gap-2">
                <span class="text-blue-600 font-bold">💡 Pro Tip:</span>
                <span>Kamu bisa langsung mem-bookmark tautan Generator di browser ponsel atau laptopmu untuk akses cepat saat ide mendadak muncul!</span>
              </div>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="relative flex flex-col md:flex-row items-start gap-4 md:gap-6 bg-slate-50/80 p-5 sm:p-6 rounded-2xl border border-slate-200/80 hover:border-blue-300 transition-all duration-200">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-blue-600 text-white font-bold text-lg flex items-center justify-center shadow-md shadow-blue-500/20 z-10">
              2
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-lg sm:text-xl font-bold text-navy-900">Isi Topik, Audiens, Tujuan, dan Tone Konten</h3>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-800">Brief Konten</span>
              </div>
              <p class="text-slate-600 mt-2 text-sm sm:text-base leading-relaxed">
                Tuliskan informasi dasar konten pada form yang tersedia:
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3 text-xs sm:text-sm">
                <div class="bg-white p-3 rounded-lg border border-slate-200 shadow-2xs">
                  <span class="font-semibold text-navy-900 block">📌 Topik Utama</span>
                  <span class="text-slate-600">Ide pokok atau masalah yang ingin kamu bahas (contoh: "Kenapa pemula sering gagal konsisten bikin konten").</span>
                </div>
                <div class="bg-white p-3 rounded-lg border border-slate-200 shadow-2xs">
                  <span class="font-semibold text-navy-900 block">🎯 Target Audiens</span>
                  <span class="text-slate-600">Siapa pembacanya (contoh: "Karyawan 9-to-5 yang baru mulai bangun personal brand").</span>
                </div>
                <div class="bg-white p-3 rounded-lg border border-slate-200 shadow-2xs">
                  <span class="font-semibold text-navy-900 block">🚀 Tujuan Konten</span>
                  <span class="text-slate-600">Dampak yang diharapkan: mengedukasi, memotivasi, mengubah sudut pandang, atau call-to-action (CTA).</span>
                </div>
                <div class="bg-white p-3 rounded-lg border border-slate-200 shadow-2xs">
                  <span class="font-semibold text-navy-900 block">🗣️ Tone of Voice</span>
                  <span class="text-slate-600">Pilih gaya bahasa: Santai & bersahabat, Tegas & to-the-point, atau Edukatif inspiratif.</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="relative flex flex-col md:flex-row items-start gap-4 md:gap-6 bg-slate-50/80 p-5 sm:p-6 rounded-2xl border border-slate-200/80 hover:border-blue-300 transition-all duration-200">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-blue-600 text-white font-bold text-lg flex items-center justify-center shadow-md shadow-blue-500/20 z-10">
              3
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-lg sm:text-xl font-bold text-navy-900">Pilih Framework Storytelling</h3>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800">Rekomendasi Utama</span>
              </div>
              <p class="text-slate-600 mt-2 text-sm sm:text-base leading-relaxed">
                Pilih arsitektur narasi yang paling cocok untuk pesanmu. Kami sangat menyarankan memilih <strong class="text-navy-900 font-semibold">STORIQ 10 Elemen (Recommended)</strong> — formula khusus berbasis psikologi pembaca dan konversi yang memandu alur dari hook emosional hingga ajakan aksi natural.
              </p>
              <p class="text-slate-600 mt-1 text-xs sm:text-sm">
                Kamu juga bisa memilih framework klasik lain seperti <span class="font-medium text-slate-800">Hook-Story-Offer</span>, <span class="font-medium text-slate-800">BAB (Before-After-Bridge)</span>, atau <span class="font-medium text-slate-800">PAS (Problem-Agitate-Solve)</span>.
              </p>
            </div>
          </div>

          <!-- Step 4 -->
          <div class="relative flex flex-col md:flex-row items-start gap-4 md:gap-6 bg-slate-50/80 p-5 sm:p-6 rounded-2xl border border-slate-200/80 hover:border-blue-300 transition-all duration-200">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-blue-600 text-white font-bold text-lg flex items-center justify-center shadow-md shadow-blue-500/20 z-10">
              4
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-lg sm:text-xl font-bold text-navy-900">Pilih Mode — AI API (Otomatis) atau Prompt Generator (Manual)</h3>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-purple-100 text-purple-800">Dua Pilihan Fleksibel</span>
              </div>
              <p class="text-slate-600 mt-2 text-sm sm:text-base leading-relaxed">
                Tentukan bagaimana kamu ingin STORIQ bekerja:
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3">
                <div class="p-3.5 bg-white rounded-xl border border-slate-200">
                  <div class="flex items-center gap-2 text-sm font-bold text-navy-900">
                    <span class="text-blue-600">⚡</span> Mode 1: AI API (Otomatis)
                  </div>
                  <p class="text-slate-600 text-xs sm:text-sm mt-1.5 leading-relaxed">
                    Masukkan API key gratis (seperti Google Gemini atau Groq). Hasil konten langsung di-generate seketika di dalam layar STORIQ dalam beberapa detik!
                  </p>
                </div>
                <div class="p-3.5 bg-white rounded-xl border border-slate-200">
                  <div class="flex items-center gap-2 text-sm font-bold text-navy-900">
                    <span class="text-emerald-600">📋</span> Mode 2: Prompt Generator (Manual)
                  </div>
                  <p class="text-slate-600 text-xs sm:text-sm mt-1.5 leading-relaxed">
                    Tidak punya API key? Tenang! STORIQ akan merangkai prompt sakti yang siap kamu salin (copy) dan paste ke ChatGPT, Claude, atau Gemini web.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 5 -->
          <div class="relative flex flex-col md:flex-row items-start gap-4 md:gap-6 bg-slate-50/80 p-5 sm:p-6 rounded-2xl border border-slate-200/80 hover:border-blue-300 transition-all duration-200">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-blue-600 text-white font-bold text-lg flex items-center justify-center shadow-md shadow-blue-500/20 z-10">
              5
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-lg sm:text-xl font-bold text-navy-900">Pilih Format Output yang Kamu Mau</h3>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800">Multi-Format</span>
              </div>
              <p class="text-slate-600 mt-2 text-sm sm:text-base leading-relaxed">
                Pilih satu atau centang beberapa format sekaligus untuk mendaur ulang ide utamamu ke berbagai channel:
              </p>
              <div class="flex flex-wrap gap-2 mt-3 text-xs sm:text-sm">
                <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 font-medium">📝 Artikel Panjang / Blog</span>
                <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 font-medium">🖼️ Carousel Slide (IG / LinkedIn)</span>
                <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 font-medium">📱 Caption Pendek & Hook</span>
                <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 font-medium">💬 Quote Card / Tweet Thread</span>
                <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 font-medium">🎬 Script Video Pendek (Reels / TikTok)</span>
              </div>
            </div>
          </div>

          <!-- Step 6 -->
          <div class="relative flex flex-col md:flex-row items-start gap-4 md:gap-6 bg-slate-50/80 p-5 sm:p-6 rounded-2xl border border-slate-200/80 hover:border-blue-300 transition-all duration-200">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-blue-600 text-white font-bold text-lg flex items-center justify-center shadow-md shadow-blue-500/20 z-10">
              6
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-lg sm:text-xl font-bold text-navy-900">Klik Generate dan Tunggu Hasilnya!</h3>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-800">Eksekusi Cepat</span>
              </div>
              <p class="text-slate-600 mt-2 text-sm sm:text-base leading-relaxed">
                Tekan tombol biru <strong class="text-navy-900">"Generate Konten"</strong>. Jika kamu memakai Mode AI API, sistem akan streaming teks hasil secara real-time. Jika memakai Mode Prompt Generator, formula prompt siap pakai langsung muncul di layar.
              </p>
            </div>
          </div>

          <!-- Step 7 -->
          <div class="relative flex flex-col md:flex-row items-start gap-4 md:gap-6 bg-slate-50/80 p-5 sm:p-6 rounded-2xl border border-slate-200/80 hover:border-blue-300 transition-all duration-200">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-emerald-600 text-white font-bold text-lg flex items-center justify-center shadow-md shadow-emerald-500/20 z-10">
              7
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-lg sm:text-xl font-bold text-navy-900">Copy Hasil atau Download sebagai Markdown</h3>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800">Selesai & Publish</span>
              </div>
              <p class="text-slate-600 mt-2 text-sm sm:text-base leading-relaxed">
                Kamu bisa langsung mengklik tombol <strong class="text-navy-900">"Salin / Copy"</strong> per format konten, atau klik <strong class="text-navy-900">"Download Markdown (.md)"</strong> untuk menyimpan seluruh paket konten ke komputermu, Google Docs, atau Notion. Berikan sentuhan gaya aslimu, lalu publish!
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 3. CARA DAPAT API KEY GRATIS (slate-50 bg) ==================== -->
  <section id="api-key-gratis" class="bg-slate-50 py-16 sm:py-20 text-slate-800 border-y border-slate-200">
    <div class="max-w-5xl mx-auto px-4">
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-blue-600 bg-blue-100/60 px-3 py-1 rounded-full border border-blue-200">
          Panduan Lengkap Provider
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-navy-900 mt-3">
          Cara Dapat API Key Gratis
        </h2>
        <p class="text-slate-600 mt-3 text-sm sm:text-base leading-relaxed">
          100% legal, resmi, dan tanpa kartu kredit! Semua provider di bawah ini menyediakan free tier yang sangat berlimpah untuk kebutuhan bikin konten harianmu.
        </p>
      </div>

      <!-- Security Guarantee Banner -->
      <div class="bg-white p-5 sm:p-6 rounded-2xl border border-blue-200 shadow-sm mb-12 flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 text-2xl border border-blue-100">
          🔒
        </div>
        <div class="flex-1 text-sm sm:text-base">
          <h4 class="font-bold text-navy-900">Apakah API Key Kamu Aman di STORIQ?</h4>
          <p class="text-slate-600 text-xs sm:text-sm mt-1 leading-relaxed">
            <strong>Ya, 100% aman!</strong> STORIQ adalah aplikasi static open-source tanpa server backend penyimpan data. Kunci API kamu hanya disimpan di memori browser lokalmu (<code class="bg-slate-100 px-1 py-0.5 rounded text-slate-700 font-mono text-xs">localStorage</code>) dan langsung berkomunikasi ke server provider AI resmi. Tidak ada pihak ketiga yang bisa melihatnya.
          </p>
        </div>
      </div>

      <!-- Providers Cards List -->
      <div class="space-y-8">
        <!-- 3.a Google AI Studio (Gemini) ⭐ RECOMMENDED -->
        <div class="bg-white rounded-2xl border-2 border-blue-500 shadow-md p-6 sm:p-8 relative overflow-hidden">
          <div class="absolute top-0 right-0 bg-gradient-to-l from-blue-600 to-blue-500 text-white text-xs font-bold px-4 py-1.5 rounded-bl-xl uppercase tracking-wider flex items-center gap-1 shadow-sm">
            <span>⭐</span> Rekomendasi Utama (Paling Mudah)
          </div>

          <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 mt-2">
            <div class="flex items-center gap-3">
              <div class="w-14 h-14 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-3xl border border-blue-200 flex-shrink-0">
                🤖
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-xl sm:text-2xl font-bold text-navy-900">Google AI Studio</h3>
                  <span class="px-2 py-0.5 text-xs font-semibold rounded bg-blue-100 text-blue-800">Gemini</span>
                </div>
                <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Penyedia: Google DeepMind</p>
              </div>
            </div>
            <a
              href="https://aistudio.google.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm transition-all duration-200 shadow-sm"
            >
              Buka Google AI Studio
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
          </div>

          <!-- Specs Badges -->
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 mt-6">
            <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 text-xs sm:text-sm">
              <span class="text-slate-500 block text-xs">Model yang Didukung:</span>
              <span class="font-semibold text-navy-900">Gemini 2.5 Flash, Gemini 1.5 Flash</span>
            </div>
            <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 text-xs sm:text-sm">
              <span class="text-slate-500 block text-xs">Batas Kuota Gratis:</span>
              <span class="font-semibold text-emerald-600">1,500 request/hari, 1M tokens/menit</span>
            </div>
            <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 text-xs sm:text-sm sm:col-span-2 md:col-span-1">
              <span class="text-slate-500 block text-xs">Syarat Pendaftaran:</span>
              <span class="font-semibold text-navy-900">Hanya butuh Google Account (Gmail)</span>
            </div>
          </div>

          <!-- Steps -->
          <div class="mt-6">
            <h4 class="text-sm font-bold text-navy-900 uppercase tracking-wide mb-3 flex items-center gap-2">
              <span>📋</span> Langkah-langkah Mendapatkan Key:
            </h4>
            <ol class="space-y-2.5 text-xs sm:text-sm text-slate-700">
              <li class="flex items-start gap-2.5">
                <span class="w-6 h-6 rounded-full bg-blue-100 text-blue-700 font-bold text-xs flex items-center justify-center flex-shrink-0 mt-0.5">1</span>
                <span>Buka website resmi di <a href="https://aistudio.google.com/" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline font-semibold">aistudio.google.com</a>.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-6 h-6 rounded-full bg-blue-100 text-blue-700 font-bold text-xs flex items-center justify-center flex-shrink-0 mt-0.5">2</span>
                <span>Login menggunakan akun Google / Gmail yang biasa kamu pakai.</span>
              </li>
